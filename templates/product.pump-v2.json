    "ww-faq": {
      "type": "ww-faq",
      "blocks": {
        "f_1": {
          "type": "faq",
          "settings": {
            "q": "Single or Double?",
            "a": "<p>Single pumps one side, lighter and cheaper. Double pumps both at once and halves your time, which is why most mothers who pump often choose it.</p>"
          }
        },
        "f_2": {
          "type": "faq",
          "settings": {
            "q": "Will it tank my supply?",
            "a": "<p>Cheap pumps do, because pain and poor fit make you tense and the session ends before the breast is empty. WeeWonders removes the pain and lets a full session finish, so it empties fully and your supply holds.</p>"
          }
        },
        "f_3": {
          "type": "faq",
          "settings": {
            "q": "Which flange size fits me?",
            "a": "<p>Every box has 17, 19, 21 and 24mm plus a sizing tool. Unsure? Send a photo on WhatsApp and we’ll help you fit it.</p>"
          }
        },
        "f_4": {
          "type": "faq",
          "settings": {
            "q": "What if it breaks?",
            "a": "<p>Six-month warranty, handled in Lebanon. Message us and replacement parts ship in a couple of days.</p>"
          }
        },
        "f_5": {
          "type": "faq",
          "settings": {
            "q": "Is it really discreet?",
            "a": "<p>Under 50dB and fully in-bra, no tubes or cords. Hidden under your top and quiet in a normal room.</p>"
          }
        },
        "f_6": {
          "type": "faq",
          "settings": {
            "q": "How fast is delivery?",
            "a": "<p>Tracked delivery across Lebanon in 48 hours, with WhatsApp support 7 days a week.</p>"
          }
        }
      },
