{% comment %} WhatsApp attribution for Meta and Shopify draft-order matching. {% endcomment %}
<script>
(function () {
  'use strict';

  var STORE = 'lb';
  var TRACKING_SERVER_URL = 'https://weewonders-lb-tracking.vercel.app';
  var urlParams = new URLSearchParams(window.location.search);

  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
    return match ? decodeURIComponent(match[3]) : null;
  }
  function setCookie(name, value, days) {
    var until = new Date(Date.now() + days * 86400000).toUTCString();
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + until + '; path=/; SameSite=Lax';
  }
  function buildAttribution() {
    var result = {};
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (key) {
      var value = urlParams.get(key);
      if (value) {
        result[key] = value;
        try { sessionStorage.setItem('ww_' + key, value); } catch (_) {}
      } else {
        try { value = sessionStorage.getItem('ww_' + key); } catch (_) {}
        if (value) result[key] = value;
      }
    });
    return result;
  }

  var fbc = getCookie('_fbc');
  var fbp = getCookie('_fbp');
  var fbclid = urlParams.get('fbclid');
  if (!fbc && fbclid) {
    fbc = 'fb.1.' + Date.now() + '.' + fbclid;
    setCookie('_fbc', fbc, 90);
  }
  var attribution = buildAttribution();

  function generateRef() {
    var chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
    var ref = 'W';
    for (var i = 0; i < 6; i += 1) ref += chars.charAt(Math.floor(Math.random() * chars.length));
    return ref;
  }
  function cartData() {
    return fetch('/cart.js', { credentials: 'same-origin' })
      .then(function (response) { return response.ok ? response.json() : {}; })
      .then(function (cart) {
        var items = Array.isArray(cart.items) ? cart.items : [];
        var contents = items.map(function (item) {
          return { id: String(item.product_id || item.variant_id || ''), quantity: Number(item.quantity || 1), item_price: Number(item.final_price || item.price || 0) / 100 };
        }).filter(function (item) { return item.id; });
        return { value: Number(cart.total_price || 0) / 100, currency: cart.currency || 'USD', num_items: items.reduce(function (total, item) { return total + Number(item.quantity || 0); }, 0), content_ids: contents.map(function (item) { return item.id; }), contents: contents };
      }).catch(function () { return { value: 0, currency: 'USD', num_items: 0, content_ids: [], contents: [] }; });
  }
  function updateCartRef(ref) {
    return fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ attributes: { wa_ref: ref } }), keepalive: true }).catch(function () {});
  }
  function whatsappUrl(link, ref) {
    var href = link.getAttribute('href') || '';
    var tag = ' [Ref: ' + ref + ']';
    if (href.indexOf('text=') >= 0) return href.replace(/([?&]text=)([^&]*)/, function (_, prefix, text) { return prefix + text + encodeURIComponent(tag); });
    return href + (href.indexOf('?') >= 0 ? '&' : '?') + 'text=' + encodeURIComponent('Hi WeeWonders' + tag);
  }
  function publishWhatsApp(ref, ts, cart) {
    if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') {
      Shopify.analytics.publish('ww_whatsapp', { ref: ref, ts: ts, value: cart.value, currency: cart.currency, content_ids: cart.content_ids, num_items: cart.num_items });
    }
  }
  function storeClick(ref, ts, cart) {
    return fetch(TRACKING_SERVER_URL.replace(/\/+$/, '') + '/api/wa-click', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
      body: JSON.stringify({ ref: ref, ts: ts, fbc: fbc, fbp: fbp, attribution: attribution, fbclid: fbclid, ad_id: urlParams.get('ad_id'), cart: cart, store: STORE, page_url: window.location.href })
    });
  }
  function openWhatsApp(link, href) {
    if (link.target === '_blank') {
      var popup = window.open(href, '_blank', 'noopener');
      if (popup) return;
    }
    window.location.assign(href);
  }

  document.addEventListener('click', function (event) {
    var link = event.target.closest('a[href*="wa.me"], a[href*="whatsapp.com"], [data-whatsapp-btn], [data-whatsapp-order]');
    if (!link || link.dataset.wwTrackingPending === 'true') return;
    event.preventDefault();
    link.dataset.wwTrackingPending = 'true';
    var ref = generateRef();
    var ts = Date.now();
    var href = whatsappUrl(link, ref);
    cartData().then(function (cart) {
      publishWhatsApp(ref, ts, cart);
      // The old direct fbq WW_WhatsApp call is intentionally removed. The
      // installed custom pixel owns the browser/server event and deduplication.
      return Promise.allSettled([updateCartRef(ref), storeClick(ref, ts, cart)]);
    }).finally(function () { openWhatsApp(link, href); });
  }, true);
}());
</script>
