{% comment %}
  Section: Centered Underline Dropdowns (Premium Icons + Brand Blue)
  - Centered heading + subheading
  - Each row is a full-width underline in brand color
  - Premium minimal line icons (inline SVG) in your blue
  - Click row to expand (no “FAQ box” styling)
  - Centered dropdown content
  - RTL support
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign is_arabic = false
 if request.locale.iso_code contains 'ar'
    assign is_arabic = true
  endif

  assign accent = section.settings.accent_color | default: '#7ac8f0'
-%}

<section id="ww-underline-dropdown-{{ sid }}" class="ww-ud {% if is_arabic %}ww-ud--rtl{% endif %}">
  <div class="ww-ud__wrap">
    {% if section.settings.heading != blank %}
  <h2 class="ww-ud__heading">
    {% if is_arabic %}
      الفوائد ببساطة
    {% else %}
      {{ section.settings.heading }}
    {% endif %}
  </h2>
{% endif %}

   {% if section.settings.subheading != blank %}
  <p class="ww-ud__subheading">
    {% if is_arabic %}
      تفاصيل بسيطة بس بتفرق براحتك، بتحكّمك، وبسهولة استخدامك كل يوم.
    {% else %}
      {{ section.settings.subheading }}
    {% endif %}
  </p>
{% endif %}

    <div class="ww-ud__list" aria-label="Benefits dropdown list">
      {% for block in section.blocks %}
        <details class="ww-ud__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="ww-ud__summary">
            <span class="ww-ud__left">
              <span class="ww-ud__icon" aria-hidden="true">
                {%- case block.settings.icon -%}

                  {%- when 'wave' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M3 15c2.2-3.6 4.8-3.6 7 0s4.8 3.6 7 0 4.8-3.6 7 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3 9c2.2-3.6 4.8-3.6 7 0s4.8 3.6 7 0 4.8-3.6 7 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.65"/>
                    </svg>

                  {%- when 'tune' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M6 4v16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M18 4v16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M6 8h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M12 16h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <circle cx="12" cy="8" r="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                      <circle cx="12" cy="16" r="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    </svg>

                  {%- when 'quiet' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M11 5 7.8 7.7H5.5A2.5 2.5 0 0 0 3 10.2v3.6a2.5 2.5 0 0 0 2.5 2.5h2.3L11 19V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                      <path d="M15 9.5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M18 10.5v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.7"/>
                    </svg>

                  {%- when 'spark' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2l1.3 5.2L18 8.5l-4.7 1.3L12 15l-1.3-5.2L6 8.5l4.7-1.3L12 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                      <path d="M19 13l.7 2.8L22 16.5l-2.3.7L19 20l-.7-2.8L16 16.5l2.3-.7L19 13Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.75"/>
                    </svg>

                  {%- when 'clean' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M7 6h10l-1 16H8L7 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                      <path d="M9 6V4h6v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M10 10v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
                      <path d="M14 10v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.75"/>
                    </svg>

                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2l8 4v7c0 5-3.4 8.7-8 9-4.6-.3-8-4-8-9V6l8-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                      <path d="M9.2 12.2 11 14l4.2-4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {%- endcase -%}
              </span>

              <span class="ww-ud__title">
  {% if is_arabic %}
    {% case forloop.index %}
      {% when 1 %}
        شفط بإيقاع بيشبه رضاعة البيبي
      {% when 2 %}
        ٤ أوضاع • ١٢ مستوى لكل وضع
      {% when 3 %}
        وضع تلقائي بيتأقلم معك
      {% when 4 %}
        تصميم هادئ وبتلبسيه
      {% when 5 %}
        سهلة التنظيف
      {% when 6 %}
        توقّف تلقائي للأمان
      {% else %}
        {{ block.settings.title }}
    {% endcase %}
  {% else %}
    {{ block.settings.title }}
  {% endif %}
</span>
            </span>

            <span class="ww-ud__arrow" aria-hidden="true"></span>
          </summary>

          <div class="ww-ud__content">
            <div class="ww-ud__content-inner">
              {% if block.settings.text != blank %}
  <div class="ww-ud__text rte">
    {% if is_arabic %}
      {% case forloop.index %}
        {% when 1 %}
          <p>مصمّمة لتعطي إحساس قريب من رضاعة البيبي الطبيعية، لراحة أكتر وتدفّق حليب أسلس.</p>
        {% when 2 %}
          <p>اختاري بين التحفيز، الشفط، المساج، أو الوضع التلقائي — وبعدها عدّلي القوة حسب اللي بيريّحك.</p>
        {% when 3 %}
          <p>الوضع التلقائي بيزيد القوة تدريجياً وبيساعدك تنتقلي بسلاسة خلال جلسة الشفط.</p>
        {% when 4 %}
          <p>بتنحط جوّا حمالة صدر لتشفطي براحة ومن دون إيدين، وبطريقة هادئة ومش ملفتة خلال يومك.</p>
        {% when 5 %}
          <p> 4 أجزاء تنظيفها سريع، لتناسب الاستخدام اليومي من دون تعقيد.</p>
        {% when 6 %}
          <p>بتتوقّف تلقائياً بعد ٣٠ دقيقة لروتين أريح ومن دون قلق.</p>
        {% else %}
          {{ block.settings.text }}
      {% endcase %}
    {% else %}
      {{ block.settings.text }}
    {% endif %}
  </div>
{% endif %}
            </div>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>

 <style>
  #ww-underline-dropdown-{{ sid }}.ww-ud{
    --ud-accent: {{ accent }};
    --ud-max: {{ section.settings.max_width }}px;
    --ud-pad-top: {{ section.settings.padding_top }}px;
    --ud-pad-bot: {{ section.settings.padding_bottom }}px;
    --ud-text: {{ section.settings.text_color }};
    --ud-muted: {{ section.settings.muted_color }};

    width: 100%;
    padding: var(--ud-pad-top) 20px var(--ud-pad-bot);
    font-family: var(--font-body-family, inherit);
    background: transparent;
    color: var(--ud-text);
  }

  #ww-underline-dropdown-{{ sid }} .ww-ud__wrap{
    max-width: min(var(--ud-max), calc(100vw - 40px));
    margin: 0 auto;
    text-align: center;
  }

  /* Centered title/subheading */
  #ww-underline-dropdown-{{ sid }} .ww-ud__heading{
    margin: 0 0 10px;
    font-size: clamp(22px, 2.8vw, 32px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ud-text);
  }

  #ww-underline-dropdown-{{ sid }} .ww-ud__subheading{
    margin: 0 auto 22px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ud-muted);
    max-width: 70ch;
  }

  /* List */
  #ww-underline-dropdown-{{ sid }} .ww-ud__list{
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    text-align: left; /* CONTENT LEFT ALIGNED */
  }

  /* Item */
  #ww-underline-dropdown-{{ sid }} .ww-ud__item{
    width: 100%;
  }

  /* Remove default marker */
  #ww-underline-dropdown-{{ sid }} summary{
    list-style: none;
  }
  #ww-underline-dropdown-{{ sid }} summary::-webkit-details-marker{
    display: none;
  }

  /* Summary row: full underline in blue */
  #ww-underline-dropdown-{{ sid }} .ww-ud__summary{
    cursor: pointer;
    width: 100%;
    padding: 14px 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;

    border-bottom: 1px solid var(--ud-accent);
    outline: none;
    user-select: none;
  }

  /* Left group (NOW LEFT ALIGNED, not centered) */
  #ww-underline-dropdown-{{ sid }} .ww-ud__left{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;              /* remove centering */
    justify-content: flex-start;
  }

  /* Premium icon */
  #ww-underline-dropdown-{{ sid }} .ww-ud__icon{
    width: 18px;
    height: 18px;
    display: inline-flex;
    color: var(--ud-accent);
    flex: 0 0 auto;
    opacity: 0.95;
  }
  #ww-underline-dropdown-{{ sid }} .ww-ud__icon svg{
    width: 100%;
    height: 100%;
    display: block;
    stroke: currentColor;
  }

  /* Title */
  #ww-underline-dropdown-{{ sid }} .ww-ud__title{
    font-size: 15px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ud-text);
    text-align: left; /* ensure left */
  }

  /* Arrow (minimal) */
  #ww-underline-dropdown-{{ sid }} .ww-ud__arrow{
    width: 10px;
    height: 10px;
    border-right: 1.6px solid var(--ud-accent);
    border-bottom: 1.6px solid var(--ud-accent);
    transform: rotate(45deg);
    transition: transform .18s ease;
    opacity: 0.9;
    flex: 0 0 auto;
  }

  #ww-underline-dropdown-{{ sid }} details[open] .ww-ud__arrow{
    transform: rotate(-135deg);
  }

  /* Content */
  #ww-underline-dropdown-{{ sid }} .ww-ud__content{
    overflow: hidden;
    text-align: left; /* CONTENT LEFT */
  }

  #ww-underline-dropdown-{{ sid }} .ww-ud__content-inner{
    padding: 12px 0 18px;
    max-width: 70ch;
    margin: 0; /* remove centering so it aligns left with list */
  }

  #ww-underline-dropdown-{{ sid }} .ww-ud__text{
    font-size: 14px;
    line-height: 1.75;
    color: var(--ud-muted);
    text-align: left; /* ensure left */
  }
  #ww-underline-dropdown-{{ sid }} .ww-ud__text > *:first-child{ margin-top: 0; }
  #ww-underline-dropdown-{{ sid }} .ww-ud__text > *:last-child{ margin-bottom: 0; }

  /* RTL */
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl{
    direction: rtl;
  }
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__list{
    text-align: right;
  }
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__summary{
    flex-direction: row-reverse;
  }
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__left{
    justify-content: flex-start;
  }
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__title,
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__content,
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__content-inner,
  #ww-underline-dropdown-{{ sid }}.ww-ud--rtl .ww-ud__text{
    text-align: right;
  }

  /* Mobile */
  @media (max-width: 520px){
    #ww-underline-dropdown-{{ sid }} .ww-ud__summary{
      padding: 12px 0;
    }
    #ww-underline-dropdown-{{ sid }} .ww-ud__title{
      font-size: 14px;
    }
    #ww-underline-dropdown-{{ sid }} .ww-ud__text{
      font-size: 13.5px;
    }
  }
</style>
</section>

{% schema %}
{
  "name": "Centered Underline ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Benefits, explained simply"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Minimal details that matter—designed for comfort, control, and everyday ease."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (underline + icons)",
      "default": "#7ac8f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Body color",
      "default": "#5b5f6a"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 320,
      "max": 1400,
      "step": 20,
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit dropdown",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "wave",
          "options": [
            { "value": "wave", "label": "Rhythmic" },
            { "value": "tune", "label": "Modes/Levels" },
            { "value": "quiet", "label": "Quiet" },
            { "value": "spark", "label": "Smart/Auto" },
            { "value": "clean", "label": "Easy Clean" },
            { "value": "shield", "label": "Safety" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Row title",
          "default": "Baby-like rhythmic suction"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Dropdown content",
          "default": "<p>Mimics a natural latch feel to support comfort and smoother milk flow during pumping.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Centered Underline Dropdowns",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "wave",
            "title": "Baby-like rhythmic suction",
            "text": "<p>Designed to mimic a baby’s natural latch feel for comfort and smoother milk flow.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "tune",
            "title": "4 modes • 12 levels each",
            "text": "<p>Choose Stimulation, Expression, Massage, or Automatic—then fine-tune intensity to what feels right.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "spark",
            "title": "Automatic mode that adapts",
            "text": "<p>Automatic mode gradually increases intensity and supports a smooth transition into your session.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "quiet",
            "title": "Quiet, wearable design",
            "text": "<p>Fits inside your bra for hands-free pumping with discreet everyday comfort.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clean",
            "title": "Easy to clean",
            "text": "<p>Simple parts and quick cleanup designed for daily use.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Auto-stop safety",
            "text": "<p>Automatically stops after 30 minutes for a worry-free routine.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}