{% comment %}
  Section: Featured In (auto-scrolling marquee) + Feature Carousel (Progress + Testimonial)
  - TOP: "FEATURED IN" + logos auto-scroll horizontally (no JS)
  - Then: title/subtitle + product image + feature circles + timed progress bar swapping content + testimonial
{% endcomment %}

<section
  id="slumbr-features-{{ section.id }}"
  class="slumbr-features"
  style="
    --sf-bg: {{ section.settings.bg_color }};
    --sf-text: {{ section.settings.text_color }};
    --sf-muted: {{ section.settings.muted_color }};
    --sf-accent: {{ section.settings.accent_color }};
    --sf-pill-bg: {{ section.settings.pill_bg }};
    --sf-pill-text: {{ section.settings.pill_text }};
    --sf-card-bg: {{ section.settings.card_bg }};
    --sf-card-border: {{ section.settings.card_border }};
    --sf-progress-track: {{ section.settings.progress_track }};
    --sf-progress-fill: {{ section.settings.progress_fill }};
    --sf-max: {{ section.settings.max_width }}px;
    --sf-marquee-speed: {{ section.settings.marquee_seconds }}s;
  "
>
  <div class="sf-inner">

    {% assign logo_blocks = section.blocks | where: "type", "logo" %}
    {% if section.settings.show_featured_in and logo_blocks.size > 0 %}
      <div class="sf-featured">
        {% if section.settings.featured_in_text != blank %}
          <div class="sf-featured__label">{{ section.settings.featured_in_text }}</div>
        {% endif %}

        <div class="sf-featured__row" aria-label="Featured in logos">
          <div class="sf-featured__track">
            {% for block in logo_blocks %}
              <div class="sf-featured__logo" {{ block.shopify_attributes }}>
                {% if block.settings.logo_image != blank %}
                 {{
  block.settings.logo_image
  | image_url: width: 800
  | image_tag:
    widths: '320, 420, 600, 800',
    sizes: '(min-width: 900px) 420px, 360px',
    loading: 'lazy',
    class: 'sf-featured__img',
    alt: block.settings.logo_alt | escape
}}

                {% else %}
                  <span class="sf-featured__text">{{ block.settings.logo_text }}</span>
                {% endif %}
              </div>
            {% endfor %}

            {%- comment -%} duplicate once for seamless loop {%- endcomment -%}
            {% for block in logo_blocks %}
              <div class="sf-featured__logo" aria-hidden="true">
                {% if block.settings.logo_image != blank %}
                 {{
  block.settings.logo_image
  | image_url: width: 800
  | image_tag:
    widths: '320, 420, 600, 800',
    sizes: '(min-width: 900px) 420px, 360px',
    loading: 'lazy',
    class: 'sf-featured__img',
    alt: ''
}}

                {% else %}
                  <span class="sf-featured__text">{{ block.settings.logo_text }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}

    <header class="sf-head">
      {% if section.settings.heading != blank %}
        <h2 class="sf-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="sf-sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="sf-stage">
      <div class="sf-media">
        {% if section.settings.product_image != blank %}
          {{
            section.settings.product_image
            | image_url: width: 1800
            | image_tag:
              widths: '600, 900, 1200, 1600, 1800',
              sizes: '(min-width: 900px) 520px, 78vw',
              loading: 'lazy',
              class: 'sf-img',
              alt: section.settings.product_image.alt | escape
          }}
        {% else %}
          <div class="sf-img-placeholder" aria-hidden="true"></div>
        {% endif %}

        <!-- Feature circles around image -->
        <div class="sf-pills" aria-label="Feature selectors">
          {% assign feature_blocks = section.blocks | where: "type", "feature" %}
          {% for block in feature_blocks %}
            <button
              class="sf-pill"
              type="button"
              data-sf-index="{{ forloop.index0 }}"
              data-sf-pos="{{ block.settings.position }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="sf-pill__icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 120
                    | image_tag:
                      widths: '60, 90, 120',
                      sizes: '24px',
                      loading: 'lazy',
                      class: 'sf-pill__icon-img',
                      alt: ''
                  }}
                {% else %}
                  {% case block.settings.icon_style %}
                    {% when 'moon' %}
                      <svg viewBox="0 0 24 24"><path d="M21 14.2A8.2 8.2 0 0 1 9.8 3a7 7 0 1 0 11.2 11.2Z" fill="currentColor"/></svg>
                    {% when 'bolt' %}
                      <svg viewBox="0 0 24 24"><path d="M13 2 3 14h8l-1 8 11-14h-8l0-6Z" fill="currentColor"/></svg>
                    {% when 'heart' %}
                      <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9A6 6 0 0 1 12 6a6 6 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9Z" fill="currentColor"/></svg>
                    {% when 'spark' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2Z" fill="currentColor"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="currentColor"/></svg>
                  {% endcase %}
                {% endif %}
              </span>
              <span class="sf-pill__label">{{ block.settings.label }}</span>
            </button>
          {% endfor %}
        </div>
      </div>

      <!-- Content area (changes with active feature) -->
      <div class="sf-content" aria-live="polite">
        {% for block in feature_blocks %}
          <div class="sf-panel {% if forloop.first %}is-active{% endif %}" data-sf-panel="{{ forloop.index0 }}">
            <div class="sf-panel__kicker">
              <span class="sf-panel__kicker-icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 120
                    | image_tag:
                      widths: '60, 90, 120',
                      sizes: '22px',
                      loading: 'lazy',
                      class: 'sf-kicker__icon-img',
                      alt: ''
                  }}
                {% else %}
                  {% case block.settings.icon_style %}
                    {% when 'moon' %}
                      <svg viewBox="0 0 24 24"><path d="M21 14.2A8.2 8.2 0 0 1 9.8 3a7 7 0 1 0 11.2 11.2Z" fill="currentColor"/></svg>
                    {% when 'bolt' %}
                      <svg viewBox="0 0 24 24"><path d="M13 2 3 14h8l-1 8 11-14h-8l0-6Z" fill="currentColor"/></svg>
                    {% when 'heart' %}
                      <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9A6 6 0 0 1 12 6a6 6 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9Z" fill="currentColor"/></svg>
                    {% when 'spark' %}
                      <svg viewBox="0 0 24 24"><path d="M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2Z" fill="currentColor"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="currentColor"/></svg>
                  {% endcase %}
                {% endif %}
              </span>
              <span class="sf-panel__kicker-text">{{ block.settings.label }}</span>
            </div>

            {% if block.settings.title != blank %}
              <h3 class="sf-panel__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="sf-panel__text">{{ block.settings.text }}</p>
            {% endif %}

            <!-- Testimonial -->
            <div class="sf-testimonial">
              <div class="sf-stars" aria-hidden="true">
                {% assign stars = block.settings.stars | default: 5 %}
                {% for i in (1..5) %}
                  <span class="sf-star {% if i <= stars %}is-on{% endif %}">
                    <svg viewBox="0 0 24 24"><path d="M12 2l2.93 6.63 7.07.61-5.35 4.64 1.6 6.92L12 17.77 5.75 20.8l1.6-6.92L2 9.24l7.07-.61L12 2z"/></svg>
                  </span>
                {% endfor %}
              </div>

              {% if block.settings.quote != blank %}
                <div class="sf-quote">“{{ block.settings.quote }}”</div>
              {% endif %}

              <div class="sf-who">
                {% if block.settings.name != blank %}
                  <span class="sf-name">{{ block.settings.name }}</span>
                {% endif %}
                {% if block.settings.badge != blank %}
                  <span class="sf-badge">{{ block.settings.badge }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}

        <!-- Progress bar -->
        <div class="sf-progress" aria-hidden="true">
          <div class="sf-progress__track">
            <div class="sf-progress__fill" style="width:0%"></div>
          </div>
        </div>

        {% if section.settings.button_label != blank %}
          <div class="sf-cta">
            <a class="sf-btn" href="{{ section.settings.button_link | default: '#' }}">
              <span class="sf-btn__text">{{ section.settings.button_label }}</span>
              <span class="sf-btn__arrow" aria-hidden="true">?</span>
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <script>
  (function(){
    const root = document.getElementById("slumbr-features-{{ section.id }}");
    if (!root || root.__sf_init) return;
    root.__sf_init = true;

    const pills = Array.from(root.querySelectorAll(".sf-pill"));
    const panels = Array.from(root.querySelectorAll(".sf-panel"));
    const fill = root.querySelector(".sf-progress__fill");

    const durationMs = Math.max(1000, ({{ section.settings.autoplay_seconds | default: 5 }} * 1000));
    let active = 0;
    let raf = null;
    let startTs = 0;
    let playing = false;

    function clamp(n, a, b){ return Math.max(a, Math.min(b, n)); }

    function setActive(idx, fromUser){
      active = clamp(idx, 0, panels.length - 1);

      panels.forEach((p, i) => p.classList.toggle("is-active", i === active));
      pills.forEach((b, i) => {
        const isOn = i === active;
        b.classList.toggle("is-active", isOn);
        b.setAttribute("aria-pressed", isOn ? "true" : "false");
      });

      if (fill) fill.style.width = "0%";
      startTs = performance.now();

      if (fromUser) play();
    }

    function tick(now){
      if (!playing) return;
      const elapsed = now - startTs;
      const pct = clamp(elapsed / durationMs, 0, 1) * 100;
      if (fill) fill.style.width = pct.toFixed(2) + "%";

      if (elapsed >= durationMs) {
        setActive((active + 1) % panels.length, false);
      }

      raf = requestAnimationFrame(tick);
    }

    function play(){
      if (playing || panels.length <= 1) return;
      playing = true;
      startTs = performance.now();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    function pause(){
      playing = false;
      cancelAnimationFrame(raf);
      raf = null;
    }

    pills.forEach(btn => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.getAttribute("data-sf-index"), 10);
        if (!Number.isNaN(idx)) setActive(idx, true);
      });
    });

    const io = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      if (entry.isIntersecting && entry.intersectionRatio > 0.35) play();
      else pause();
    }, { threshold: [0, 0.2, 0.35, 0.5, 0.8, 1] });

    io.observe(root);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause();
      else {
        const r = root.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const visible = r.top < vh * 0.75 && r.bottom > vh * 0.25;
        if (visible) play();
      }
    });

    setActive(0, false);
  })();
  </script>
</section>

<style>
  #slumbr-features-{{ section.id }}{
    background: var(--sf-bg);
    color: var(--sf-text);
  }

  #slumbr-features-{{ section.id }} .sf-inner{
    max-width: var(--sf-max);
    margin: 0 auto;
    padding: 26px 16px 44px;
  }

  /* ===== Featured In (AUTO marquee) ===== */
  #slumbr-features-{{ section.id }} .sf-featured{
    text-align: center;
    margin: 0 0 18px;
  }

  #slumbr-features-{{ section.id }} .sf-featured__label{
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 800;
    color: rgba(255,255,255,0.78);
    margin-bottom: 10px;
  }

  #slumbr-features-{{ section.id }} .sf-featured__row{
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 10px 0; /* a bit more vertical room */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
  }

  #slumbr-features-{{ section.id }} .sf-featured__track{
    display: inline-flex;
    align-items: center;
    gap: 34px; /* more spacing for larger logos */
    white-space: nowrap;
    will-change: transform;
    animation: sfLogoMarquee-{{ section.id }} var(--sf-marquee-speed) linear infinite;
  }

  #slumbr-features-{{ section.id }} .sf-featured__row:hover .sf-featured__track{
    animation-play-state: paused;
  }

  @keyframes sfLogoMarquee-{{ section.id }}{
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* works because we duplicate logos in markup */
  }

  /* Make each logo "slot" bigger */
  #slumbr-features-{{ section.id }} .sf-featured__logo{
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    min-width: 220px; /* BIGGER */
    opacity: 0.95;
    padding: 4px 0; /* breathing room */
  }

  /* Make the actual logo image much bigger */
  #slumbr-features-{{ section.id }} .sf-featured__img{
    height: 40px; /* BIGGER (was 22px) */
    width: auto;
    max-width: 260px; /* prevents super wide logos from exploding */
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.98;
  }

  /* If you use text-only logos, make those bigger too */
  #slumbr-features-{{ section.id }} .sf-featured__text{
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.92);
    font-size: 26px; /* BIGGER (was 18px) */
    line-height: 1;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce){
    #slumbr-features-{{ section.id }} .sf-featured__track{
      animation: none !important;
    }
  }

  /* Header */
  #slumbr-features-{{ section.id }} .sf-head{
    text-align: center;
    margin-bottom: 18px;
  }
  #slumbr-features-{{ section.id }} .sf-title{
    margin: 0 0 10px;
    font-size: 30px;
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  #slumbr-features-{{ section.id }} .sf-sub{
    margin: 0;
    color: var(--sf-muted);
    font-size: 14.5px;
    line-height: 1.5;
  }

  /* Stage layout */
  #slumbr-features-{{ section.id }} .sf-stage{
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: start;
  }

  /* Media */
  #slumbr-features-{{ section.id }} .sf-media{
    position: relative;
    display: grid;
    place-items: center;
    padding: 10px 0 6px;
  }
  #slumbr-features-{{ section.id }} .sf-img{
    width: min(520px, 78vw);
    height: auto;
    display: block;
  }
  #slumbr-features-{{ section.id }} .sf-img-placeholder{
    width: min(520px, 78vw);
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    background: rgba(255,255,255,0.08);
  }

  /* Pills around image */
  #slumbr-features-{{ section.id }} .sf-pills{
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  #slumbr-features-{{ section.id }} .sf-pill{
    pointer-events: auto;
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.28);
    background: rgba(0,0,0,0.16);
    color: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
    user-select: none;
    transition: transform .15s ease, background .2s ease, border-color .2s ease, color .2s ease;
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }
  #slumbr-features-{{ section.id }} .sf-pill:hover{ transform: translateY(-1px); }

  #slumbr-features-{{ section.id }} .sf-pill__icon{
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    color: currentColor;
  }
  #slumbr-features-{{ section.id }} .sf-pill__icon svg{
    width: 22px;
    height: 22px;
    fill: currentColor;
    display: block;
  }
  #slumbr-features-{{ section.id }} .sf-pill__icon-img{
    width: 22px;
    height: 22px;
    object-fit: contain;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* Active pill (white filled) */
  #slumbr-features-{{ section.id }} .sf-pill.is-active{
    background: var(--sf-pill-bg);
    color: var(--sf-pill-text);
    border-color: rgba(255,255,255,0.0);
  }

  /* Positions */
  #slumbr-features-{{ section.id }} .sf-pill[data-sf-pos="top-left"]{ top: 10%; left: 4%; }
  #slumbr-features-{{ section.id }} .sf-pill[data-sf-pos="bottom-left"]{ bottom: 18%; left: 2%; }
  #slumbr-features-{{ section.id }} .sf-pill[data-sf-pos="top-right"]{ top: 12%; right: 4%; }
  #slumbr-features-{{ section.id }} .sf-pill[data-sf-pos="bottom-right"]{ bottom: 20%; right: 2%; }

  /* Content */
  #slumbr-features-{{ section.id }} .sf-content{ position: relative; }

  /* Panels swap (fade) */
  #slumbr-features-{{ section.id }} .sf-panel{
    display: none;
    animation: sfFade-{{ section.id }} .22s ease both;
  }
  #slumbr-features-{{ section.id }} .sf-panel.is-active{ display: block; }

  @keyframes sfFade-{{ section.id }}{
    from{ opacity: 0; transform: translateY(6px); }
    to{ opacity: 1; transform: translateY(0); }
  }

  #slumbr-features-{{ section.id }} .sf-panel__kicker{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--sf-text);
  }
  #slumbr-features-{{ section.id }} .sf-panel__kicker-icon{
    width: 20px; height: 20px;
    display: grid; place-items: center;
  }
  #slumbr-features-{{ section.id }} .sf-panel__kicker-icon svg{
    width: 20px; height: 20px; fill: currentColor;
    display: block;
  }
  #slumbr-features-{{ section.id }} .sf-kicker__icon-img{
    width: 20px; height: 20px; object-fit: contain;
    filter: brightness(0) invert(1);
  }
  #slumbr-features-{{ section.id }} .sf-panel__kicker-text{
    font-weight: 750;
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  #slumbr-features-{{ section.id }} .sf-panel__title{
    margin: 0 0 10px;
    font-size: 22px;
    line-height: 1.15;
    font-weight: 800;
  }
  #slumbr-features-{{ section.id }} .sf-panel__text{
    margin: 0 0 14px;
    color: var(--sf-muted);
    font-size: 14.5px;
    line-height: 1.6;
    max-width: 52ch;
  }

  /* Testimonial card */
  #slumbr-features-{{ section.id }} .sf-testimonial{
    background: var(--sf-card-bg);
    border: 1px solid var(--sf-card-border);
    border-radius: 14px;
    padding: 14px 14px 12px;
  }
  #slumbr-features-{{ section.id }} .sf-stars{
    display: inline-flex;
    gap: 5px;
    margin-bottom: 10px;
  }
  #slumbr-features-{{ section.id }} .sf-star{
    width: 16px; height: 16px; display: inline-flex;
    opacity: 0.25;
  }
  #slumbr-features-{{ section.id }} .sf-star svg{ width: 100%; height: 100%; fill: var(--sf-accent); }
  #slumbr-features-{{ section.id }} .sf-star.is-on{ opacity: 1; }

  #slumbr-features-{{ section.id }} .sf-quote{
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--sf-text);
    margin-bottom: 10px;
  }
  #slumbr-features-{{ section.id }} .sf-who{
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  #slumbr-features-{{ section.id }} .sf-name{ font-weight: 750; font-size: 13.5px; }
  #slumbr-features-{{ section.id }} .sf-badge{
    font-size: 12px;
    color: var(--sf-muted);
    border: 1px solid rgba(255,255,255,0.20);
    padding: 3px 8px;
    border-radius: 999px;
  }

  /* Progress bar */
  #slumbr-features-{{ section.id }} .sf-progress{ margin-top: 12px; }
  #slumbr-features-{{ section.id }} .sf-progress__track{
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: var(--sf-progress-track);
    overflow: hidden;
  }
  #slumbr-features-{{ section.id }} .sf-progress__fill{
    height: 100%;
    width: 0%;
    background: var(--sf-progress-fill);
    border-radius: 999px;
    transition: width 0.08s linear;
  }

  /* CTA */
  #slumbr-features-{{ section.id }} .sf-cta{ margin-top: 14px; }
  #slumbr-features-{{ section.id }} .sf-btn{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
    border-radius: 12px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.10);
  }
  #slumbr-features-{{ section.id }} .sf-btn__text{
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 15px;
  }
  #slumbr-features-{{ section.id }} .sf-btn__arrow{
    font-size: 22px;
    transform: translateY(-1px);
  }

  @media (min-width: 900px){
    #slumbr-features-{{ section.id }} .sf-inner{ padding: 34px 22px 56px; }
    #slumbr-features-{{ section.id }} .sf-title{ font-size: 36px; }
    #slumbr-features-{{ section.id }} .sf-sub{ font-size: 15px; }

    /* Even bigger on desktop */
    #slumbr-features-{{ section.id }} .sf-featured__logo{ min-width: 260px; }
    #slumbr-features-{{ section.id }} .sf-featured__img{
