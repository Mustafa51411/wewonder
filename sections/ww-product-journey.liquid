{% assign rule_cards = section.blocks | where: 'type', 'rule_card' %}
{% assign journey_steps = section.blocks | where: 'type', 'step' %}

{% if rule_cards.size > 0 or journey_steps.size > 0 %}
  <section class="ww-journey" id="ww-journey-{{ section.id }}">
    <style>
      #ww-journey-{{ section.id }}{--navy:{{ section.settings.navy }};--blue:{{ section.settings.accent }};--pale:{{ section.settings.surface }};color:#1f3040;font-family:var(--font-body-family,inherit)}#ww-journey-{{ section.id }} *{box-sizing:border-box}#ww-journey-{{ section.id }} .wwj-wrap{width:min(1120px,calc(100% - 40px));margin:auto}#ww-journey-{{ section.id }} .wwj-rule{padding:clamp(58px,8vw,100px) 0;background:var(--navy);color:#fff;text-align:center}#ww-journey-{{ section.id }} small{display:block;color:#c5e4f2;font-weight:800}#ww-journey-{{ section.id }} h2{margin:9px 0 32px;font-family:var(--font-heading-family,inherit);font-size:clamp(30px,4vw,52px);line-height:1.05;letter-spacing:-.04em}#ww-journey-{{ section.id }} mark{padding:.02em .14em;background:var(--blue);color:var(--navy)}#ww-journey-{{ section.id }} .wwj-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;max-width:840px;margin:auto}#ww-journey-{{ section.id }} .wwj-card{padding:24px;border:1px solid rgba(196,224,238,.27);border-radius:20px;background:rgba(255,255,255,.07)}#ww-journey-{{ section.id }} .wwj-card img{display:block;width:100%;aspect-ratio:16/9;margin-bottom:18px;border-radius:13px;object-fit:cover;background:rgba(255,255,255,.08)}#ww-journey-{{ section.id }} h3{margin:0;color:inherit;font-size:19px}#ww-journey-{{ section.id }} .wwj-card p{margin:10px 0;color:#d2e3ec;line-height:1.55}#ww-journey-{{ section.id }} .wwj-card strong{display:block;margin-top:17px;color:var(--blue);font-size:17px}#ww-journey-{{ section.id }} .wwj-timeline{padding:clamp(54px,8vw,96px) 0;background:var(--pale);text-align:center}#ww-journey-{{ section.id }} .wwj-timeline h2{margin-bottom:10px;color:var(--navy)}#ww-journey-{{ section.id }} .wwj-intro{max-width:640px;margin:0 auto 38px;color:#647783;line-height:1.55}#ww-journey-{{ section.id }} .wwj-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;position:relative}#ww-journey-{{ section.id }} .wwj-steps:before{position:absolute;top:16px;right:8%;left:8%;height:2px;background:#dbe8ee;content:''}#ww-journey-{{ section.id }} .wwj-step{position:relative;z-index:1}#ww-journey-{{ section.id }} .wwj-dot{display:grid;width:34px;height:34px;margin:0 auto 14px;place-items:center;border:2px solid var(--blue);border-radius:50%;background:#fff;color:var(--navy);font-size:12px;font-weight:850}#ww-journey-{{ section.id }} .wwj-step h3{color:var(--navy);font-size:15px}#ww-journey-{{ section.id }} .wwj-step p{margin:7px 0 0;color:#647783;font-size:12px;line-height:1.45}@media(max-width:700px){#ww-journey-{{ section.id }} .wwj-wrap{width:min(100% - 28px,1120px)}#ww-journey-{{ section.id }} .wwj-cards,#ww-journey-{{ section.id }} .wwj-steps{grid-template-columns:1fr}#ww-journey-{{ section.id }} .wwj-steps:before{display:none}}
    </style>
    {% if rule_cards.size > 0 %}<div class="wwj-rule"><div class="wwj-wrap">{% if section.settings.rule_eyebrow != blank %}<small>{{ section.settings.rule_eyebrow }}</small>{% endif %}<h2>{{ section.settings.rule_heading }}</h2><div class="wwj-cards">{% for block in rule_cards %}<article class="wwj-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900' }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900' }}{% endif %}<h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.outcome != blank %}<strong>{{ block.settings.outcome }}</strong>{% endif %}</article>{% endfor %}</div></div></div>{% endif %}
    {% if journey_steps.size > 0 %}<div class="wwj-timeline"><div class="wwj-wrap"><h2>{{ section.settings.timeline_heading }}</h2>{% if section.settings.timeline_text != blank %}<p class="wwj-intro">{{ section.settings.timeline_text }}</p>{% endif %}<div class="wwj-steps">{% for block in journey_steps %}<article class="wwj-step" {{ block.shopify_attributes }}><span class="wwj-dot">{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></div>{% endif %}
  </section>
{% endif %}

{% schema %}
{"name":"Product journey","settings":[{"type":"text","id":"rule_eyebrow","label":"Rule eyebrow","default":"The simple rule"},{"type":"inline_richtext","id":"rule_heading","label":"Rule heading","default":"Your result can <mark>improve</mark>"},{"type":"text","id":"timeline_heading","label":"Timeline heading","default":"Your first month"},{"type":"textarea","id":"timeline_text","label":"Timeline introduction","default":"Add your product journey or milestones."},{"type":"color","id":"navy","label":"Dark color","default":"#1a2b3c"},{"type":"color","id":"accent","label":"Accent color","default":"#7ac8f0"},{"type":"color","id":"surface","label":"Timeline background","default":"#eff9fd"}],"blocks":[{"type":"rule_card","name":"Comparison card","limit":2,"settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Comparison title"},{"type":"textarea","id":"text","label":"Description","default":"Add factual comparison content here."},{"type":"text","id":"outcome","label":"Outcome","default":"Add outcome"}]},{"type":"step","name":"Timeline step","limit":5,"settings":[{"type":"text","id":"title","label":"Title","default":"Step title"},{"type":"textarea","id":"text","label":"Description","default":"Add step details here."}]}],"presets":[{"name":"Product journey","blocks":[{"type":"rule_card"},{"type":"rule_card"},{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}
