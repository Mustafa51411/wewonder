<link rel="stylesheet" href="{{ 'ww-pdp.css' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="ww-pdp">

{%- assign fallback_gallery_image = product.featured_image -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'gallery' and block.settings.image != blank -%}
    {%- assign fallback_gallery_image = block.settings.image -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign wa_num = section.settings.wa_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
{%- capture wa_default_msg -%}{{ section.settings.wa_message }}: {{ product.title }} - Double Pump Set{%- endcapture -%}
{%- assign fallback_storage_gift = all_products[section.settings.storage_gift_handle] -%}
{%- assign fallback_warmer_gift = all_products[section.settings.warmer_gift_handle] -%}
{%- assign fallback_pillow_gift = all_products[section.settings.pillow_gift_handle] -%}
{%- comment -%} Free gift rows are rendered from the "Free gift" blocks in the theme editor first (Customize > click a Free gift block: pick the product and the Double/Single/Both card). When a card has no matching block, rows come from the product's own "Free gifts" product metafield, then from the shared "Free gift" metaobject list (Shopify admin > Content > Metaobjects), and finally from each offer card's own text list. {%- endcomment -%}
{%- assign ww_empty_entries = '' | split: '' -%}
{%- assign ww_gift_entries = metaobjects.free_gift.values | default: ww_empty_entries -%}
{%- assign ww_gift_count = ww_gift_entries | size -%}
{%- assign ww_prod_entries = product.metafields.custom.free_gifts.value -%}
{%- assign ww_prod_count = ww_prod_entries | size -%}

{%- if section.settings.hide_announcement_bar != true -%}
  <div class="topbar">{{ section.settings.topbar_text }}</div>
{%- endif -%}

{%- if section.settings.show_nav -%}
<header class="head">
  <div class="wrap">
    {%- if section.settings.logo != blank -%}
      <img width="200" height="69" src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}">
    {%- else -%}
      <span class="ww-brand-text">{{ shop.name }}</span>
    {%- endif -%}
    <nav>
      <a href="#how">{{ section.settings.nav_how | default: "How it works" }}</a>
      <a href="#reviews">{{ section.settings.nav_reviews | default: "Reviews" }}</a>
      <a href="#faq">{{ section.settings.nav_faq | default: "FAQ" }}</a>
    </nav>
    <div class="rate"><span class="stars">★★★★★</span> {{ section.settings.rating }}</div>
  </div>
</header>
{%- endif -%}

<section class="pdp" id="ww-top">
  <div class="wrap">
    <div class="gallery">
      <div class="g-main">
        {%- if fallback_gallery_image != blank -%}
          <img width="1200" height="960" loading="eager" fetchpriority="high" id="mainimg" src="{{ fallback_gallery_image | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
        {%- endif -%}
        <div class="g-nav g-prev" onclick="galStep(-1)">‹</div>
        <div class="g-nav g-next" onclick="galStep(1)">›</div>
        {%- if section.settings.show_gallery_warranty_badge -%}
        <div class="stamp s1">
          <div class="scallop">
            <svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg>
            <div class="txt"><b>{{ section.settings.stamp_big }}</b><small>{{ section.settings.stamp_small | replace: ' ', '<br>' }}</small></div>
          </div>
        </div>
        {%- endif -%}
      </div>
      <div class="g-thumbs" id="thumbs">
      {%- assign gi = 0 -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'gallery' -%}
          {%- assign gallery_image = b.settings.image | default: product.images[gi] | default: product.featured_image -%}
          {%- if gallery_image != blank -%}
            <button {% if gi == 0 %}class="active"{% endif %} onclick="galSet({{ gi }})" aria-label="Photo {{ gi | plus: 1 }}" data-src="{{ gallery_image | image_url: width: 1400 }}" {{ b.shopify_attributes }}>
              <img width="300" height="300" loading="{% if gi < 6 %}eager{% else %}lazy{% endif %}" src="{{ gallery_image | image_url: width: 300 }}" alt="{{ product.title | escape }}">
            </button>
            {%- assign gi = gi | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>

    <div class="buy">
      <div class="rate"><span class="stars">★★★★★</span> {{ section.settings.rating }}/5 <span class="en">{{ section.settings.rating_note }}</span></div>
      <h1><span class="hl">{{ section.settings.heading }}</span>,</h1>
      <div class="pname">{{ section.settings.product_name }}</div>
      <p class="promise">{{ section.settings.promise }}</p>
      <ul class="ksp">
        <li><span class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>{{ section.settings.ksp_1 }}</li>
        <li><span class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c4 5 7 9 7 13a7 7 0 11-14 0c0-4 3-8 7-13z"/></svg></span>{{ section.settings.ksp_2 }}</li>
        <li><span class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.6a5.5 5.5 0 00-9.3-4A5.5 5.5 0 002 8.5c0 6 9.5 11 9.5 11s9.3-5 9.3-10.9z"/></svg></span>{{ section.settings.ksp_3 }}</li>
        <li><span class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="14" height="10" rx="3"/><path d="M21 10v4"/></svg></span>{{ section.settings.ksp_4 }}</li>
      </ul>

      <div class="specrow">
        <div><b>{{ section.settings.spec_1_big }}</b><small>{{ section.settings.spec_1_small }}</small></div>
        <div><b>{{ section.settings.spec_2_big }}</b><small>{{ section.settings.spec_2_small }}</small></div>
        <div><b>{{ section.settings.spec_3_big }}</b><small>{{ section.settings.spec_3_small }}</small></div>
      </div>

      <div class="offer" id="offer" role="radiogroup" aria-label="Choose your set">
      {%- assign oi = 0 -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'offer' -%}
          {%- assign ov = nil -%}
          {%- for v in product.variants -%}
            {%- if v.title == b.settings.variant_title -%}
              {%- assign ov = v -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if ov == nil -%}
            {%- assign b_title_lower = b.settings.variant_title | downcase -%}
            {%- for v in product.variants -%}
              {%- assign v_title_lower = v.title | downcase -%}
              {%- if b_title_lower contains 'double' and v_title_lower contains 'double' -%}
                {%- assign ov = v -%}
                {%- break -%}
              {%- elsif b_title_lower contains 'single' and v_title_lower contains 'single' -%}
                {%- assign ov = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if ov == nil and product.variants.size > oi -%}
            {%- assign ov = product.variants[oi] -%}
          {%- endif -%}
          {%- if ov == nil -%}
            {%- assign ov = product.variants.first -%}
          {%- endif -%}

          <div class="ocard{% if oi == 0 %} sel{% endif %}" role="radio" aria-checked="{% if oi == 0 %}true{% else %}false{% endif %}" tabindex="0" data-name="{{ b.settings.name | escape }}" data-price="{{ ov.price | money_without_trailing_zeros }}" data-variant-id="{{ ov.id }}" data-available="{{ ov.available }}" onclick="pickO(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();pickO(this)}" {{ b.shopify_attributes }}>
            {%- if b.settings.flag != blank -%}
              <span class="flag">
                <svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg>
                <span>{{ b.settings.flag | replace: ' ', '<br>' }}</span>
              </span>
            {%- endif -%}
            <div class="ohead">
              <span class="oradio"></span>
              {%- assign offer_image = b.settings.image | default: ov.featured_image | default: product.featured_image -%}
              {%- if offer_image != blank -%}<img class="oimg" width="76" height="76" loading="eager" src="{{ offer_image | image_url: width: 200 }}" alt="{{ b.settings.name | escape }}">{%- endif -%}
              <div class="otitle"><span class="oname">{{ b.settings.name }}</span><span class="obadge">{{ b.settings.badge }}</span></div>
              <div class="oprice"><span class="onow">{{ ov.price | money_without_trailing_zeros }}</span><span class="owas">{{ b.settings.was_price }}</span></div>
            </div>
            {%- assign ww_card_name = b.settings.name | default: ov.title | downcase -%}
            {%- if ww_card_name contains 'double' -%}
              {%- assign ww_card_type = 'double' -%}
            {%- elsif ww_card_name contains 'single' -%}
              {%- assign ww_card_type = 'single' -%}
            {%- else -%}
              {%- assign ww_card_type = 'both' -%}
            {%- endif -%}
            <ul class="ogifts">
            {%- comment -%} FIRST CHOICE: the "Free gift" blocks added in the theme editor (Customize > click a Free gift block > pick the product and whether it shows on the Double card, the Single card or both). Every matching block becomes one row, in the order the blocks are listed. If no block matches this card, the older sources below are used instead. {%- endcomment -%}
            {%- capture ww_block_html -%}
              {%- for bb in section.blocks -%}
                {%- if bb.type == 'bundle_gift' -%}
                  {%- assign g_show = bb.settings.applies_to | default: 'both' | downcase | strip -%}
                  {%- if g_show == 'both' or g_show == ww_card_type or ww_card_type == 'both' -%}
                    {%- assign bgp = bb.settings.product -%}
                    {%- assign g_title = bb.settings.label | default: '' | strip -%}
                    {%- if g_title == blank and bgp != blank -%}
                      {%- assign g_title = '+ FREE ' | append: bgp.title -%}
                    {%- endif -%}
                    {%- if g_title != blank -%}
                      {%- assign g_note = bb.settings.note | default: '' | strip -%}
                      {%- assign g_label = bb.settings.value | default: '' | strip -%}
                      {%- if g_label == blank -%}
                        {%- if bgp != blank and bgp.price > 0 -%}
                          {%- assign g_label = bgp.price | money_without_trailing_zeros -%}
                        {%- else -%}
                          {%- assign g_label = 'FREE' -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- assign g_label_up = g_label | upcase -%}
                      {%- assign g_img = bb.settings.image -%}
                      {%- assign g_icon = bb.settings.icon | default: '' | strip | downcase -%}
                      {%- assign g_asset = 'ww-gift-delivery.png' -%}
                      {%- assign g_pad = false -%}
                      {%- case g_icon -%}
                        {%- when 'sizing' -%}{%- assign g_asset = 'ww-gift-sizing.jpg' -%}
                        {%- when 'bags' -%}{%- assign g_asset = 'ww-gift-bags.webp' -%}
                        {%- when 'warmer' -%}{%- assign g_asset = 'ww-gift-warmer.jpg' -%}
                        {%- when 'pillow' -%}{%- assign g_asset = 'ww-gift-pillow.jpg' -%}
                        {%- when 'delivery' -%}{%- assign g_asset = 'ww-gift-delivery.png' -%}{%- assign g_pad = true -%}
                      {%- endcase -%}
                      {%- if g_img != blank -%}
                        {%- assign g_src = g_img | image_url: width: 160 -%}
                      {%- elsif g_icon != blank -%}
                        {%- assign g_src = g_asset | asset_url -%}
                      {%- elsif bgp != blank and bgp.featured_image != blank -%}
                        {%- assign g_src = bgp.featured_image | image_url: width: 160 -%}
                      {%- else -%}
                        {%- assign g_src = g_asset | asset_url -%}
                        {%- assign g_pad = true -%}
                      {%- endif -%}
                      <li>
                        <span class="oc{% if g_pad %} pad{% endif %}"><img src="{{ g_src }}" alt="{{ g_title | escape }}" loading="lazy"></span>
                        <span class="ot">{{ g_title }}{%- if g_note != blank -%}<small>{{ g_note }}</small>{%- endif -%}</span>
                        {%- if g_label_up == 'FREE' -%}<span class="ov free">FREE</span>{%- else -%}<s class="ov">{{ g_label }}</s>{%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if ww_block_html contains '<li' -%}
            {{- ww_block_html -}}
            {%- else -%}
            {%- comment -%} Pick the row source for this card: the product's own "Free gifts" selection first (when it has rows applying to this card), then the shared Free gift list, then the legacy textarea below. Rows are ordered by the Position field (blank = last); each becomes a "0000:entry-handle" key so a plain string sort is enough. {%- endcomment -%}
            {%- assign ww_entries = nil -%}
            {%- assign ww_keystr = '' -%}
            {%- if ww_prod_count > 0 -%}
              {%- for ge in ww_prod_entries -%}
                {%- assign g_show = ge.applies_to.value | default: 'both' | downcase | strip -%}
                {%- if g_show contains 'double' -%}
                  {%- assign g_show = 'double' -%}
                {%- elsif g_show contains 'single' -%}
                  {%- assign g_show = 'single' -%}
                {%- else -%}
                  {%- assign g_show = 'both' -%}
                {%- endif -%}
                {%- if g_show == 'both' or g_show == ww_card_type or ww_card_type == 'both' -%}
                  {%- assign g_title = ge.title.value | default: ge.name.value | default: ge.label.value | default: '' | strip -%}
                  {%- if g_title != blank -%}
                    {%- assign gpos = ge.position.value | default: 0 | plus: 0 -%}
                    {%- if gpos > 0 -%}
                      {%- if gpos > 8999 -%}{%- assign gpos = 9999 -%}{%- endif -%}
                      {%- assign gpad = gpos | plus: 10000 | append: '' | slice: 1, 4 -%}
                    {%- else -%}
                      {%- assign gpad = '9999' -%}
                    {%- endif -%}
                    {%- assign ww_keystr = ww_keystr | append: gpad | append: ':' | append: ge.system.handle | append: '|' -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if ww_keystr contains ':' -%}
                {%- assign ww_entries = ww_prod_entries -%}
              {%- else -%}
                {%- assign ww_keystr = '' -%}
              {%- endif -%}
            {%- endif -%}
            {%- if ww_entries == nil and ww_gift_count > 0 -%}
              {%- for ge in ww_gift_entries -%}
                {%- assign g_show = ge.applies_to.value | default: 'both' | downcase | strip -%}
                {%- if g_show contains 'double' -%}
                  {%- assign g_show = 'double' -%}
                {%- elsif g_show contains 'single' -%}
                  {%- assign g_show = 'single' -%}
                {%- else -%}
                  {%- assign g_show = 'both' -%}
                {%- endif -%}
                {%- if g_show == 'both' or g_show == ww_card_type or ww_card_type == 'both' -%}
                  {%- assign g_title = ge.title.value | default: ge.name.value | default: ge.label.value | default: '' | strip -%}
                  {%- if g_title != blank -%}
                    {%- assign gpos = ge.position.value | default: 0 | plus: 0 -%}
                    {%- if gpos > 0 -%}
                      {%- if gpos > 8999 -%}{%- assign gpos = 9999 -%}{%- endif -%}
                      {%- assign gpad = gpos | plus: 10000 | append: '' | slice: 1, 4 -%}
                    {%- else -%}
                      {%- assign gpad = '9999' -%}
                    {%- endif -%}
                    {%- assign ww_keystr = ww_keystr | append: gpad | append: ':' | append: ge.system.handle | append: '|' -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if ww_keystr contains ':' -%}
                {%- assign ww_entries = ww_gift_entries -%}
              {%- else -%}
                {%- assign ww_keystr = '' -%}
              {%- endif -%}
            {%- endif -%}
            {%- if ww_entries -%}
              {%- assign ww_keys = ww_keystr | split: '|' | sort -%}
              {%- for key in ww_keys -%}
                {%- assign ww_kh = key | split: ':' | last -%}
                {%- for ge in ww_entries -%}
                {%- if ge.system.handle == ww_kh -%}
                {%- assign g_show = ge.applies_to.value | default: 'both' | downcase | strip -%}
                {%- if g_show contains 'double' -%}
                  {%- assign g_show = 'double' -%}
                {%- elsif g_show contains 'single' -%}
                  {%- assign g_show = 'single' -%}
                {%- else -%}
                  {%- assign g_show = 'both' -%}
                {%- endif -%}
                {%- if g_show == 'both' or g_show == ww_card_type or ww_card_type == 'both' -%}
                  {%- assign g_title = ge.title.value | default: ge.name.value | default: ge.label.value | default: '' | strip -%}
                  {%- if g_title != blank -%}
                    {%- assign g_note = ge.note.value | default: '' | strip -%}
                    {%- assign g_label = ge.value_label.value | default: 'FREE' | strip -%}
                    {%- assign g_label_up = g_label | upcase -%}
                    {%- assign g_photo = ge.photo.value -%}
                    {%- assign g_img = g_photo.preview_image | default: g_photo -%}
                    {%- assign g_icon = ge.icon.value | default: 'delivery' | strip | downcase -%}
                    {%- case g_icon -%}
                      {%- when 'sizing' -%}{%- assign g_asset = 'ww-gift-sizing.jpg' -%}
                      {%- when 'bags' -%}{%- assign g_asset = 'ww-gift-bags.webp' -%}
                      {%- when 'warmer' -%}{%- assign g_asset = 'ww-gift-warmer.jpg' -%}
                      {%- when 'pillow' -%}{%- assign g_asset = 'ww-gift-pillow.jpg' -%}
                      {%- else -%}{%- assign g_asset = 'ww-gift-delivery.png' -%}
                    {%- endcase -%}
                    <li>
                      <span class="oc{% if g_icon == 'delivery' %} pad{% endif %}">{%- if g_img != blank -%}<img src="{{ g_img | image_url: width: 160 }}" alt="{{ g_title | escape }}" loading="lazy">{%- else -%}<img src="{{ g_asset | asset_url }}" alt="">{%- endif -%}</span>
                      <span class="ot">{{ g_title }}{%- if g_note != blank -%}<small>{{ g_note }}</small>{%- endif -%}</span>
                      {%- if g_label_up == 'FREE' -%}<span class="ov free">FREE</span>{%- else -%}<s class="ov">{{ g_label }}</s>{%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endif -%}
                {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- else -%}
            {%- comment -%} Last resort: the card's own gift list when it is still stored, otherwise a built-in list so a card is never empty. {%- endcomment -%}
            {%- if b.settings.gifts != blank -%}
              {%- assign ww_giftraw = b.settings.gifts -%}
            {%- elsif ww_card_type == 'single' -%}
              {%- capture ww_giftraw -%}sizing|+ FREE Sizing Kit|4 sizes + a tool to find your fit|FREE
bags|+ FREE Storage Bags (50 pcs)||$12
pillow|+ FREE Breastfeeding Pillow||$14
delivery|+ FREE Delivery||FREE{%- endcapture -%}
            {%- else -%}
              {%- capture ww_giftraw -%}sizing|+ FREE Sizing Kit|4 sizes + a tool to find your fit|FREE
bags|+ FREE Storage Bags (50 pcs)||$12
warmer|+ FREE Fast Bottle Warmer||$40
delivery|+ FREE Delivery||FREE{%- endcapture -%}
            {%- endif -%}
            {%- assign glines = ww_giftraw | newline_to_br | split: '<br />' -%}
            {%- for gl in glines -%}
              {%- assign gp = gl | strip | split: '|' -%}
              {%- if gp.size > 1 -%}
                {%- assign gk = gp[0] | strip | downcase -%}
                {%- case gk -%}
                  {%- when 'sizing' -%}{%- assign gimg = 'ww-gift-sizing.jpg' -%}
                  {%- when 'bags' -%}{%- assign gimg = 'ww-gift-bags.webp' -%}
                  {%- when 'warmer' -%}{%- assign gimg = 'ww-gift-warmer.jpg' -%}
                  {%- when 'pillow' -%}{%- assign gimg = 'ww-gift-pillow.jpg' -%}
                  {%- else -%}{%- assign gimg = 'ww-gift-delivery.png' -%}
                {%- endcase -%}
                {%- assign gv = gp[3] | strip -%}
                <li>
                  <span class="oc{% if gk == 'delivery' %} pad{% endif %}"><img src="{{ gimg | asset_url }}" alt=""></span>
                  <span class="ot">{{ gp[1] | strip }}{% if gp[2] != blank %}<small>{{ gp[2] | strip }}</small>{% endif %}</span>
                  {% if gv == 'FREE' %}<span class="ov free">FREE</span>{% else %}<s class="ov">{{ gv }}</s>{% endif %}
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- endif -%}
            {%- endif -%}
            </ul>
          </div>
          {%- assign oi = oi | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      </div>

      {%- comment -%} Real bundle gift items from theme blocks {%- endcomment -%}
      <div id="bundle-gift-data" hidden>
        {%- assign configured_bundle_gifts = 0 -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'bundle_gift' and b.settings.product != blank -%}
            {%- assign configured_bundle_gifts = configured_bundle_gifts | plus: 1 -%}
            {%- assign gp = b.settings.product -%}
            {%- assign gv = gp.selected_or_first_available_variant -%}
            {%- if gv != blank -%}
