  .variant .vprice{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right;flex:0 0 auto}
  .variant .vprice .vline{display:flex;align-items:baseline;gap:7px}
  .variant .vprice .vnow{font-family:var(--fd);font-size:1.7rem;line-height:1;font-weight:800!important}
  .variant .vt{font-family:var(--fd);font-weight:800;color:var(--navy);font-size:1.06rem}
