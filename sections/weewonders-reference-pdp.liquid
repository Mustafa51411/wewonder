  .scallop svg{position:absolute;inset:0;width:100%;height:100%}
  .scallop .txt{position:relative;z-index:2;text-align:center;font-family:var(--fd);color:#fff;font-weight:700;line-height:1.15;padding:0 14px}
  .scallop .txt b{display:block;font-size:1.5rem;color:var(--sky);line-height:1}
  .scallop .txt small{display:block;font-size:.56rem;letter-spacing:.03em;text-transform:uppercase;margin-top:2px}
  .stamp{position:absolute;z-index:2;transform:rotate(-8deg)}
  .stamp.s1{left:-20px;bottom:6%}
  .g-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-top:11px}
  .g-thumbs button{padding:0;border:2px solid var(--line);border-radius:11px;overflow:hidden;background:#f2f5f7;cursor:pointer;aspect-ratio:1/1}
  .g-thumbs button.active{border-color:var(--navy)}.g-thumbs img{width:100%;height:100%;object-fit:cover}
  .buy .rate{display:flex;align-items:center;gap:9px;font-weight:700;color:var(--navy);font-size:.94rem;flex-wrap:wrap}
  .buy .rate .en{color:var(--muted);font-weight:600;font-size:.85rem;border-left:1px solid var(--line);padding-left:9px}
  .buy .plabel{font-weight:800;color:var(--muted);font-size:.85rem;margin:12px 0 2px}
  .buy h1{font-size:clamp(1.65rem,3vw,2.25rem);font-weight:800}
  .h1-light{font-weight:500;letter-spacing:0}
  .buy .promise{font-size:1.06rem;color:var(--muted);margin-top:8px;max-width:44ch}
  .ksp{list-style:none;margin:18px 0 20px;display:flex;flex-direction:column;gap:12px}
  .ksp li{display:flex;gap:11px;align-items:center;font-weight:700;color:var(--navy);font-size:1rem}
  .ksp li .ic{flex:0 0 30px;width:30px;height:30px;display:grid;place-items:center;color:var(--blue)}
  .specrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 0;margin-bottom:20px}
  .specrow b{font-family:var(--fd);color:var(--navy);display:block;font-size:1.04rem;line-height:1.1}.specrow small{color:var(--muted);font-size:.79rem}

  .variants{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:14px}
  .variant{border:2px solid var(--line);border-radius:18px;padding:15px 17px;cursor:pointer;position:relative;transition:border-color .15s,background .15s,box-shadow .15s,transform .15s;
    background:linear-gradient(160deg,#fff 0%,var(--mist) 120%);display:flex;flex-wrap:wrap;gap:14px;align-items:center;box-shadow:0 10px 24px -20px rgba(26,43,60,.35)}
