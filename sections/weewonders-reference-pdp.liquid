{% comment %}
  Look up each variant's own image (set on the Product page > Variants),
  so the "Double Pump Set" and "Single Pump" cards always show whatever
  photo is assigned to that variant in Shopify admin.
{% endcomment %}
{% assign double_pump_image = blank %}
{% assign single_pump_image = blank %}
{% assign double_pump_variant = blank %}
{% assign single_pump_variant = blank %}
{% for variant in product.variants %}
  {% assign variant_title_lower = variant.title | downcase %}
  {% if variant_title_lower contains 'double' %}
    {% assign double_pump_image = variant.featured_image %}
    {% assign double_pump_variant = variant %}
  {% elsif variant_title_lower contains 'single' %}
    {% assign single_pump_image = variant.featured_image %}
    {% assign single_pump_variant = variant %}
  {% endif %}
{% endfor %}
{% comment %}
  Fallback: if neither variant title contains "double"/"single" (e.g. renamed
  or translated), fall back to the product's first two variants by position
  so pricing/cart still work — the photo will use the placeholder fallback,
  and the Theme Customizer section settings should be checked in that case.
{% endcomment %}
{% if double_pump_variant == blank and product.variants.size > 0 %}
  {% assign double_pump_variant = product.variants[0] %}
{% endif %}
{% if single_pump_variant == blank and product.variants.size > 1 %}
  {% assign single_pump_variant = product.variants[1] %}
{% endif %}

<style>
@scope (#ww-reference) {
  :scope{
    --mist:#F4F6F7; --navy:#1A2B3C; --ink:#22323F; --muted:#5C6B77;
    --blue:#3FA9DE; --sky:#8FD9F5; --sky-soft:#EAF6FC; --sky-soft2:#F5FBFD;
    --white:#fff; --line:#E3EEF4;
    --good:#2E9E66; --bad:#D6493F; --star:var(--blue);
    --fd:var(--font-heading-family,system-ui,sans-serif); --fb:var(--font-body-family,system-ui,sans-serif);
    --wrap:1200px; --shadow:0 18px 50px -22px rgba(26,43,60,.28);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  :scope{font-family:var(--fb);color:var(--ink);background:var(--white);line-height:1.5;font-size:16.5px;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  h1,h2,h3,.dsp{font-family:var(--fd);color:var(--navy);line-height:1.08;font-weight:700;letter-spacing:-.01em}
  h2{font-size:clamp(1.6rem,3.3vw,2.5rem)}h3{font-size:1.15rem}
  p{max-width:60ch}img{max-width:100%;display:block}a{color:var(--blue);text-decoration:none}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 20px}
  .section{padding:64px 0;position:relative;border-top:1px solid var(--line)}.section:first-of-type{border-top:0}.center{text-align:center}.center p{margin-inline:auto}
  .eyebrow{font-family:var(--fb);font-weight:800;color:var(--blue);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:9px}
  .lead{font-size:1.04rem;color:var(--muted)}
  .stars{color:var(--star);letter-spacing:1px}
  .hl{background:linear-gradient(180deg,rgba(143,217,245,0) 56%, rgba(143,217,245,.65) 56%);padding:0 .1em;border-radius:2px}
  .hl-sky{background:linear-gradient(180deg,rgba(143,217,245,0) 56%, rgba(255,255,255,.28) 56%);padding:0 .1em;border-radius:2px}
  .hl-navy{color:var(--navy);font-weight:800}
  .giant-hl{display:inline-block;font-size:1.5em;line-height:1;background:linear-gradient(180deg,rgba(143,217,245,0) 58%, rgba(143,217,245,.7) 58%);padding:0 .08em}
  .wave-div{display:block;width:100%;height:44px;margin-bottom:-2px;position:relative;z-index:2}

  .ph{background:#eef5f8;border:1.5px dashed #c8dae2;border-radius:16px;display:grid;place-items:center;color:#8ba3ae;font-weight:700;font-size:.78rem;text-align:center;gap:4px;padding:12px;min-height:120px}
  .ph::before{content:"🖼";font-size:1.35rem}
  .ph.video::before{content:"▶";font-size:1.5rem;color:#8ba3ae}
  .ph.av{min-height:0;width:52px;height:52px;border-radius:50%;flex:0 0 52px;padding:0;font-size:0}
  .ph.av::before{font-size:1.1rem}
  .ph.sq{aspect-ratio:1/1}.ph.wide{aspect-ratio:16/9}.ph.shot{aspect-ratio:9/16}.ph.tall{aspect-ratio:4/5}

  .btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:700;font-size:1.02rem;padding:17px 28px;border-radius:14px;border:0;cursor:pointer;transition:transform .12s,background .2s;letter-spacing:.02em}
  .btn-cta{background:var(--navy);color:#fff;box-shadow:0 14px 28px -14px rgba(26,43,60,.55)}
  .btn-cta:hover{background:#0F1C28;transform:translateY(-2px)}
  .btn-lg{padding:19px 34px;font-size:1.08rem;width:100%}
  .btn:focus-visible{outline:3px solid var(--sky);outline-offset:3px}

  .topbar{background:var(--navy);color:#dfeaf3;font-size:.84rem;font-weight:600;text-align:center;padding:9px 14px}
  .topbar span{opacity:.5;margin:0 9px}
  .head{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .head .wrap{display:flex;align-items:center;justify-content:space-between;padding:12px 20px}
  .head img{height:28px;width:auto}.head nav{display:flex;gap:24px;font-weight:600;font-size:.92rem}.head nav a{color:var(--ink)}
  .head .rate{display:flex;align-items:center;gap:6px;font-weight:700;color:var(--navy)}

  /* ATF */
  .pdp{padding:32px 0 14px}
  .pdp .wrap{display:grid;grid-template-columns:1.15fr 1fr;gap:44px;align-items:start}
  .gallery{position:sticky;top:76px}
  .g-main{border-radius:22px;overflow:visible;background:#f2f7f9;border:1px solid var(--line);position:relative;aspect-ratio:1/1}
  .g-main img{width:100%;height:100%;object-fit:cover;border-radius:22px}
  .g-main::before{content:"";position:absolute;top:-8%;left:-8%;right:-8%;bottom:-8%;z-index:-1;
    background:radial-gradient(circle, rgba(143,217,245,.5) 0%, rgba(143,217,245,.14) 45%, rgba(143,217,245,0) 70%);border-radius:50%}
  .g-nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.9);border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;font-size:1.1rem;color:var(--navy)}
  .g-prev{left:12px}.g-next{right:12px}
  /* signature branding element: the scallop badge — reused across the page */
  .scallop{position:relative;width:112px;height:112px;display:grid;place-items:center;filter:drop-shadow(0 10px 20px rgba(26,43,60,.35))}
  .scallop svg{position:absolute;inset:0;width:100%;height:100%}
  .scallop .txt{position:relative;z-index:2;text-align:center;font-family:var(--fd);color:#fff;font-weight:700;line-height:1.15;padding:0 14px}
  .scallop .txt b{display:block;font-size:1.5rem;color:var(--sky);line-height:1}
  .scallop .txt small{display:block;font-size:.56rem;letter-spacing:.03em;text-transform:uppercase;margin-top:2px}
  .stamp{position:absolute;z-index:2;transform:rotate(-8deg)}
  .stamp.s1{left:-20px;bottom:6%}
  .g-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-top:11px}
  .g-thumbs button{padding:0;border:2px solid var(--line);border-radius:11px;overflow:hidden;background:#f2f5f7;cursor:pointer;aspect-ratio:1/1}
  .g-thumbs button.active{border-color:var(--navy)}.g-thumbs img{width:100%;height:100%;object-fit:cover}
  .buy .rate{display:flex;align-items:center;gap:9px;font-weight:700;color:var(--navy);font-size:.94rem;flex-wrap:wrap}
  .buy .rate .en{color:var(--muted);font-weight:600;font-size:.85rem;border-left:1px solid var(--line);padding-left:9px}
  .buy .plabel{font-weight:800;color:var(--muted);font-size:.85rem;margin:12px 0 2px}
  .buy h1{font-size:clamp(1.65rem,3vw,2.25rem);font-weight:800}
  .h1-light{font-weight:500;letter-spacing:0}
  .buy .promise{font-size:1.06rem;color:var(--muted);margin-top:8px;max-width:44ch}
  .ksp{list-style:none;margin:18px 0 20px;display:flex;flex-direction:column;gap:12px}
  .ksp li{display:flex;gap:11px;align-items:center;font-weight:700;color:var(--navy);font-size:1rem}
  .ksp li .ic{flex:0 0 30px;width:30px;height:30px;display:grid;place-items:center;color:var(--blue)}
  .specrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 0;margin-bottom:20px}
  .specrow b{font-family:var(--fd);color:var(--navy);display:block;font-size:1.04rem;line-height:1.1}.specrow small{color:var(--muted);font-size:.79rem}

  .variants{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:14px}
  .variant{border:2px solid var(--line);border-radius:18px;padding:15px 17px;cursor:pointer;position:relative;transition:border-color .15s,background .15s,box-shadow .15s,transform .15s;
    background:linear-gradient(160deg,#fff 0%,var(--mist) 120%);display:flex;gap:14px;align-items:center;box-shadow:0 10px 24px -20px rgba(26,43,60,.35)}
  .variant:hover{border-color:var(--navy);transform:translateY(-1px)}
  .variant.sel{border-color:var(--navy);background:#fff;position:relative;
    box-shadow:7px 7px 0 0 var(--sky),14px 14px 0 0 var(--navy),0 20px 34px -10px rgba(26,43,60,.4)}
  .variant .vimg{width:74px;height:74px;object-fit:contain;flex:0 0 74px}
  .variant .vbody{flex:1;min-width:0}
  .variant .vprice{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right;flex:0 0 auto}
  .variant .vprice .vline{display:flex;align-items:baseline;gap:7px}
  .variant .vprice .vnow{font-size:1.22rem}
  .variant .vt{font-family:var(--fd);font-weight:700;color:var(--navy);font-size:1.06rem}
  .variant .vnow{font-weight:800;color:var(--ink);background:linear-gradient(180deg,rgba(143,217,245,0) 55%, rgba(143,217,245,.55) 55%);padding:0 .06em}
  .variant .vwas{color:var(--bad);font-weight:700;text-decoration:line-through;font-size:.92rem}
  .variant .voff{color:var(--good);font-weight:800;font-size:.78rem}
  .variant .perks{display:flex;flex-direction:column;gap:4px;align-items:flex-end}
  .variant .pk{font-size:.82rem;font-weight:700;display:flex;gap:6px;align-items:center;color:var(--good)}
  .variant .pk::before{content:"✓";font-weight:800}
  .variant .flag{position:absolute;top:-22px;right:-20px;width:52px;height:52px;display:grid;place-items:center;z-index:3;filter:drop-shadow(0 6px 12px rgba(26,43,60,.35))}
  .variant .flag svg{position:absolute;inset:0;width:100%;height:100%}
  .variant .flag span{position:relative;color:#fff;font-family:var(--fd);font-weight:700;font-size:.52rem;line-height:1.05;text-align:center;text-transform:uppercase}
  .gift-note{background:#fff;border:1.4px dashed var(--navy);border-radius:12px;padding:10px 13px;font-size:.85rem;color:var(--navy);font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}

  .guarbox{margin-top:14px;border:1.6px solid var(--navy);border-radius:16px;padding:14px 16px;display:flex;gap:13px;align-items:center;background:#fff}
  .guarbox .gi{flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center}
  .guarbox b{font-family:var(--fd);color:var(--navy);display:block;font-size:.98rem}
  .guarbox small{color:var(--muted);font-size:.82rem}

  .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
  .trust .t{text-align:center;font-size:.75rem;color:var(--muted);font-weight:700}
  .trust .t .i{width:32px;height:32px;margin:0 auto 5px;border-radius:9px;background:var(--mist);display:grid;place-items:center;color:var(--navy)}

  /* wave divider */
  .wave{display:block;width:100%;height:64px;margin-bottom:-2px}

  /* testimonials */
  .wall{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:30px}
  .wa{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 12px 30px -24px rgba(26,43,60,.4)}
  .wa .top{display:flex;gap:10px;align-items:center;margin-bottom:10px}
  .wa .top b{color:var(--navy);font-size:.9rem}.wa .top .stars{font-size:.78rem;display:block}
  .wa .tag{font-size:.72rem;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.04em;margin-bottom:7px}
  .wa p{font-size:.95rem;color:var(--ink)}
  .shots{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px;border-top:1px solid var(--line);padding-top:28px}
  .stat{text-align:center}
  .stat b{font-family:var(--fd);font-size:2.1rem;color:var(--navy);display:block}
  .stat span{font-weight:800;color:var(--blue);display:inline-block;margin-top:6px;font-size:.86rem;text-transform:uppercase;letter-spacing:.04em;border-bottom:3px solid var(--sky);padding-bottom:2px}
  .stat small{display:block;color:var(--muted);font-size:.74rem;margin-top:6px}

  /* PATTERN-INTERRUPT: big claim section */
  .claim{background:var(--navy);color:#fff;padding:88px 0 0;text-align:center;overflow:visible;position:relative;border-top:0}
  .claim .wrap{padding-bottom:44px}
  .claim .eyebrow{color:var(--sky)}
  .claim .lede{font-family:var(--fb);font-weight:700;font-size:1.15rem;color:#cfe6f2;max-width:36ch;margin:0 auto 6px}
  .claim .big{font-family:var(--fd);font-weight:700;text-transform:capitalize;font-size:clamp(2.6rem,9vw,6rem);line-height:.95;letter-spacing:-.01em;
    color:var(--sky);display:block;margin:8px 0;white-space:nowrap}
  .claim .conclusion{font-family:var(--fd);font-weight:700;font-size:clamp(1.6rem,3.4vw,2.3rem);margin:40px 0 44px;color:#fff;line-height:1.25}
  .fm-headline{font-family:var(--fd);font-weight:800;font-size:clamp(1.9rem,4.4vw,3.1rem);text-align:center;margin-top:10px;color:#fff;line-height:1.2}
  .fm-headline .eq{color:rgba(255,255,255,.45);margin:0 .12em;font-weight:600}
  .hl-solid{color:var(--navy);background:var(--sky);border-radius:.15em;padding:.02em .12em}
  .scenario-split{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:52px;max-width:900px;margin-inline:auto}
  .scenario{position:relative;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:18px;padding:20px;text-align:center}
  .sc-img{width:100%;height:84px;border-radius:14px;background:rgba(255,255,255,.07);border:1.5px dashed rgba(255,255,255,.32);display:grid;place-items:center;color:rgba(255,255,255,.5);font-family:var(--fb);font-size:.72rem;line-height:1.2;margin-bottom:16px;text-align:center;padding:4px}
  .sc-badge{position:absolute;top:-16px;font-size:30px;filter:drop-shadow(0 5px 10px rgba(0,0,0,.4));z-index:2}
  .scenario.neg .sc-badge{left:-10px;transform:rotate(-16deg)}
  .scenario.pos .sc-badge{right:-10px;transform:rotate(16deg)}
  .sc-chain{display:flex;flex-direction:column;align-items:center;gap:6px}
  .sc-step{font-family:var(--fb);font-weight:700;color:#fff;font-size:.96rem}
  .sc-arrow{color:rgba(255,255,255,.4);font-size:1.1rem;line-height:1}
  .sc-result{font-family:var(--fd);font-weight:800;font-size:1.32rem;margin-top:4px}
  .sc-result.bad{color:#a9c1d3}
  .sc-result.good{color:var(--sky)}
  .refill{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:52px;max-width:720px;margin-inline:auto}
  .rc{text-align:left}
  .rc .lbl{font-family:var(--fd);font-weight:700;font-size:1.05rem;color:#fff}
  .rc-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  .drop-ico{display:inline-block;font-size:20px;transform-origin:center;transition:transform .05s linear;filter:drop-shadow(0 4px 8px rgba(0,0,0,.3))}
  .arrow-tag{font-family:var(--fb);font-weight:700;font-size:.78rem;display:block;margin-top:2px}
  .arrow-tag.low{color:#a9c1d3}
  .arrow-tag.high{color:var(--sky)}
  .rc .bar{height:22px;border-radius:999px;background:rgba(255,255,255,.14);overflow:hidden;position:relative;border:1px solid rgba(255,255,255,.25)}
  .rc .fill{height:100%;background:var(--blue);border-radius:999px}
  .rc.half .fill{width:42%}
  .rc.full .fill{width:100%}
  .rc p{font-size:.86rem;color:#a9c1d3;margin-top:9px;max-width:none}

  /* journey / milk timeline */
  .tl{background:var(--sky-soft);color:var(--ink);position:relative;padding-bottom:0}
  .tl h2,.tl h3{color:var(--navy)}.tl .lead{color:var(--muted)}
  .tl-sub{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:16px;font-family:var(--fb);font-weight:600;color:var(--muted);font-size:1.05rem}
  .tl-logotext{font-family:var(--fd);font-weight:800;font-size:1.6rem;letter-spacing:-.01em;color:var(--navy);
    background:linear-gradient(180deg,rgba(143,217,245,0) 52%, rgba(143,217,245,.85) 52%);padding:2px 8px 0}
  .milk-track{position:relative;margin-top:60px;padding-top:8px}
  .milk-line{position:absolute;top:37px;left:4%;right:4%;height:6px;border-radius:999px;background:rgba(26,43,60,.14);pointer-events:none}
  .milk-line .fill{position:absolute;left:0;top:0;height:100%;width:0%;border-radius:999px;background:linear-gradient(90deg,var(--blue),var(--navy));transition:width .05s linear}
  .milk-drag{position:absolute;top:22px;left:4%;width:92%;height:36px;margin:0;-webkit-appearance:none;appearance:none;background:transparent;cursor:grab;z-index:5}
  .milk-drag:active{cursor:grabbing}
  .milk-drag::-webkit-slider-runnable-track{height:36px;background:transparent}
  .milk-drag::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:transparent;border:0;margin-top:5px;cursor:grab}
  .milk-drag::-moz-range-thumb{width:26px;height:26px;border-radius:50%;background:transparent;border:0;cursor:grab}
  .milk-drag::-moz-range-track{height:36px;background:transparent}
  .milk-cursor{position:absolute;top:25px;width:30px;height:30px;left:4%;border-radius:50%;
    background:radial-gradient(circle at 32% 28%,#fff 0%,var(--sky-soft) 60%,var(--sky) 100%);
    border:2.5px solid #fff;display:flex;align-items:center;justify-content:center;transform:translateX(-50%);
    box-shadow:0 10px 22px -8px rgba(26,43,60,.45),0 0 0 3px rgba(63,169,222,.3);
    pointer-events:none;z-index:6;transition:left .04s linear,width .1s ease-out,height .1s ease-out,top .1s ease-out}
  .milk-cursor span{display:block;line-height:1;font-size:15px;transition:font-size .1s ease-out}
  .drag-hint{position:absolute;top:-30px;left:50%;transform:translateX(-50%);font-size:.74rem;font-weight:700;color:var(--blue);display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.04em}
  .jsteps{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
  .js{text-align:center;transition:opacity .3s}
  .js .drops{height:34px;display:flex;align-items:flex-end;justify-content:center;gap:3px;margin-bottom:6px}
  .js .drops svg{width:11px;opacity:.2;transition:opacity .3s}
  .js.active .drops svg{opacity:1}
  .js .station{width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid rgba(26,43,60,.22);margin:0 auto 12px;position:relative;z-index:2;transition:background .3s,border-color .3s,box-shadow .3s}
  .js.active .station{background:var(--navy);border-color:var(--navy);box-shadow:0 0 0 5px rgba(63,169,222,.28)}
  .js .lab{font-family:var(--fd);color:rgba(26,43,60,.4);font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.04em;transition:color .3s}
  .js.active .lab{color:var(--blue)}
  .js h3{font-size:.98rem;margin:6px 0 6px;color:rgba(26,43,60,.35);transition:color .3s}
  .js.active h3{color:var(--navy)}
  .js p{font-size:.85rem;color:rgba(26,43,60,.28);margin-inline:auto;transition:color .3s}
  .js.active p{color:var(--muted)}
  .tl .disc{margin-top:34px;font-size:.8rem;color:var(--muted);text-align:center}
  @media(max-width:980px){
    .milk-drag{display:none}
    .milk-cursor{display:none}
    .milk-line{display:none}
    .drag-hint{display:none}
    .jsteps{grid-template-columns:1fr;gap:30px;padding-left:26px}
    .jsteps::before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:3px;border-radius:999px;background:rgba(26,43,60,.14)}
    .js{text-align:left;display:flex;align-items:flex-start;gap:16px;position:relative;left:-26px;padding-left:26px}
    .js .station{margin:4px 0 0;flex:0 0 16px}
    .js .js-body{flex:1;min-width:0}
    .js .drops{justify-content:flex-start;margin-bottom:4px}
    .js p{margin-inline:0;max-width:32ch}
  }

  /* moms / worries */
  .moms{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
