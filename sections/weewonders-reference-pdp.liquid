<script>
  var slides=[{% if product.images.size > 0 %}{% for image in product.images %}'{{ image | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}{% else %}'{{ 'ww-reference-hero.jpg' | asset_url }}','{{ 'ww-reference-gallery-2.jpg' | asset_url }}','{{ 'ww-reference-gallery-3.jpg' | asset_url }}','{{ 'ww-reference-gallery-4.jpg' | asset_url }}','{{ 'ww-reference-gallery-5.jpg' | asset_url }}','{{ 'ww-reference-gallery-6.jpg' | asset_url }}'{% endif %}];
  var gi=0, main=document.getElementById('mainimg'), thumbs=document.querySelectorAll('#thumbs button');
  function galSet(i){gi=(i+slides.length)%slides.length;main.src=slides[gi];thumbs.forEach(function(b,k){b.classList.toggle('active',k===gi);});}
  function galStep(d){galSet(gi+d);}
  function pick(radioEl){
    if(!radioEl) return;
    var el = radioEl.closest('.variant');
    if(!el) return;
    radioEl.checked = true;
    document.querySelectorAll('#variants .variant').forEach(function(v){
      var selected = v === el;
      v.classList.toggle('sel', selected);
      v.setAttribute('aria-checked', selected ? 'true' : 'false');
    });
    el.classList.add('sel');
    document.querySelectorAll('.rep-grid .variant').forEach(function(v){
      var selected = String(v.dataset.variantId) === String(radioEl.value);
      v.classList.toggle('sel', selected);
      v.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    var barPrice=document.getElementById('barprice');
    var barName=document.getElementById('barname');
    if(barPrice && barPrice.childNodes.length){barPrice.childNodes[0].textContent=el.dataset.price;}
    if(barName){barName.textContent=el.dataset.name;}
    document.querySelectorAll('[data-whatsapp-order]').forEach(function(link){
      var message=(link.dataset.whatsappMessage || 'Hi WeeWonders, I would like to order')+': '+(link.dataset.productTitle || '')+' - '+el.dataset.name;
      link.href='https://api.whatsapp.com/send/?phone='+link.dataset.whatsappNumber+'&text='+encodeURIComponent(message)+'&type=phone_number&app_absent=0';
    });
  }
  function pickRep(el){
    if(!el) return;
    var mainVariant=document.querySelector('#variants .variant[data-variant-id="'+el.dataset.variantId+'"]');
    if(!mainVariant) return;
    var radio=mainVariant.querySelector('input[type="radio"]');
    if(radio){pick(radio);}
  }
  document.querySelectorAll('#variants .variant').forEach(function(card){
    card.addEventListener('click',function(){pick(card.querySelector('input[type="radio"]'));});
  });
  document.querySelectorAll('.rep-grid .variant').forEach(function(card){
    card.addEventListener('click',function(){pickRep(card);});
    card.addEventListener('keydown',function(event){
      if(event.key==='Enter' || event.key===' '){event.preventDefault();pickRep(card);}
    });
  });
  var purchaseForm=document.getElementById('pdp-form');
  if(purchaseForm){
    purchaseForm.addEventListener('submit',function(event){
      var selected=purchaseForm.querySelector('input[name="id"]:checked');
      var selectedCard=selected ? selected.closest('.variant') : null;
      var button=document.getElementById('atc');
      if(!selected || !selectedCard) return;
      var bundleType=selectedCard.dataset.bundleType;
      var giftElements=Array.prototype.slice.call(document.querySelectorAll('#bundle-gift-data [data-bundle-gift]')).filter(function(gift){
        return gift.dataset.appliesTo===bundleType || gift.dataset.appliesTo==='both';
      });
      if(!giftElements.length) return;
      event.preventDefault();
      var originalLabel=button ? button.textContent : '';
      if(button){button.disabled=true;button.textContent='Adding bundle...';}
      var items=[{
        id:Number(selected.value),
        quantity:1,
        properties:{'_WeeWonders bundle':selectedCard.dataset.name}
      }];
      giftElements.forEach(function(gift){
        items.push({
          id:Number(gift.dataset.variantId),
          quantity:1,
          properties:{
            '_WeeWonders free gift':'Yes',
            '_Bundle option':selectedCard.dataset.name,
            '_Bundle parent variant':selected.value
          }
        });
      });
      var root=(window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(root+'cart/add.js',{
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body:JSON.stringify({items:items})
      }).then(function(response){
        if(!response.ok){return response.json().then(function(error){throw new Error(error.description || 'The bundle could not be added.');});}
        return response.json();
      }).then(function(){
        window.location.href=root+'cart';
      }).catch(function(error){
        if(button){button.disabled=false;button.textContent=originalLabel;}
        window.alert(error.message || 'The bundle could not be added. Please try again.');
      });
    });
  }
  var bar=document.getElementById('buybar');
  window.addEventListener('scroll',function(){if(window.scrollY>640){bar.classList.add('show');}else{bar.classList.remove('show');}},{passive:true});

  // Doctor videos: show a branded play button, then hand over to native controls.
  (function(){
    var videoCards=Array.prototype.slice.call(document.querySelectorAll('.vid .video.has-video'));
    videoCards.forEach(function(card){
      var video=card.querySelector('video');
      var playButton=card.querySelector('.video-play');
      if(!video || !playButton) return;
      playButton.addEventListener('click',function(){
        videoCards.forEach(function(otherCard){
          var otherVideo=otherCard.querySelector('video');
          if(otherVideo && otherVideo!==video && !otherVideo.paused) otherVideo.pause();
        });
        video.controls=true;
        var playPromise=video.play();
        if(playPromise && typeof playPromise.catch==='function') playPromise.catch(function(){});
      });
      video.addEventListener('play',function(){card.classList.add('is-playing');});
      video.addEventListener('pause',function(){card.classList.remove('is-playing');});
      video.addEventListener('ended',function(){card.classList.remove('is-playing');video.controls=false;video.currentTime=0;});
    });
  })();

  // Social-proof images: compact thumbnails with a full, uncropped viewer.
  (function(){
    var lightbox=document.getElementById('proofLightbox');
    if(!lightbox) return;
    var fullImage=lightbox.querySelector('img');
    var closeButton=lightbox.querySelector('.proof-close');
    var previousOverflow='';
    function openProof(button){
      fullImage.src=button.dataset.proofSrc;
      fullImage.alt=button.dataset.proofAlt || 'Social proof screenshot';
      previousOverflow=document.documentElement.style.overflow;
      document.documentElement.style.overflow='hidden';
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden','false');
      closeButton.focus();
    }
    function closeProof(){
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden','true');
      fullImage.removeAttribute('src');
      document.documentElement.style.overflow=previousOverflow;
    }
    document.querySelectorAll('.proof-open').forEach(function(button){button.addEventListener('click',function(){openProof(button);});});
    closeButton.addEventListener('click',closeProof);
    lightbox.addEventListener('click',function(event){if(event.target===lightbox) closeProof();});
    document.addEventListener('keydown',function(event){if(event.key==='Escape'&&lightbox.classList.contains('open')) closeProof();});
  })();

  // milk timeline: drag-to-reveal on desktop, scroll-to-reveal on mobile
  (function(){
    var stations = Array.prototype.slice.call(document.querySelectorAll('#jsteps .js'));
    var n = stations.length;
    if(!n) return;
    var isDesktop = window.matchMedia('(min-width:981px)').matches;

    if(isDesktop){
      var drag = document.getElementById('milkDrag');
      var fill = document.getElementById('milkFill');
      var hint = document.querySelector('.drag-hint');
      var cursor = document.getElementById('milkCursor');
      var cursorSpan = cursor ? cursor.querySelector('span') : null;
      var stationEmoji = ['😌','🎵','📈','🍼','🌱'];
      function applyDrag(val){
        fill.style.width = val + '%';
        if(cursor){
          var size = 30 + (val/100)*24;
          cursor.style.left = 'calc(4% + ' + (val*0.92) + '%)';
          cursor.style.width = size + 'px';
          cursor.style.height = size + 'px';
          cursor.style.top = (40 - size/2) + 'px';
          if(cursorSpan) cursorSpan.style.fontSize = (size*0.5) + 'px';
        }
        var idx = -1;
        stations.forEach(function(el, i){
          var threshold = (i/(n-1))*100 - 2;
          var isActive = val >= threshold;
          el.classList.toggle('active', isActive);
          if(isActive) idx = i;
        });
        if(cursorSpan) cursorSpan.textContent = idx >= 0 ? stationEmoji[idx] : '💧';
      }
      if(drag){
        drag.addEventListener('input', function(){
          applyDrag(parseInt(drag.value,10));
          if(hint) hint.style.opacity = '0';
        });
      }
    } else {
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            if(entry.isIntersecting){ entry.target.classList.add('active'); }
          });
        }, {threshold:.4, rootMargin:'0px 0px -10% 0px'});
        stations.forEach(function(el){ io.observe(el); });
      } else {
        stations.forEach(function(el){ el.classList.add('active'); });
      }
    }
  })();

  // count-up numbers on scroll into view
  (function(){
    var els = document.querySelectorAll('.cu');
    if(!('IntersectionObserver' in window)){ els.forEach(function(e){e.textContent=e.dataset.target+'%';}); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        var el = entry.target, target = parseInt(el.dataset.target,10), start=null, dur=1100;
        function step(ts){
          if(!start) start=ts;
          var p = Math.min((ts-start)/dur,1);
          var eased = 1 - Math.pow(1-p,3);
          el.textContent = Math.round(eased*target) + '%';
          if(p<1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        io.unobserve(el);
      });
    },{threshold:.6});
    els.forEach(function(e){io.observe(e);});
  })();
    (function(){
      var refill = document.querySelector('.refill');
      if(!refill) return;
      var lo = refill.querySelector('.drop-ico.small');
      var hi = refill.querySelector('.drop-ico.big');
      var ticking = false;
      function update(){
        var r = refill.getBoundingClientRect();
        var vh = window.innerHeight;
        var start = vh;
        var end = vh * 0.3;
        var progress = (start - r.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));
        if(lo) lo.style.transform = 'scale(' + (0.6 + progress * 0.5) + ')';
        if(hi) hi.style.transform = 'scale(' + (0.6 + progress * 1.3) + ')';
        ticking = false;
      }
      function onScroll(){
        if(!ticking){
          requestAnimationFrame(update);
          ticking = true;
        }
      }
      window.addEventListener('scroll', onScroll, {passive:true});
      update();
    })();
</script>

