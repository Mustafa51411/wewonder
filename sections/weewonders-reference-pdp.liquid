  .adv-item b{font-family:var(--fd);color:var(--navy);display:block}.adv-item small{color:var(--muted)}

  /* us vs them — embedded split experience */
  .split{position:relative;border-radius:26px;overflow:hidden;margin-top:36px;display:grid;grid-template-columns:1fr 1fr;box-shadow:var(--shadow)}
  .split-img{display:block;max-width:520px;margin:36px auto 0;border:6px solid #fff;box-shadow:0 24px 50px -20px rgba(26,43,60,.45);aspect-ratio:1100/975}
