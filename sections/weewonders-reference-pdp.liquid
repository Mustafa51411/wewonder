  footer img{height:26px;width:auto;filter:brightness(0) invert(1);opacity:.9;margin-bottom:11px}
  footer h4{color:#fff;font-family:var(--fd);margin-bottom:10px;font-size:.96rem}
  footer a{color:#a9c1d3;display:block;margin-bottom:7px;font-size:.9rem}footer a:hover{color:#fff}
  .foot-note{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.12);margin-top:28px;padding-top:16px;font-size:.77rem;color:#6f8598;max-width:none}

  .buybar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);transform:translateY(110%);transition:transform .35s;display:none}
  .buybar.show{transform:translateY(0)}
  .buybar .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 20px}
  .buybar .p{font-family:var(--fd);color:var(--navy);font-weight:800}.buybar .p small{display:block;font-family:var(--fb);font-weight:600;color:var(--muted);font-size:.74rem}
  .buybar .btn{width:auto;flex:1;max-width:230px}

  @media(max-width:980px){
    .pdp .wrap{grid-template-columns:1fr;gap:24px}.gallery{position:static}
    .wall{grid-template-columns:1fr 1fr}.shots{grid-template-columns:repeat(3,1fr)}.stats{grid-template-columns:1fr 1fr}
    .adv,.split,.rep-grid,.refill{grid-template-columns:1fr}.split .us{order:-1}
    .scenario-split{gap:12px}.scenario{padding:14px 10px}
    .sc-step,.sc-result{font-size:.84rem}.sc-result{font-size:1.05rem}.sc-arrow{font-size:.9rem}
    .vids,.steps,.moms,.gcards{grid-template-columns:1fr 1fr}
    footer .wrap{grid-template-columns:1fr 1fr}.head nav{display:none}.buybar{display:block}
  }
  @media(max-width:560px){
