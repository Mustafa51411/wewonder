  .wa p{font-size:.95rem;color:var(--ink)}
  .shots{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-top:20px}
  .shots:empty{display:none}
  .shot{aspect-ratio:4/5}
  .proof-open{display:block;width:100%;height:100%;padding:0;border:0;border-radius:15px;background:#fff;cursor:zoom-in;overflow:hidden}
  .shot img{width:100%;height:100%;object-fit:contain;object-position:center;border-radius:15px;background:#fff}
  .proof-lightbox{position:fixed;inset:0;z-index:2147483646;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(10,22,34,.88);backdrop-filter:blur(5px)}
  .proof-lightbox.open{display:flex}
  .proof-lightbox img{display:block;width:auto;height:auto;max-width:min(92vw,760px);max-height:86vh;object-fit:contain;border-radius:14px;background:#fff;box-shadow:0 24px 70px rgba(0,0,0,.4)}
  .proof-close{position:absolute;top:max(18px,env(safe-area-inset-top));right:18px;width:44px;height:44px;border:0;border-radius:50%;background:#fff;color:var(--navy);font-size:28px;line-height:1;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.24)}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px;border-top:1px solid var(--line);padding-top:28px}
  .stat{text-align:center}
  .stat b{font-family:var(--fd);font-size:2.1rem;color:var(--navy);display:block}
  .stat span{font-weight:800;color:var(--blue);display:inline-block;margin-top:6px;font-size:.86rem;text-transform:uppercase;letter-spacing:.04em;border-bottom:3px solid var(--sky);padding-bottom:2px}
  .stat small{display:block;color:var(--muted);font-size:.74rem;margin-top:6px}

  /* PATTERN-INTERRUPT: big claim section */
  .claim{background:var(--navy);color:#fff;padding:88px 0 0;text-align:center;overflow:visible;position:relative;border-top:0}
  .claim .wrap{padding-bottom:44px}
  .claim .eyebrow{color:var(--sky)}
  .claim .lede{font-family:var(--fb);font-weight:700;font-size:1.15rem;color:#cfe6f2;max-width:36ch;margin:0 auto 6px}
  .claim .big{font-family:var(--fd);font-weight:700;text-transform:capitalize;font-size:clamp(2.6rem,9vw,6rem);line-height:.95;letter-spacing:-.01em;
    color:var(--sky);display:block;margin:8px 0;white-space:nowrap}
  .claim .conclusion{font-family:var(--fd);font-weight:700;font-size:clamp(1.6rem,3.4vw,2.3rem);margin:40px 0 44px;color:#fff;line-height:1.25}
  .fm-headline{font-family:var(--fd);font-weight:800;font-size:clamp(1.9rem,4.4vw,3.1rem);text-align:center;margin-top:10px;color:#fff;line-height:1.2}
  .fm-headline .eq{color:rgba(255,255,255,.45);margin:0 .12em;font-weight:600}
  .hl-solid{color:var(--navy);background:var(--sky);border-radius:.15em;padding:.02em .12em}
  .scenario-split{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:52px;max-width:900px;margin-inline:auto}
  .scenario{position:relative;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:18px;padding:20px;text-align:center}
  .sc-img{width:100%;height:84px;border-radius:14px;background:rgba(255,255,255,.07);border:1.5px dashed rgba(255,255,255,.32);display:grid;place-items:center;color:rgba(255,255,255,.5);font-family:var(--fb);font-size:.72rem;line-height:1.2;margin-bottom:16px;text-align:center;padding:4px}
  .sc-img.has-image{height:auto;min-height:0;aspect-ratio:16/9;padding:0;overflow:hidden;border-style:solid;background:rgba(255,255,255,.04)}
  .sc-img.has-image::before{display:none}
  .sc-img.has-image img{display:block;width:100%;height:100%;min-width:0;min-height:0;object-fit:contain;border-radius:12px}
  .sc-badge{position:absolute;top:-16px;font-size:30px;filter:drop-shadow(0 5px 10px rgba(0,0,0,.4));z-index:2}
  .scenario.neg .sc-badge{left:-10px;transform:rotate(-16deg)}
  .scenario.pos .sc-badge{right:-10px;transform:rotate(16deg)}
  .sc-chain{display:flex;flex-direction:column;align-items:center;gap:6px}
  .sc-step{font-family:var(--fb);font-weight:700;color:#fff;font-size:.96rem}
  .sc-arrow{color:rgba(255,255,255,.4);font-size:1.1rem;line-height:1}
  .sc-result{font-family:var(--fd);font-weight:800;font-size:1.32rem;margin-top:4px}
  .sc-result.bad{color:#a9c1d3}
  .sc-result.good{color:var(--sky)}
  .refill{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:52px;max-width:720px;margin-inline:auto}
  .rc{text-align:left}
  .rc .lbl{font-family:var(--fd);font-weight:700;font-size:1.05rem;color:#fff}
  .rc-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  .drop-ico{display:inline-block;font-size:20px;transform-origin:center;transition:transform .05s linear;filter:drop-shadow(0 4px 8px rgba(0,0,0,.3))}
  .arrow-tag{font-family:var(--fb);font-weight:700;font-size:.78rem;display:block;margin-top:2px}
  .arrow-tag.low{color:#a9c1d3}
