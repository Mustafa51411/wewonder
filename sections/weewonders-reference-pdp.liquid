  .variant.sel{border-color:var(--navy);background:#fff;position:relative;
    box-shadow:7px 7px 0 0 var(--sky),14px 14px 0 0 var(--navy),0 20px 34px -10px rgba(26,43,60,.4)}
  .variant .vimg{width:74px;height:74px;object-fit:contain;flex:0 0 74px}
