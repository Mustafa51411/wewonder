  .tl-sub{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:16px;font-family:var(--fb);font-weight:600;color:var(--muted);font-size:1.05rem}
  .tl-logotext{font-family:var(--fd);font-weight:800;font-size:1.6rem;letter-spacing:-.01em;color:var(--navy);
    background:linear-gradient(180deg,rgba(143,217,245,0) 52%, rgba(143,217,245,.85) 52%);padding:2px 8px 0}
  .milk-track{position:relative;margin-top:60px;padding-top:8px}
  .milk-line{position:absolute;top:37px;left:4%;right:4%;height:6px;border-radius:999px;background:rgba(26,43,60,.14);pointer-events:none}
  .milk-line .fill{position:absolute;left:0;top:0;height:100%;width:0%;border-radius:999px;background:linear-gradient(90deg,var(--blue),var(--navy));transition:width .05s linear}
  .milk-drag{position:absolute;top:22px;left:4%;width:92%;height:36px;margin:0;-webkit-appearance:none;appearance:none;background:transparent;cursor:grab;z-index:5}
  .milk-drag:active{cursor:grabbing}
  .milk-drag::-webkit-slider-runnable-track{height:36px;background:transparent}
  .milk-drag::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:transparent;border:0;margin-top:5px;cursor:grab}
  .milk-drag::-moz-range-thumb{width:26px;height:26px;border-radius:50%;background:transparent;border:0;cursor:grab}
  .milk-drag::-moz-range-track{height:36px;background:transparent}
  .milk-cursor{position:absolute;top:25px;width:30px;height:30px;left:4%;border-radius:50%;
    background:radial-gradient(circle at 32% 28%,#fff 0%,var(--sky-soft) 60%,var(--sky) 100%);
    border:2.5px solid #fff;display:flex;align-items:center;justify-content:center;transform:translateX(-50%);
    box-shadow:0 10px 22px -8px rgba(26,43,60,.45),0 0 0 3px rgba(63,169,222,.3);
    pointer-events:none;z-index:6;transition:left .04s linear,width .1s ease-out,height .1s ease-out,top .1s ease-out}
  .milk-cursor span{display:block;line-height:1;font-size:15px;transition:font-size .1s ease-out}
  .drag-hint{position:absolute;top:-30px;left:50%;transform:translateX(-50%);font-size:.74rem;font-weight:700;color:var(--blue);display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.04em}
  .jsteps{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
  .js{text-align:center;transition:opacity .3s}
  .js .drops{height:34px;display:flex;align-items:flex-end;justify-content:center;gap:3px;margin-bottom:6px}
  .js .drops svg{width:11px;opacity:.2;transition:opacity .3s}
  .js.active .drops svg{opacity:1}
  .js .station{width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid rgba(26,43,60,.22);margin:0 auto 12px;position:relative;z-index:2;transition:background .3s,border-color .3s,box-shadow .3s}
  .js.active .station{background:var(--navy);border-color:var(--navy);box-shadow:0 0 0 5px rgba(63,169,222,.28)}
  .js .lab{font-family:var(--fd);color:rgba(26,43,60,.4);font-weight:700;font-size:.82rem;text-transform:uppercase;letter-spacing:.04em;transition:color .3s}
  .js.active .lab{color:var(--blue)}
  .js h3{font-size:.98rem;margin:6px 0 6px;color:rgba(26,43,60,.35);transition:color .3s}
  .js.active h3{color:var(--navy)}
  .js p{font-size:.85rem;color:rgba(26,43,60,.28);margin-inline:auto;transition:color .3s}
  .js.active p{color:var(--muted)}
  .tl .disc{margin-top:34px;font-size:.8rem;color:var(--muted);text-align:center}
  @media(max-width:980px){
    .milk-drag{display:none}
    .milk-cursor{display:none}
    .milk-line{display:none}
    .drag-hint{display:none}
    .jsteps{grid-template-columns:1fr;gap:30px;padding-left:26px}
    .jsteps::before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:3px;border-radius:999px;background:rgba(26,43,60,.14)}
    .js{text-align:left;display:flex;align-items:flex-start;gap:16px;position:relative;left:-26px;padding-left:26px}
    .js .station{margin:4px 0 0;flex:0 0 16px}
    .js .js-body{flex:1;min-width:0}
    .js .drops{justify-content:flex-start;margin-bottom:4px}
    .js p{margin-inline:0;max-width:32ch}
  }

  /* moms / worries */
  .moms{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
  .mom{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 12px 34px -26px rgba(26,43,60,.4)}
  .mom .h{display:flex;gap:11px;align-items:center;margin-bottom:9px}
  .mom .ic{flex:0 0 34px;width:34px;height:34px;border-radius:10px;background:var(--mist);display:grid;place-items:center;color:var(--navy)}
  .mom .h b{font-family:var(--fd);color:var(--navy);font-size:1rem}
  .mom p{color:var(--muted);font-size:.92rem}

  /* video testimonials */
  .vids{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px}
  .vid .video{position:relative;width:100%;aspect-ratio:9/16;min-height:0;padding:0;overflow:hidden;border-style:solid;background:#eef5f8}
  .vid .video.has-media::before{display:none}
  .vid .video video,.vid .video img{display:block;width:100%;height:100%;object-fit:cover;border-radius:14px}
  .vid .video-play{position:absolute;left:16px;bottom:16px;z-index:2;width:52px;height:52px;border:2px solid #fff;border-radius:50%;background:rgba(26,43,60,.58);color:#fff;display:grid;place-items:center;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.26);transition:transform .18s ease,background .18s ease,opacity .18s ease}
  .vid .video-play:hover{transform:scale(1.06);background:rgba(26,43,60,.8)}
  .vid .video-play svg{width:22px;height:22px;margin-left:3px}
  .vid .video.is-playing .video-play{opacity:0;visibility:hidden;pointer-events:none}
  .vid .cap{margin-top:10px}.vid .cap b{color:var(--navy);font-size:.92rem;display:block;margin-top:3px}.vid .cap .stars{font-size:.78rem;display:block;margin-top:2px}
  .vid .cap .pain{display:inline-block;font-family:var(--fd);font-weight:700;font-size:.68rem;text-transform:uppercase;letter-spacing:.03em;color:var(--blue);background:var(--sky-soft);padding:3px 9px;border-radius:999px}

  /* advantage */
  .adv{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
  .adv-list{display:flex;flex-direction:column;gap:18px}
  .adv-item{display:flex;gap:14px;align-items:flex-start}
  .adv-item .i{width:42px;height:42px;border-radius:12px;background:var(--mist);display:grid;place-items:center;flex:0 0 42px;color:var(--navy)}
  .adv-item b{font-family:var(--fd);color:var(--navy);display:block}.adv-item small{color:var(--muted)}

  /* us vs them — embedded split experience */
  .split{position:relative;border-radius:26px;overflow:hidden;margin-top:36px;display:grid;grid-template-columns:1fr 1fr;box-shadow:var(--shadow)}
  .comparison-heading{font-family:'Baloo 2',var(--fd);font-size:clamp(1.6rem,3.3vw,2.5rem);font-weight:800!important;line-height:1.08;letter-spacing:-.01em}
  .split-img{display:block;width:min(100%,520px);max-width:520px;margin:36px auto 0;border:6px solid #fff;box-shadow:0 24px 50px -20px rgba(26,43,60,.45);aspect-ratio:1100/975}
  .split-img img{width:100%;height:100%;display:block;border-radius:20px;object-fit:contain;object-position:center}
  .split .side{padding:38px 30px;position:relative}
  .split .them{background:#F0F3F5;color:var(--muted)}
  .split .us{background:var(--navy);color:#fff}
  .split h3{margin-bottom:16px}
  .split .them h3{color:#7c8993}
  .split .us h3{color:#fff}
  .split ul{list-style:none;display:flex;flex-direction:column;gap:13px}
  .split li{display:flex;gap:11px;align-items:center;font-weight:600;font-size:.96rem}
  .split .them li{color:#6d7a84}
  .split .us li{color:#dcebf3}
  .split li svg{flex:0 0 22px}
  .split .divider{position:absolute;top:0;bottom:0;left:50%;width:60px;transform:translateX(-50%);z-index:3;pointer-events:none}
  .split .badge-vs{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:4;width:58px;height:58px;border-radius:50%;background:#fff;
    display:grid;place-items:center;font-family:var(--fd);font-weight:800;color:var(--navy);font-size:.85rem;box-shadow:0 10px 26px -8px rgba(0,0,0,.35)}

  /* steps */
  .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:32px}
  .step .ph{margin-bottom:10px}.step .num{font-family:var(--fd);font-weight:800;color:var(--blue);font-size:1.4rem}
  .step h3{font-size:.98rem;margin:2px 0 5px}.step p{font-size:.86rem;color:var(--muted)}

  /* risk reversal — wide thin horizontal strip */
  .guar{background:var(--navy);padding:56px 0;border-top:1px solid var(--line)}
  .guar-head h2{color:#fff}
  .guar-head .giant-hl{color:var(--navy);background-image:none;background:var(--sky);border-radius:.15em;padding:.02em .1em}
  .guar-feature{background:#fff;border-radius:20px;padding:24px 30px 24px 20px;display:flex;gap:22px;align-items:center;max-width:600px;margin:0 auto 26px;box-shadow:0 22px 44px -20px rgba(0,0,0,.4)}
  .guar-feature .scallop-big{width:128px;height:128px;flex:0 0 128px;transform:rotate(-9deg);filter:drop-shadow(0 14px 24px rgba(26,43,60,.4))}
  .guar-feature .scallop-big .txt b{color:#fff;font-size:1.9rem}
  .guar-feature .scallop-big .txt small{color:#fff}
  .guar-feature .gf-label{font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.05em;font-size:.7rem;color:var(--blue)}
  .guar-feature .gf-title{font-family:var(--fd);font-weight:800;color:var(--navy);font-size:1.28rem;display:block;margin:2px 0 3px}
  .guar-feature .gf-sub{color:var(--muted);font-size:.88rem}
  .guar-mini{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 30px;max-width:680px;margin:0 auto}
  .guar-mini .gm{display:flex;align-items:center;gap:9px;color:#dbe9f2;font-size:.88rem;font-weight:600}
  .guar-mini .gm svg{color:var(--sky);flex:0 0 auto}
  .guar-head{text-align:center;margin-bottom:30px}
  .gcards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .gc{background:#fff;border:1.6px solid var(--line);border-radius:16px;padding:22px;text-align:center}
  .gc .i{width:44px;height:44px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;margin:0 auto 12px}
  .gc b{font-family:var(--fd);color:var(--navy);display:block;margin-bottom:4px}
  .gc small{color:var(--muted);font-size:.86rem}

  /* offer reprise */
  .reprise{background:#fff}
  .rep-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:720px;margin:26px auto 0}
  .rep-summary{display:flex;justify-content:center;gap:22px;margin-top:20px;flex-wrap:wrap}
  .rep-summary span{display:flex;align-items:center;gap:7px;font-weight:700;color:var(--navy);font-size:.88rem}
  .rep-summary svg{color:var(--good)}

  /* faq */
  .faq{max-width:820px;margin:26px auto 0}
  details{border-bottom:1px solid var(--line)}
  summary{list-style:none;cursor:pointer;padding:17px 4px;font-family:var(--fd);font-weight:600;color:var(--navy);font-size:1.04rem;display:flex;justify-content:space-between;gap:16px;align-items:center}
  summary::-webkit-details-marker{display:none}
  summary .pm{flex:0 0 24px;height:24px;border-radius:50%;background:var(--mist);color:var(--navy);display:grid;place-items:center;font-weight:800;transition:transform .2s}
  details[open] summary .pm{transform:rotate(45deg)}details p{padding:0 4px 17px;color:var(--muted)}

  footer{background:var(--navy);color:#a9c1d3;padding:48px 0 28px}
  footer .wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:26px}
  footer img{height:26px;width:auto;filter:brightness(0) invert(1);opacity:.9;margin-bottom:11px}
  footer h4{color:#fff;font-family:var(--fd);margin-bottom:10px;font-size:.96rem}
  footer a{color:#a9c1d3;display:block;margin-bottom:7px;font-size:.9rem}footer a:hover{color:#fff}
  .foot-note{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.12);margin-top:28px;padding-top:16px;font-size:.77rem;color:#6f8598;max-width:none}

  .buybar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);transform:translateY(110%);transition:transform .35s;display:none}
  .buybar.show{transform:translateY(0)}
  .buybar .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 20px}
  .buybar .p{font-family:var(--fd);color:var(--navy);font-weight:800}.buybar .p small{display:block;font-family:var(--fb);font-weight:600;color:var(--muted);font-size:.74rem}
  .buybar .btn{width:auto;flex:1;max-width:230px}
  .ww-wa-float{position:fixed;right:22px;bottom:22px;z-index:62;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff;display:grid;place-items:center;box-shadow:0 12px 30px rgba(18,140,75,.38);transition:transform .18s,background .18s}
  .ww-wa-float:hover{background:#1fba59;color:#fff;transform:translateY(-3px) scale(1.03)}
  .ww-wa-float svg{width:30px;height:30px}

  /* Keep body copy aligned with the storefront, while retaining the
     reference design's Baloo 2 heading face and weight. */
  :scope{font-family:var(--font-body-family,system-ui,sans-serif);font-style:var(--font-body-style,normal);font-weight:var(--font-body-weight,400);font-size:calc(var(--font-body-scale,1) * 1.5rem);line-height:calc(1 + .8 / var(--font-body-scale,1))}
  h1,h2,h3,.dsp{font-family:var(--fd);font-style:normal;font-weight:700!important;letter-spacing:-.01em;line-height:1.08}
  h2{font-size:calc(var(--font-heading-scale,1) * 2.8rem)}
  h3{font-size:calc(var(--font-heading-scale,1) * 1.7rem)}
  .buy h1{font-size:calc(var(--font-heading-scale,1) * 2.8rem);font-weight:700!important}
  .buy .promise,.ksp li,.wa p,.sc-step,.mom p,.adv-item small,.split li,.step p,details p{font-size:1em}
  .wa .top b,.vid .cap b,.step h3,.guarbox b,.gc b,summary{font-size:1em}
  .buy .rate,.variant .vt,.specrow b,.guar-feature .gf-title{font-size:1.05em}
  .buy .rate .en,.specrow small,.variant .pk,.gift-note,.guarbox small,.stat small,.vid .cap .pain,.step .num,.rep-summary span{font-size:.82em}
  .wa .tag,.wa .top .stars,.stat span,.trust .t,.tl .disc{font-size:.78em}
  .stat b{font-size:calc(var(--font-heading-scale,1) * 3.2rem)}
  .btn{font-family:var(--font-heading-family,system-ui,sans-serif);font-style:var(--font-heading-style,normal);font-weight:var(--font-heading-weight,700);font-size:1em}

  @media(min-width:750px){
    h2{font-size:calc(var(--font-heading-scale,1) * 4rem)}
    h3{font-size:calc(var(--font-heading-scale,1) * 2rem)}
    .buy h1{font-size:calc(var(--font-heading-scale,1) * 4rem)}
    .comparison-heading{font-size:clamp(2rem,3.3vw,2.5rem)}
  }

  @media(max-width:980px){
    .pdp .wrap{grid-template-columns:1fr;gap:24px}.gallery{position:static}
    .wall{grid-template-columns:1fr 1fr}.shots{grid-template-columns:repeat(3,1fr)}.stats{grid-template-columns:1fr 1fr}
    .adv,.split,.rep-grid,.refill{grid-template-columns:1fr}.split .us{order:-1}
    .scenario-split{gap:12px}.scenario{padding:14px 10px}
    .sc-step,.sc-result{font-size:.84rem}.sc-result{font-size:1.05rem}.sc-arrow{font-size:.9rem}
    .vids,.steps,.moms,.gcards{grid-template-columns:1fr 1fr}
    footer .wrap{grid-template-columns:1fr 1fr}.head nav{display:none}.buybar{display:block}
    .ww-wa-float{right:16px;bottom:calc(88px + env(safe-area-inset-bottom));width:54px;height:54px}
  }
  @media(max-width:560px){
    .wall,.stats,.vids,.steps,.moms,.trust,.gcards{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr}
    .vid .video,.vid .video video,.vid .video img{border-radius:10px}
    .vid .video-play{left:11px;bottom:11px;width:42px;height:42px}
    .vid .cap .pain{border-radius:8px;padding:5px 8px;line-height:1.35}
    .shots{display:flex;overflow-x:auto;gap:14px;margin-inline:-20px;padding:4px 20px 14px;scroll-snap-type:x mandatory;scroll-padding-left:20px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
    .shots::-webkit-scrollbar{display:none}
    .shots .shot{flex-grow:0;flex-shrink:0;flex-basis:54vw;width:54vw;max-width:210px;scroll-snap-align:start;aspect-ratio:4/5;border-radius:18px;box-shadow:0 14px 30px -22px rgba(26,43,60,.45)}
    .proof-lightbox{padding:16px}.proof-lightbox img{max-width:94vw;max-height:84vh}.proof-close{top:max(12px,env(safe-area-inset-top));right:12px}
    .variant{display:grid;grid-template-columns:64px minmax(0,1fr);gap:8px 12px;align-items:start;padding:14px;overflow:visible}
    .variant .vimg{grid-column:1;grid-row:1 / span 2;width:64px;height:64px;min-width:0;flex:none}
    .variant .vbody{grid-column:2;grid-row:1;min-width:0;padding-right:38px}
    .variant .vprice{grid-column:2;grid-row:2;width:100%;min-width:0;align-items:flex-start;text-align:left;gap:6px}
    .variant .vprice .vline{display:flex;flex-wrap:wrap;align-items:baseline;gap:3px 7px;max-width:100%}
    .variant .vprice .vnow{font-size:1.45rem}
    .variant .vprice .vwas{font-size:.98rem}
    .variant .perks{width:100%;min-width:0;align-items:flex-start}
    .variant .pk{max-width:100%;white-space:normal;overflow-wrap:anywhere;word-break:normal;line-height:1.35;text-align:left}
    .variant .flag{right:-8px;top:-17px;transform:scale(.86);transform-origin:top right}
    .variant.sel{box-shadow:5px 7px 0 var(--sky),10px 13px 0 var(--navy)}
    .variant .vgifts{grid-column:1 / -1;grid-row:auto;margin-top:4px;padding:0}
    .variant .vgift{padding-right:8px}.variant .vg-img{width:28px;height:28px;flex-basis:28px}
    .variant .vg-name,.variant .vg-price{font-size:.66rem}
    footer .wrap{grid-template-columns:1fr}.section{padding:44px 0}.variants{grid-template-columns:1fr}
    .claim .big{font-size:calc(var(--font-heading-scale,1) * 3.2rem)}
  }
  @media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
  :scope .head,:scope footer{display:none}
}
.whatsapp-floating-button{display:none!important}
</style>

<div id="ww-reference">
<div class="topbar">Free sizing kit in every box <span>•</span> Delivery in 48 hours <span>•</span> 6-month warranty <span>•</span> WhatsApp support 7 days</div>

<header class="head">
  <div class="wrap">
    {% if section.settings.logo_image %}
      <img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="69" loading="eager">
    {% else %}
      <img src="{{ 'ww-reference-logo.webp' | asset_url }}" alt="WeeWonders" width="200" height="69" loading="eager">
    {% endif %}
    <nav><a href="#how">How it works</a><a href="#reviews">Reviews</a><a href="#faq">FAQ</a></nav>
    <div class="rate"><span class="stars">★★★★★</span> 4.8</div>
  </div>
</header>

<!-- ===== ATF ===== -->
<section class="pdp">
  <div class="wrap">
    <div class="gallery">
      <div class="g-main">
        {% if product.featured_image != blank %}<img id="mainimg" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="1200" height="960" loading="eager" fetchpriority="high">{% else %}<img id="mainimg" src="{{ 'ww-reference-hero.jpg' | asset_url }}" alt="WeeWonders wearable breast pump" width="1200" height="960" loading="eager" fetchpriority="high">{% endif %}
        <div class="g-nav g-prev" onclick="galStep(-1)">‹</div>
        <div class="g-nav g-next" onclick="galStep(1)">›</div>
        <div class="stamp s1"><div class="scallop">
          <svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg>
          <div class="txt"><b>{{ section.settings.warranty_badge_number }}</b><small>{{ section.settings.warranty_badge_label | newline_to_br }}</small></div>
        </div></div>
      </div>
      <div class="g-thumbs" id="thumbs">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <button {% if forloop.first %}class="active"{% endif %} onclick="galSet({{ forloop.index0 }})"><img src="{{ image | image_url: width: 200 }}" alt="" width="200" height="200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"></button>
          {% endfor %}
        {% else %}
          <button class="active" onclick="galSet(0)"><img src="{{ 'ww-reference-hero.jpg' | asset_url }}" alt="" width="1000" height="800" loading="eager"></button>
          <button onclick="galSet(1)"><img src="{{ 'ww-reference-gallery-2.jpg' | asset_url }}" alt="" width="1000" height="800" loading="lazy"></button>
          <button onclick="galSet(2)"><img src="{{ 'ww-reference-gallery-3.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy"></button>
          <button onclick="galSet(3)"><img src="{{ 'ww-reference-gallery-4.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy"></button>
