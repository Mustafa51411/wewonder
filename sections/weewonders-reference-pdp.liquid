  .variant .vg-price s{color:#8b96a0;font-weight:700;margin-right:3px;text-decoration-color:var(--bad)}
  .variant .flag{position:absolute;top:-22px;right:-20px;width:52px;height:52px;display:grid;place-items:center;z-index:3;filter:drop-shadow(0 6px 12px rgba(26,43,60,.35))}
  .variant .flag svg{position:absolute;inset:0;width:100%;height:100%}
