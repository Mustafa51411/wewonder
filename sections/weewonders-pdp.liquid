{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'WeeWondersProductForm-' | append: section.id
%}

<section id="WeeWondersPdp-{{ section.id }}" class="ww-pdp">
  <style>
    #WeeWondersPdp-{{ section.id }} {
      --ww-navy: {{ section.settings.navy_color }};
      --ww-blue: {{ section.settings.accent_color }};
      --ww-sky: #eaf6fc;
      --ww-ink: #22323f;
      --ww-muted: #5c6b77;
      --ww-line: #dce9ef;
      --ww-page: min(1200px, calc(100% - 40px));
      color: var(--ww-ink);
      background: #fff;
      font-family: inherit;
      overflow: clip;
    }
    #WeeWondersPdp-{{ section.id }} * { box-sizing: border-box; }
    #WeeWondersPdp-{{ section.id }} .ww-wrap { width: var(--ww-page); margin-inline: auto; }
    #WeeWondersPdp-{{ section.id }} .ww-topbar { background: var(--ww-navy); color: #fff; padding: 10px 16px; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: .02em; }
    #WeeWondersPdp-{{ section.id }} .ww-head { border-bottom: 1px solid var(--ww-line); background: #fff; }
    #WeeWondersPdp-{{ section.id }} .ww-head-inner { min-height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    #WeeWondersPdp-{{ section.id }} .ww-brand { color: var(--ww-navy); font-size: 22px; font-weight: 800; text-decoration: none; line-height: 1; }
    #WeeWondersPdp-{{ section.id }} .ww-brand img { width: auto; max-width: 180px; height: 32px; object-fit: contain; }
    #WeeWondersPdp-{{ section.id }} .ww-nav { display: flex; gap: 24px; }
    #WeeWondersPdp-{{ section.id }} .ww-nav a { color: var(--ww-ink); font-size: 14px; font-weight: 700; text-decoration: none; }
    #WeeWondersPdp-{{ section.id }} .ww-rating { color: var(--ww-navy); font-size: 14px; font-weight: 800; white-space: nowrap; }
    #WeeWondersPdp-{{ section.id }} .ww-stars { color: var(--ww-blue); letter-spacing: 1px; }
    #WeeWondersPdp-{{ section.id }} .ww-main { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(360px, .9fr); gap: clamp(26px, 5vw, 64px); padding-block: clamp(28px, 5vw, 64px); align-items: start; }
    #WeeWondersPdp-{{ section.id }} .ww-gallery { position: sticky; top: 20px; }
    #WeeWondersPdp-{{ section.id }} .ww-main-image { position: relative; aspect-ratio: 1 / 1; border: 1px solid var(--ww-line); border-radius: 24px; background: linear-gradient(145deg, #f5fafc, #edf6fa); overflow: hidden; }
    #WeeWondersPdp-{{ section.id }} .ww-main-image img { width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; display: block; }
    #WeeWondersPdp-{{ section.id }} .ww-no-media { display: grid; place-items: center; height: 100%; color: var(--ww-muted); padding: 24px; text-align: center; }
    #WeeWondersPdp-{{ section.id }} .ww-gallery-controls { position: absolute; inset: 50% 12px auto; display: flex; justify-content: space-between; pointer-events: none; }
    #WeeWondersPdp-{{ section.id }} .ww-gallery-controls button { pointer-events: auto; width: 42px; height: 42px; border: 1px solid var(--ww-line); border-radius: 50%; background: rgba(255,255,255,.92); color: var(--ww-navy); cursor: pointer; font-size: 22px; }
    #WeeWondersPdp-{{ section.id }} .ww-thumbs { display: flex; gap: 9px; margin-top: 12px; overflow-x: auto; padding-bottom: 3px; scrollbar-width: thin; }
    #WeeWondersPdp-{{ section.id }} .ww-thumb { flex: 0 0 70px; height: 70px; padding: 0; border: 2px solid transparent; background: #f4f8fa; border-radius: 11px; cursor: pointer; overflow: hidden; }
    #WeeWondersPdp-{{ section.id }} .ww-thumb[aria-current="true"] { border-color: var(--ww-navy); }
    #WeeWondersPdp-{{ section.id }} .ww-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #WeeWondersPdp-{{ section.id }} .ww-eyebrow { margin: 0 0 8px; color: var(--ww-blue); font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    #WeeWondersPdp-{{ section.id }} h1 { color: var(--ww-navy); margin: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1.08; letter-spacing: -.035em; }
    #WeeWondersPdp-{{ section.id }} .ww-summary { color: var(--ww-muted); margin: 14px 0 0; font-size: 17px; line-height: 1.55; }
    #WeeWondersPdp-{{ section.id }} .ww-price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: 22px 0; }
    #WeeWondersPdp-{{ section.id }} .ww-price { color: var(--ww-navy); font-size: 29px; font-weight: 850; }
    #WeeWondersPdp-{{ section.id }} .ww-compare { color: #b64e4e; font-size: 17px; font-weight: 700; text-decoration: line-through; }
    #WeeWondersPdp-{{ section.id }} .ww-save { color: #18754b; background: #e9f7ef; border-radius: 99px; padding: 4px 8px; font-size: 12px; font-weight: 800; }
    #WeeWondersPdp-{{ section.id }} .ww-option { margin: 16px 0; }
    #WeeWondersPdp-{{ section.id }} .ww-option label { display: block; margin-bottom: 7px; color: var(--ww-navy); font-size: 14px; font-weight: 800; }
    #WeeWondersPdp-{{ section.id }} .ww-option select { width: 100%; min-height: 48px; padding: 10px 38px 10px 13px; border: 1px solid var(--ww-line); border-radius: 12px; background: #fff; color: var(--ww-ink); font: inherit; }
    #WeeWondersPdp-{{ section.id }} .ww-buy { margin-top: 20px; }
    #WeeWondersPdp-{{ section.id }} .ww-buy button { display: flex; justify-content: center; align-items: center; width: 100%; min-height: 56px; border: 0; border-radius: 14px; background: var(--ww-navy); color: #fff; cursor: pointer; font: inherit; font-size: 17px; font-weight: 800; transition: transform .16s ease, opacity .16s ease; }
    #WeeWondersPdp-{{ section.id }} .ww-buy button:hover { transform: translateY(-1px); }
    #WeeWondersPdp-{{ section.id }} .ww-buy button:disabled { cursor: not-allowed; opacity: .5; transform: none; }
    #WeeWondersPdp-{{ section.id }} .ww-status { min-height: 20px; margin-top: 9px; color: var(--ww-muted); font-size: 13px; font-weight: 700; }
    #WeeWondersPdp-{{ section.id }} .ww-benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 24px 0 0; padding: 16px 0; border-block: 1px solid var(--ww-line); }
    #WeeWondersPdp-{{ section.id }} .ww-benefit { color: var(--ww-muted); font-size: 12px; font-weight: 700; text-align: center; }
    #WeeWondersPdp-{{ section.id }} .ww-benefit strong { display: block; color: var(--ww-navy); font-size: 14px; margin-bottom: 2px; }
    #WeeWondersPdp-{{ section.id }} .ww-content { padding-block: clamp(36px, 6vw, 78px); border-top: 1px solid var(--ww-line); }
    #WeeWondersPdp-{{ section.id }} .ww-content-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .75fr); gap: clamp(28px, 6vw, 80px); }
    #WeeWondersPdp-{{ section.id }} .ww-content h2 { color: var(--ww-navy); margin: 0 0 16px; font-size: clamp(27px, 3vw, 38px); letter-spacing: -.03em; }
    #WeeWondersPdp-{{ section.id }} .ww-rte { color: var(--ww-muted); line-height: 1.7; }
    #WeeWondersPdp-{{ section.id }} .ww-rte > *:first-child { margin-top: 0; }
    #WeeWondersPdp-{{ section.id }} details { border-bottom: 1px solid var(--ww-line); }
    #WeeWondersPdp-{{ section.id }} summary { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; cursor: pointer; color: var(--ww-navy); font-size: 16px; font-weight: 800; list-style: none; }
    #WeeWondersPdp-{{ section.id }} summary::-webkit-details-marker { display: none; }
    #WeeWondersPdp-{{ section.id }} summary::after { content: '+'; color: var(--ww-blue); font-size: 22px; line-height: .8; }
    #WeeWondersPdp-{{ section.id }} details[open] summary::after { content: '−'; }
    #WeeWondersPdp-{{ section.id }} .ww-accordion-body { padding: 0 0 16px; color: var(--ww-muted); line-height: 1.6; }
    #WeeWondersPdp-{{ section.id }} .ww-feature-list { display: grid; gap: 12px; }
    #WeeWondersPdp-{{ section.id }} .ww-feature { display: flex; gap: 12px; align-items: flex-start; padding: 16px; background: var(--ww-sky); border-radius: 14px; }
    #WeeWondersPdp-{{ section.id }} .ww-feature-mark { color: var(--ww-blue); font-weight: 900; }
    #WeeWondersPdp-{{ section.id }} .ww-feature strong { display: block; color: var(--ww-navy); margin-bottom: 3px; }
    #WeeWondersPdp-{{ section.id }} .ww-feature span { color: var(--ww-muted); font-size: 14px; line-height: 1.5; }
    @media (max-width: 900px) {
      #WeeWondersPdp-{{ section.id }} .ww-main, #WeeWondersPdp-{{ section.id }} .ww-content-grid { grid-template-columns: 1fr; }
      #WeeWondersPdp-{{ section.id }} .ww-gallery { position: static; }
    }
    @media (max-width: 640px) {
      #WeeWondersPdp-{{ section.id }} { --ww-page: min(100% - 28px, 1200px); }
      #WeeWondersPdp-{{ section.id }} .ww-topbar { font-size: 11px; }
      #WeeWondersPdp-{{ section.id }} .ww-head-inner { min-height: 54px; }
      #WeeWondersPdp-{{ section.id }} .ww-nav { display: none; }
      #WeeWondersPdp-{{ section.id }} .ww-rating { font-size: 12px; }
      #WeeWondersPdp-{{ section.id }} .ww-main { gap: 26px; padding-block: 22px 36px; }
      #WeeWondersPdp-{{ section.id }} .ww-main-image { border-radius: 18px; }
      #WeeWondersPdp-{{ section.id }} .ww-thumb { flex-basis: 58px; height: 58px; }
      #WeeWondersPdp-{{ section.id }} h1 { font-size: 32px; }
      #WeeWondersPdp-{{ section.id }} .ww-summary { font-size: 16px; }
      #WeeWondersPdp-{{ section.id }} .ww-benefits { grid-template-columns: 1fr; text-align: left; }
      #WeeWondersPdp-{{ section.id }} .ww-benefit { display: flex; gap: 6px; text-align: left; }
      #WeeWondersPdp-{{ section.id }} .ww-benefit strong { display: inline; }
    }
  </style>

  {% if section.settings.announcement != blank %}<div class="ww-topbar">{{ section.settings.announcement }}</div>{% endif %}
  <header class="ww-head">
    <div class="ww-wrap ww-head-inner">
      <a class="ww-brand" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 360 | image_tag: loading: 'eager', alt: shop.name }}{% else %}{{ shop.name }}{% endif %}
      </a>
      <nav class="ww-nav" aria-label="Product page">
        <a href="#ww-details-{{ section.id }}">{{ section.settings.details_label }}</a>
        <a href="#ww-faq-{{ section.id }}">{{ section.settings.faq_label }}</a>
      </nav>
      {% if section.settings.rating_text != blank %}<div class="ww-rating"><span class="ww-stars" aria-hidden="true">★★★★★</span> {{ section.settings.rating_text }}</div>{% endif %}
    </div>
  </header>

  <div class="ww-wrap ww-main">
    <div class="ww-gallery" data-gallery>
      <div class="ww-main-image">
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1400 }}
        {% else %}
          <div class="ww-no-media">Add product media in Shopify Admin to display it here.</div>
        {% endif %}
        {% if product.images.size > 1 %}
          <div class="ww-gallery-controls"><button type="button" data-gallery-prev aria-label="Previous image">‹</button><button type="button" data-gallery-next aria-label="Next image">›</button></div>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="ww-thumbs" role="list" aria-label="{{ product.title }} media">
          {% for image in product.images %}
            <button class="ww-thumb" type="button" data-gallery-thumb data-src="{{ image | image_url: width: 1400 }}" data-alt="{{ image.alt | default: product.title | escape }}" aria-current="{% if image.id == product.featured_image.id %}true{% else %}false{% endif %}" role="listitem">
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="ww-info">
      {% if product.vendor != blank %}<p class="ww-eyebrow">{{ product.vendor }}</p>{% endif %}
      <h1>{{ product.title }}</h1>
      {% if product.description != blank %}<div class="ww-summary">{{ product.description | strip_html | truncatewords: 28 }}</div>{% endif %}

      <div class="ww-price-row" aria-live="polite">
        <span class="ww-price" data-price>{{ current_variant.price | money }}</span>
        <s class="ww-compare" data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
        <span class="ww-save" data-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}%{% endif %}</span>
      </div>

      {% form 'product', product, id: product_form_id, class: 'ww-buy', data-product-form: '' %}
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div class="ww-option">
              <label for="ww-option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
              <select id="ww-option-{{ section.id }}-{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">
                {% for value in option.values %}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
        {% endunless %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <button type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}><span data-add-label>{% if current_variant.available %}{{ section.settings.add_to_cart_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span></button>
        <p class="ww-status" data-status>{% if current_variant.available %}{{ section.settings.available_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</p>
      {% endform %}

      <div class="ww-benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="ww-benefit" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div id="ww-details-{{ section.id }}" class="ww-content">
    <div class="ww-wrap ww-content-grid">
      <div>
        <h2>{{ section.settings.details_heading }}</h2>
        <div class="ww-rte">{{ product.description }}</div>
      </div>
      <div id="ww-faq-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'feature' %}
              <div class="ww-feature-list" {{ block.shopify_attributes }}><div class="ww-feature"><span class="ww-feature-mark">✓</span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></div></div>
            {% when 'faq' %}
              <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="ww-accordion-body">{{ block.settings.answer }}</div></details>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  <script type="application/json" data-variants>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.getElementById('WeeWondersPdp-{{ section.id }}');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = 'true';
      const variants = JSON.parse(root.querySelector('[data-variants]').textContent);
      const optionSelects = [...root.querySelectorAll('[data-option-index]')];
      const variantInput = root.querySelector('[data-variant-id]');
      const price = root.querySelector('[data-price]');
      const compare = root.querySelector('[data-compare]');
      const save = root.querySelector('[data-save]');
      const status = root.querySelector('[data-status]');
      const button = root.querySelector('[data-add-to-cart]');
      const label = root.querySelector('[data-add-label]');
      const money = cents => new Intl.NumberFormat(undefined, { style: 'currency', currency: {{ shop.currency | json }} }).format(cents / 100);
      const update = () => {
        const selected = optionSelects.map(select => select.value);
        const variant = variants.find(item => item.options.every((value, index) => value === selected[index]));
        if (!variant) return;
        variantInput.value = variant.id;
        price.textContent = money(variant.price);
        const onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
        compare.hidden = !onSale;
        save.hidden = !onSale;
        if (onSale) {
          compare.textContent = money(variant.compare_at_price);
          save.textContent = 'Save ' + Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price) + '%';
        }
        button.disabled = !variant.available;
        label.textContent = variant.available ? {{ section.settings.add_to_cart_label | json }} : {{ section.settings.sold_out_label | json }};
        status.textContent = variant.available ? {{ section.settings.available_label | json }} : {{ section.settings.sold_out_label | json }};
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      };
      optionSelects.forEach(select => select.addEventListener('change', update));

      const thumbs = [...root.querySelectorAll('[data-gallery-thumb]')];
      const mainImage = root.querySelector('.ww-main-image img');
      let current = Math.max(0, thumbs.findIndex(thumb => thumb.getAttribute('aria-current') === 'true'));
      const show = index => {
        if (!mainImage || !thumbs.length) return;
        current = (index + thumbs.length) % thumbs.length;
        const thumb = thumbs[current];
        mainImage.src = thumb.dataset.src;
        mainImage.alt = thumb.dataset.alt;
        thumbs.forEach((item, itemIndex) => item.setAttribute('aria-current', String(itemIndex === current)));
      };
      root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
      root.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
      thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index)));
    })();
  </script>
</section>

{% schema %}
{
  "name": "WeeWonders Custom PDP",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Fast delivery and trusted quality for your family." },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Trusted by families" },
    { "type": "text", "id": "details_label", "label": "Details navigation label", "default": "Details" },
    { "type": "text", "id": "faq_label", "label": "FAQ navigation label", "default": "FAQ" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "available_label", "label": "Available status label", "default": "In stock" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "details_heading", "label": "Details heading", "default": "Product details" },
    { "type": "select", "id": "image_fit", "label": "Product image fit", "default": "contain", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }] },
    { "type": "color", "id": "navy_color", "label": "Dark color", "default": "#1a2b3c" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#3fa9de" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Purchase benefit",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Quality assured" },
        { "type": "text", "id": "text", "label": "Text", "default": "Thoughtfully selected" }
      ]
    },
    {
      "type": "feature",
      "name": "Product feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Designed for everyday use" },
        { "type": "text", "id": "text", "label": "Text", "default": "Add a real product benefit here." }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Have a question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WeeWonders Custom PDP",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Fast delivery", "text": "Reliable shipping" } },
        { "type": "benefit", "settings": { "title": "Quality assured", "text": "Made to last" } },
        { "type": "benefit", "settings": { "title": "Support available", "text": "We are here to help" } },
        { "type": "feature", "settings": { "title": "Product information", "text": "Add product-specific benefits from the Theme Editor." } }
      ]
    }
  ]
}
{% endschema %}
