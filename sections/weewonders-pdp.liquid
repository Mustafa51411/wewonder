  #WeeWondersPdp-{{ section.id }} .rc.half .fill{width:42%}
  #WeeWondersPdp-{{ section.id }} .rc.full .fill{width:100%}
  #WeeWondersPdp-{{ section.id }} .rc p{font-size:.86rem;color:#a9c1d3;margin-top:9px;max-width:none}

  #WeeWondersPdp-{{ section.id }} /* journey / milk timeline */
  .tl{background:var(--sky-soft);color:var(--ink);position:relative;padding-bottom:0}
