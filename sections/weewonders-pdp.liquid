  @media (prefers-reduced-motion: reduce){#WeeWondersPdp-{{ section.id }} *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>

<div id="WeeWondersPdp-{{ section.id }}" class="ww-pdp">
<!-- ===== ATF ===== -->
<section class="pdp">
  <div class="wrap">
    <div class="gallery">
      <div class="g-main">
        {% if product.featured_image %}<img id="mainimg" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="1200" height="960" loading="eager" fetchpriority="high">{% else %}<div class="ph sq">Add product media in Shopify Admin</div>{% endif %}
        <div class="g-nav g-prev" onclick="galStep(-1)">‹</div>
        <div class="g-nav g-next" onclick="galStep(1)">›</div>
        <div class="stamp s1"><div class="scallop">
          <svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg>
          <div class="txt"><b>{{ section.settings.badge_number }}</b><small>{{ section.settings.badge_text | newline_to_br }}</small></div>
        </div></div>
      </div>
      <div class="g-thumbs" id="thumbs">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <button {% if forloop.first %}class="active"{% endif %} onclick="galSet({{ forloop.index0 }})"><img src="{{ image | image_url: width: 200 }}" alt="" width="200" height="200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"></button>
          {% endfor %}
        {% endif %}
      </div>
    </div>
    <div class="buy">
      {% assign selected_variant = product.selected_or_first_available_variant %}
      <div class="rate"><span class="stars">★★★★★</span>{% if section.settings.rating_text != blank %} {{ section.settings.rating_text }}{% endif %}</div>
      <h1><span class="hl">{{ product.title }}</span></h1>
      {% if product.description != blank %}<p class="promise">{{ product.description | strip_html | truncatewords: 28 }}</p>{% endif %}
      <form method="post" action="{{ routes.cart_add_url }}" id="pdp-form">
        <div class="variants" id="variants">
          {% for variant in product.variants %}
            {% assign variant_image = variant.featured_image | default: product.featured_image %}
            {% assign save_pct = 0 %}
            {% if variant.compare_at_price > variant.price %}{% assign save_diff = variant.compare_at_price | minus: variant.price %}{% assign save_pct = save_diff | times: 100 | divided_by: variant.compare_at_price %}{% endif %}
            <label class="variant{% if variant.id == selected_variant.id %} sel{% endif %}" data-name="{{ variant.title | escape }}" data-price="{{ variant.price | money }}">
              <input type="radio" name="id" value="{{ variant.id }}"{% if variant.id == selected_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %} style="position:absolute;opacity:0;pointer-events:none" onchange="pick(this)">
              {% if variant_image %}<img class="vimg" src="{{ variant_image | image_url: width: 200 }}" alt="{{ variant.title | escape }}" width="74" height="74" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">{% endif %}
              <div class="vbody"><div class="vt">{{ variant.title }}</div>{% unless variant.available %}<small>Sold out</small>{% endunless %}</div>
              <div class="vprice"><div class="vline"><span class="vnow">{{ variant.price | money }}</span>{% if variant.compare_at_price > variant.price %}<span class="vwas">{{ variant.compare_at_price | money }}</span>{% endif %}</div>{% if save_pct > 0 %}<span class="voff">Save {{ save_pct }}%</span>{% endif %}</div>
            </label>
          {% endfor %}
        </div>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn-cta btn-lg" id="atc" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ section.settings.add_to_cart_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</button>
      </form>
      {% if section.settings.guarantee_title != blank %}
        <div class="guarbox"><div class="gi">✓</div><div><b>{{ section.settings.guarantee_title }}</b>{% if section.settings.guarantee_text != blank %}<small>{{ section.settings.guarantee_text }}</small>{% endif %}</div></div>
      {% endif %}
    </div>
  </div>
</section>

{% if product.description != blank %}
<section class="section" id="details">
  <div class="wrap center">
    <h2>{{ section.settings.details_heading }}</h2>
    <div class="lead rte">{{ product.description }}</div>
  </div>
</section>
{% endif %}


<div class="buybar" id="buybar">
  <div class="wrap">
    <div class="p" id="barprice">{{ selected_variant.price | money }}<small id="barname">{{ selected_variant.title }}</small></div>
    <button class="btn btn-cta" type="button" onclick="document.getElementById('atc').scrollIntoView({behavior:'smooth',block:'center'})">{{ section.settings.add_to_cart_label }}</button>
  </div>
</div>

<script>
  var slides=[{% for image in product.images %}'{{ image | image_url: width: 1200 }}'{% unless forloop.last %},{% endunless %}{% endfor %}];
  var gi=0, main=document.getElementById('mainimg'), thumbs=document.querySelectorAll('#thumbs button');
  function galSet(i){if(!slides.length || !main) return;gi=(i+slides.length)%slides.length;main.src=slides[gi];thumbs.forEach(function(b,k){b.classList.toggle('active',k===gi);});}
  function galStep(d){galSet(gi+d);}
  function pick(radioEl){
    var el = radioEl.closest('.variant');
    if(!el) return;
    document.querySelectorAll('#variants .variant').forEach(function(v){v.classList.remove('sel');});
    el.classList.add('sel');
    document.getElementById('barprice').childNodes[0].textContent=el.dataset.price;
    document.getElementById('barname').textContent=el.dataset.name;
  }
  var bar=document.getElementById('buybar');
  window.addEventListener('scroll',function(){if(window.scrollY>640){bar.classList.add('show');}else{bar.classList.remove('show');}},{passive:true});

  // count-up numbers on scroll into view
  (function(){
    var els = document.querySelectorAll('.cu');
    if(!('IntersectionObserver' in window)){ els.forEach(function(e){e.textContent=e.dataset.target+'%';}); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        var el = entry.target, target = parseInt(el.dataset.target,10), start=null, dur=1100;
        function step(ts){
          if(!start) start=ts;
          var p = Math.min((ts-start)/dur,1);
          var eased = 1 - Math.pow(1-p,3);
          el.textContent = Math.round(eased*target) + '%';
          if(p<1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        io.unobserve(el);
      });
    },{threshold:.6});
    els.forEach(function(e){io.observe(e);});
  })();
</script>


</div>

{% schema %}
{
  "name": "WeeWonders Custom PDP",
  "settings": [
    {"type":"text","id":"rating_text","label":"Rating text","default":"Trusted by families"},
    {"type":"text","id":"badge_number","label":"Guarantee badge number","default":"30"},
    {"type":"textarea","id":"badge_text","label":"Guarantee badge text","default":"Day money-back guarantee"},
    {"type":"text","id":"add_to_cart_label","label":"Add to cart label","default":"Add to cart"},
    {"type":"text","id":"sold_out_label","label":"Sold out label","default":"Sold out"},
    {"type":"text","id":"guarantee_title","label":"Guarantee title","default":"Shop with confidence"},
    {"type":"text","id":"guarantee_text","label":"Guarantee text","default":"Secure checkout and dedicated support."},
    {"type":"text","id":"details_heading","label":"Details heading","default":"Product details"}
  ]
}
{% endschema %}



