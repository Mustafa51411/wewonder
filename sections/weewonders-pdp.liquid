<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
<style>
  #WeeWondersPdp-{{ section.id }}{
    --mist:#F4F6F7; --navy:#1A2B3C; --ink:#22323F; --muted:#5C6B77;
    --blue:#3FA9DE; --sky:#8FD9F5; --sky-soft:#EAF6FC; --sky-soft2:#F5FBFD;
    --white:#fff; --line:#E3EEF4;
    --good:#2E9E66; --bad:#D6493F; --star:var(--blue);
    --fd:'Baloo 2','Nunito Sans',system-ui,sans-serif; --fb:'Nunito Sans',system-ui,-apple-system,sans-serif;
    --wrap:1200px; --shadow:0 18px 50px -22px rgba(26,43,60,.28);
  }
  #WeeWondersPdp-{{ section.id }} *{box-sizing:border-box;margin:0;padding:0}
  #WeeWondersPdp-{{ section.id }}{scroll-behavior:smooth;font-family:var(--fb);color:var(--ink);background:var(--white);line-height:1.5;font-size:16.5px;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  #WeeWondersPdp-{{ section.id }} h1, #WeeWondersPdp-{{ section.id }} h2, #WeeWondersPdp-{{ section.id }} h3, #WeeWondersPdp-{{ section.id }} .dsp{font-family:var(--fd);color:var(--navy);line-height:1.08;font-weight:700;letter-spacing:-.01em}
  #WeeWondersPdp-{{ section.id }} h2{font-size:clamp(1.6rem,3.3vw,2.5rem)}#WeeWondersPdp-{{ section.id }} h3{font-size:1.15rem}
  #WeeWondersPdp-{{ section.id }} p{max-width:60ch}#WeeWondersPdp-{{ section.id }} img{max-width:100%;display:block}#WeeWondersPdp-{{ section.id }} a{color:var(--blue);text-decoration:none}
  #WeeWondersPdp-{{ section.id }} .wrap{max-width:var(--wrap);margin:0 auto;padding:0 20px}
  #WeeWondersPdp-{{ section.id }} .section{padding:64px 0;position:relative;border-top:1px solid var(--line)}#WeeWondersPdp-{{ section.id }} .section:first-of-type{border-top:0}#WeeWondersPdp-{{ section.id }} .center{text-align:center}#WeeWondersPdp-{{ section.id }} .center p{margin-inline:auto}
  #WeeWondersPdp-{{ section.id }} .eyebrow{font-family:var(--fb);font-weight:800;color:var(--blue);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:9px}
  #WeeWondersPdp-{{ section.id }} .lead{font-size:1.04rem;color:var(--muted)}
  #WeeWondersPdp-{{ section.id }} .stars{color:var(--star);letter-spacing:1px}
  #WeeWondersPdp-{{ section.id }} .hl{background:linear-gradient(180deg,rgba(143,217,245,0) 56%, rgba(143,217,245,.65) 56%);padding:0 .1em;border-radius:2px}
  #WeeWondersPdp-{{ section.id }} .hl-sky{background:linear-gradient(180deg,rgba(143,217,245,0) 56%, rgba(255,255,255,.28) 56%);padding:0 .1em;border-radius:2px}
  #WeeWondersPdp-{{ section.id }} .hl-navy{color:var(--navy);font-weight:800}
  #WeeWondersPdp-{{ section.id }} .giant-hl{display:inline-block;font-size:1.5em;line-height:1;background:linear-gradient(180deg,rgba(143,217,245,0) 58%, rgba(143,217,245,.7) 58%);padding:0 .08em}
  #WeeWondersPdp-{{ section.id }} .wave-div{display:block;width:100%;height:44px;margin-bottom:-2px;position:relative;z-index:2}

  #WeeWondersPdp-{{ section.id }} .ph{background:#eef5f8;border:1.5px dashed #c8dae2;border-radius:16px;display:grid;place-items:center;color:#8ba3ae;font-weight:700;font-size:.78rem;text-align:center;gap:4px;padding:12px;min-height:120px}
  #WeeWondersPdp-{{ section.id }} .ph::before{content:"🖼";font-size:1.35rem}
  #WeeWondersPdp-{{ section.id }} .ph.video::before{content:"▶";font-size:1.5rem;color:#8ba3ae}
  #WeeWondersPdp-{{ section.id }} .ph.av{min-height:0;width:52px;height:52px;border-radius:50%;flex:0 0 52px;padding:0;font-size:0}
  #WeeWondersPdp-{{ section.id }} .ph.av::before{font-size:1.1rem}
  #WeeWondersPdp-{{ section.id }} .ph.sq{aspect-ratio:1/1}#WeeWondersPdp-{{ section.id }} .ph.wide{aspect-ratio:16/9}#WeeWondersPdp-{{ section.id }} .ph.shot{aspect-ratio:9/16}#WeeWondersPdp-{{ section.id }} .ph.tall{aspect-ratio:4/5}

  #WeeWondersPdp-{{ section.id }} .btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:700;font-size:1.02rem;padding:17px 28px;border-radius:14px;border:0;cursor:pointer;transition:transform .12s,background .2s;letter-spacing:.02em}
  #WeeWondersPdp-{{ section.id }} .btn-cta{background:var(--navy);color:#fff;box-shadow:0 14px 28px -14px rgba(26,43,60,.55)}
  #WeeWondersPdp-{{ section.id }} .btn-cta:hover{background:#0F1C28;transform:translateY(-2px)}
  #WeeWondersPdp-{{ section.id }} .btn-lg{padding:19px 34px;font-size:1.08rem;width:100%}
  #WeeWondersPdp-{{ section.id }} .btn:focus-visible{outline:3px solid var(--sky);outline-offset:3px}

  #WeeWondersPdp-{{ section.id }} .topbar{background:var(--navy);color:#dfeaf3;font-size:.84rem;font-weight:600;text-align:center;padding:9px 14px}
  #WeeWondersPdp-{{ section.id }} .topbar span{opacity:.5;margin:0 9px}
  #WeeWondersPdp-{{ section.id }} .head{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  #WeeWondersPdp-{{ section.id }} .head .wrap{display:flex;align-items:center;justify-content:space-between;padding:12px 20px}
  #WeeWondersPdp-{{ section.id }} .head img{height:28px;width:auto}#WeeWondersPdp-{{ section.id }} .head nav{display:flex;gap:24px;font-weight:600;font-size:.92rem}#WeeWondersPdp-{{ section.id }} .head nav a{color:var(--ink)}
  #WeeWondersPdp-{{ section.id }} .head .rate{display:flex;align-items:center;gap:6px;font-weight:700;color:var(--navy)}

  #WeeWondersPdp-{{ section.id }} /* ATF */
