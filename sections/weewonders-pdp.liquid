{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ww-product-form-' | append: section.id
%}

<section id="ww-product-{{ section.id }}" class="ww-product" data-section-id="{{ section.id }}">
  <style>
    #ww-product-{{ section.id }} {
      --ww-navy: {{ section.settings.color_navy }};
      --ww-blue: {{ section.settings.color_accent }};
      --ww-bg: {{ section.settings.color_surface }};
      --ww-line: #dbe8ee;
      --ww-ink: #1f3040;
      --ww-muted: #647783;
      --ww-radius: 22px;
      background: #fff;
      color: var(--ww-ink);
      font-family: var(--font-body-family, inherit);
    }
    #ww-product-{{ section.id }} * { box-sizing: border-box; }
    #ww-product-{{ section.id }} .wwp-shell { width: min(1200px, calc(100% - 40px)); margin: 0 auto; }
    #ww-product-{{ section.id }} .wwp-main { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr); gap: clamp(30px, 6vw, 72px); padding: clamp(30px, 5vw, 68px) 0; align-items: start; }
    #ww-product-{{ section.id }} .wwp-gallery { position: sticky; top: 24px; }
    #ww-product-{{ section.id }} .wwp-stage { position: relative; overflow: hidden; aspect-ratio: 1; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: var(--ww-bg); }
    #ww-product-{{ section.id }} .wwp-stage img { display: block; width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; }
    #ww-product-{{ section.id }} .wwp-empty { display: grid; height: 100%; place-items: center; padding: 24px; color: var(--ww-muted); text-align: center; }
    #ww-product-{{ section.id }} .wwp-nav { position: absolute; inset: 50% 14px auto; display: flex; justify-content: space-between; pointer-events: none; }
    #ww-product-{{ section.id }} .wwp-nav button { pointer-events: auto; width: 42px; height: 42px; border: 1px solid var(--ww-line); border-radius: 50%; background: rgba(255,255,255,.94); color: var(--ww-navy); cursor: pointer; font-size: 26px; line-height: 1; }
    #ww-product-{{ section.id }} .wwp-thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; scrollbar-width: thin; }
    #ww-product-{{ section.id }} .wwp-thumb { flex: 0 0 70px; height: 70px; padding: 0; overflow: hidden; border: 2px solid transparent; border-radius: 12px; background: var(--ww-bg); cursor: pointer; }
    #ww-product-{{ section.id }} .wwp-thumb[aria-current="true"] { border-color: var(--ww-navy); }
    #ww-product-{{ section.id }} .wwp-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
    #ww-product-{{ section.id }} .wwp-eyebrow { margin: 0 0 9px; color: var(--ww-blue); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    #ww-product-{{ section.id }} .wwp-title { margin: 0; color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: clamp(32px, 4vw, 52px); line-height: 1.06; letter-spacing: -.035em; }
    #ww-product-{{ section.id }} .wwp-summary { margin: 15px 0 0; color: var(--ww-muted); font-size: 17px; line-height: 1.6; }
    #ww-product-{{ section.id }} .wwp-price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: 22px 0; }
    #ww-product-{{ section.id }} .wwp-price { color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: 30px; font-weight: 800; }
    #ww-product-{{ section.id }} .wwp-compare { color: #a95858; font-size: 16px; font-weight: 700; text-decoration: line-through; }
    #ww-product-{{ section.id }} .wwp-save { border-radius: 999px; background: #eaf7ef; color: #16754d; padding: 4px 9px; font-size: 12px; font-weight: 800; }
    #ww-product-{{ section.id }} .wwp-option { margin: 15px 0; }
    #ww-product-{{ section.id }} .wwp-option label { display: block; margin-bottom: 7px; color: var(--ww-navy); font-size: 14px; font-weight: 800; }
    #ww-product-{{ section.id }} .wwp-option select { width: 100%; min-height: 50px; padding: 10px 42px 10px 14px; border: 1px solid var(--ww-line); border-radius: 12px; background: #fff; color: var(--ww-ink); font: inherit; }
    #ww-product-{{ section.id }} .wwp-variants { display: grid; gap: 10px; margin: 16px 0; }
    #ww-product-{{ section.id }} .wwp-variant { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 82px; padding: 10px; border: 2px solid var(--ww-line); border-radius: 16px; background: linear-gradient(140deg, #fff, var(--ww-bg)); cursor: pointer; transition: border-color .16s ease, box-shadow .16s ease; }
    #ww-product-{{ section.id }} .wwp-variant.is-selected { border-color: var(--ww-navy); box-shadow: 5px 5px 0 var(--ww-blue); }
    #ww-product-{{ section.id }} .wwp-variant.is-unavailable { opacity: .5; cursor: not-allowed; }
    #ww-product-{{ section.id }} .wwp-variant img { width: 58px; height: 58px; object-fit: contain; border-radius: 10px; background: #fff; }
    #ww-product-{{ section.id }} .wwp-variant-title { color: var(--ww-navy); font-weight: 800; }
    #ww-product-{{ section.id }} .wwp-variant-note { margin-top: 3px; color: var(--ww-muted); font-size: 12px; }
    #ww-product-{{ section.id }} .wwp-variant-price { color: var(--ww-navy); font-weight: 850; white-space: nowrap; }
    #ww-product-{{ section.id }} .wwp-submit { width: 100%; min-height: 58px; border: 0; border-radius: 14px; background: var(--ww-navy); color: #fff; cursor: pointer; font: inherit; font-size: 17px; font-weight: 850; transition: transform .16s ease, opacity .16s ease; }
    #ww-product-{{ section.id }} .wwp-submit:hover { transform: translateY(-1px); }
    #ww-product-{{ section.id }} .wwp-submit:disabled { cursor: not-allowed; opacity: .5; transform: none; }
    #ww-product-{{ section.id }} .wwp-stock { min-height: 20px; margin: 9px 0 0; color: var(--ww-muted); font-size: 13px; font-weight: 700; }
    #ww-product-{{ section.id }} .wwp-benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--ww-line); }
    #ww-product-{{ section.id }} .wwp-benefit { color: var(--ww-muted); font-size: 12px; font-weight: 700; text-align: center; }
    #ww-product-{{ section.id }} .wwp-benefit strong { display: block; margin-bottom: 3px; color: var(--ww-navy); font-size: 14px; }
    #ww-product-{{ section.id }} .wwp-details { border-top: 1px solid var(--ww-line); background: linear-gradient(180deg, #fff, var(--ww-bg)); padding: clamp(40px, 6vw, 80px) 0; }
    #ww-product-{{ section.id }} .wwp-details-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .75fr); gap: clamp(30px, 6vw, 86px); }
    #ww-product-{{ section.id }} .wwp-details h2 { margin: 0 0 16px; color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: clamp(28px, 3vw, 42px); line-height: 1.1; letter-spacing: -.03em; }
    #ww-product-{{ section.id }} .wwp-rte { color: var(--ww-muted); line-height: 1.7; }
    #ww-product-{{ section.id }} .wwp-rte > *:first-child { margin-top: 0; }
    #ww-product-{{ section.id }} details { border-bottom: 1px solid var(--ww-line); }
    #ww-product-{{ section.id }} summary { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; color: var(--ww-navy); cursor: pointer; font-size: 16px; font-weight: 800; list-style: none; }
    #ww-product-{{ section.id }} summary::-webkit-details-marker { display: none; }
    #ww-product-{{ section.id }} summary::after { content: '+'; color: var(--ww-blue); font-size: 22px; line-height: .85; }
    #ww-product-{{ section.id }} details[open] summary::after { content: '−'; }
    #ww-product-{{ section.id }} .wwp-answer { padding: 0 0 16px; color: var(--ww-muted); line-height: 1.65; }
    #ww-product-{{ section.id }} .wwp-section { padding: clamp(44px, 7vw, 92px) 0; border-top: 1px solid var(--ww-line); }
    #ww-product-{{ section.id }} .wwp-section--soft { background: var(--ww-bg); }
    #ww-product-{{ section.id }} .wwp-section--dark { background: var(--ww-navy); color: #fff; }
    #ww-product-{{ section.id }} .wwp-section-head { max-width: 680px; margin: 0 auto 30px; text-align: center; }
    #ww-product-{{ section.id }} .wwp-section-head h2 { margin: 0; color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: clamp(28px, 3vw, 42px); line-height: 1.1; letter-spacing: -.03em; }
    #ww-product-{{ section.id }} .wwp-section--dark .wwp-section-head h2 { color: #fff; }
    #ww-product-{{ section.id }} .wwp-section-head p { margin: 11px auto 0; color: var(--ww-muted); line-height: 1.6; }
    #ww-product-{{ section.id }} .wwp-section--dark .wwp-section-head p { color: #d1e3ee; }
    #ww-product-{{ section.id }} .wwp-grid { display: grid; gap: 16px; }
    #ww-product-{{ section.id }} .wwp-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #ww-product-{{ section.id }} .wwp-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #ww-product-{{ section.id }} .wwp-quote { min-height: 185px; padding: 22px; border: 1px solid var(--ww-line); border-radius: 18px; background: #fff; }
    #ww-product-{{ section.id }} .wwp-quote-stars { color: var(--ww-blue); letter-spacing: 1px; font-size: 14px; }
    #ww-product-{{ section.id }} .wwp-quote-text { margin: 14px 0; color: var(--ww-ink); line-height: 1.6; }
    #ww-product-{{ section.id }} .wwp-quote-name { color: var(--ww-navy); font-size: 14px; font-weight: 800; }
    #ww-product-{{ section.id }} .wwp-media { overflow: hidden; aspect-ratio: 4 / 5; border-radius: 18px; background: #edf5f8; }
    #ww-product-{{ section.id }} .wwp-media img { width: 100%; height: 100%; object-fit: cover; }
    #ww-product-{{ section.id }} .wwp-stat { padding: 16px; text-align: center; }
    #ww-product-{{ section.id }} .wwp-stat-value { display: block; color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: clamp(30px, 4vw, 48px); font-weight: 850; line-height: 1; }
    #ww-product-{{ section.id }} .wwp-stat-label { display: block; margin-top: 10px; color: var(--ww-blue); font-size: 12px; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
    #ww-product-{{ section.id }} .wwp-feature-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, .85fr); gap: clamp(28px, 6vw, 80px); align-items: center; }
    #ww-product-{{ section.id }} .wwp-feature-image { overflow: hidden; aspect-ratio: 4 / 5; border-radius: var(--ww-radius); background: #edf5f8; }
    #ww-product-{{ section.id }} .wwp-feature-image img { width: 100%; height: 100%; object-fit: cover; }
    #ww-product-{{ section.id }} .wwp-feature-list { display: grid; gap: 12px; }
    #ww-product-{{ section.id }} .wwp-feature-item { display: flex; gap: 12px; padding: 16px; border-radius: 14px; background: #fff; box-shadow: 0 8px 22px rgba(26,43,60,.06); }
    #ww-product-{{ section.id }} .wwp-feature-icon { color: var(--ww-blue); font-weight: 900; }
    #ww-product-{{ section.id }} .wwp-feature-item strong { display: block; color: var(--ww-navy); margin-bottom: 3px; }
    #ww-product-{{ section.id }} .wwp-feature-item span { color: var(--ww-muted); font-size: 14px; line-height: 1.5; }
    #ww-product-{{ section.id }} .wwp-timeline { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
    #ww-product-{{ section.id }} .wwp-timeline-card { position: relative; padding: 18px 14px; border: 1px solid var(--ww-line); border-radius: 16px; background: #fff; text-align: center; }
    #ww-product-{{ section.id }} .wwp-timeline-step { display: inline-grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: var(--ww-blue); color: #fff; font-size: 13px; font-weight: 850; }
    #ww-product-{{ section.id }} .wwp-timeline-card h3 { margin: 12px 0 6px; color: var(--ww-navy); font-size: 16px; }
    #ww-product-{{ section.id }} .wwp-timeline-card p { margin: 0; color: var(--ww-muted); font-size: 13px; line-height: 1.5; }
    #ww-product-{{ section.id }} .wwp-comparison { overflow: hidden; max-width: 920px; margin: 0 auto; border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: #fff; }
    #ww-product-{{ section.id }} .wwp-comparison img { display: block; width: 100%; height: auto; }
    #ww-product-{{ section.id }} .wwp-guarantee { display: flex; max-width: 760px; margin: 0 auto; align-items: center; gap: 20px; padding: 26px; border-radius: var(--ww-radius); background: #fff; color: var(--ww-ink); }
    #ww-product-{{ section.id }} .wwp-guarantee-badge { display: grid; flex: 0 0 78px; width: 78px; height: 78px; place-items: center; border-radius: 50%; background: var(--ww-blue); color: var(--ww-navy); font-size: 24px; font-weight: 900; }
    #ww-product-{{ section.id }} .wwp-guarantee h3 { margin: 0 0 5px; color: var(--ww-navy); font-size: 20px; }
    #ww-product-{{ section.id }} .wwp-guarantee p { margin: 0; color: var(--ww-muted); line-height: 1.55; }
    #ww-product-{{ section.id }} .wwp-claim { max-width: 860px; margin: 0 auto; text-align: center; }
    #ww-product-{{ section.id }} .wwp-claim small { display: block; color: #b8d8e8; font-weight: 700; }
    #ww-product-{{ section.id }} .wwp-claim h2 { margin: 8px 0 0; color: #fff; font-family: var(--font-heading-family, inherit); font-size: clamp(32px, 4vw, 54px); letter-spacing: -.04em; }
    #ww-product-{{ section.id }} .wwp-claim mark { padding: 0 .12em; background: var(--ww-blue); color: var(--ww-navy); }
    #ww-product-{{ section.id }} .wwp-video { overflow: hidden; border: 1px solid var(--ww-line); border-radius: 16px; background: #edf5f8; aspect-ratio: 16 / 9; }
    #ww-product-{{ section.id }} .wwp-video video { display: block; width: 100%; height: 100%; object-fit: cover; }
    #ww-product-{{ section.id }} .wwp-repeat { max-width: 670px; margin: 0 auto; padding: clamp(24px, 5vw, 42px); border: 1px solid var(--ww-line); border-radius: var(--ww-radius); background: #fff; text-align: center; box-shadow: 0 12px 35px rgba(26,43,60,.08); }
    #ww-product-{{ section.id }} .wwp-repeat h2 { margin: 0 0 10px; color: var(--ww-navy); font-family: var(--font-heading-family, inherit); font-size: clamp(26px, 3vw, 38px); }
    #ww-product-{{ section.id }} .wwp-repeat p { margin: 0 0 20px; color: var(--ww-muted); }
    #ww-product-{{ section.id }} .wwp-repeat .wwp-button { max-width: 360px; margin: 0 auto; }
    @media (max-width: 900px) {
      #ww-product-{{ section.id }} .wwp-main, #ww-product-{{ section.id }} .wwp-details-grid { grid-template-columns: 1fr; }
      #ww-product-{{ section.id }} .wwp-gallery { position: static; }
    }
    @media (max-width: 640px) {
      #ww-product-{{ section.id }} .wwp-shell { width: min(100% - 28px, 1200px); }
      #ww-product-{{ section.id }} .wwp-main { gap: 28px; padding: 24px 0 38px; }
      #ww-product-{{ section.id }} .wwp-stage { border-radius: 18px; }
      #ww-product-{{ section.id }} .wwp-thumb { flex-basis: 58px; height: 58px; }
      #ww-product-{{ section.id }} .wwp-title { font-size: 34px; }
      #ww-product-{{ section.id }} .wwp-summary { font-size: 16px; }
      #ww-product-{{ section.id }} .wwp-variant { grid-template-columns: 50px minmax(0, 1fr) auto; min-height: 72px; }
      #ww-product-{{ section.id }} .wwp-variant img { width: 50px; height: 50px; }
      #ww-product-{{ section.id }} .wwp-benefits { grid-template-columns: 1fr; }
      #ww-product-{{ section.id }} .wwp-benefit { text-align: left; }
      #ww-product-{{ section.id }} .wwp-benefit strong { display: inline; margin-right: 5px; }
      #ww-product-{{ section.id }} .wwp-grid--3, #ww-product-{{ section.id }} .wwp-grid--4, #ww-product-{{ section.id }} .wwp-timeline { grid-template-columns: 1fr 1fr; }
      #ww-product-{{ section.id }} .wwp-feature-grid { grid-template-columns: 1fr; }
      #ww-product-{{ section.id }} .wwp-guarantee { align-items: flex-start; padding: 20px; }
      #ww-product-{{ section.id }} .wwp-video-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="wwp-shell wwp-main">
    <div class="wwp-gallery">
      <div class="wwp-stage">
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1400', class: 'wwp-main-image' }}
        {% else %}
          <div class="wwp-empty">{{ 'products.product.media.no_media' | t }}</div>
        {% endif %}
        {% if product.images.size > 1 %}<div class="wwp-nav"><button type="button" data-ww-prev aria-label="Previous image">‹</button><button type="button" data-ww-next aria-label="Next image">›</button></div>{% endif %}
      </div>
      {% if product.images.size > 1 %}<div class="wwp-thumbs" aria-label="{{ product.title }} media">{% for image in product.images %}<button class="wwp-thumb" type="button" data-ww-thumb data-src="{{ image | image_url: width: 1400 }}" data-alt="{{ image.alt | default: product.title | escape }}" aria-current="{% if image.id == product.featured_image.id %}true{% else %}false{% endif %}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160' }}</button>{% endfor %}</div>{% endif %}
    </div>
    <div class="wwp-info">
      {% if product.vendor != blank %}<p class="wwp-eyebrow">{{ product.vendor }}</p>{% endif %}
      <h1 class="wwp-title">{{ product.title }}</h1>
      {% if product.description != blank %}<p class="wwp-summary">{{ product.description | strip_html | truncatewords: 28 }}</p>{% endif %}
      <div class="wwp-price-row"><span class="wwp-price" data-ww-price>{{ current_variant.price | money }}</span><s class="wwp-compare" data-ww-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</s><span class="wwp-save" data-ww-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}%{% endif %}</span></div>
      {% form 'product', product, id: product_form_id %}
        {% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<div class="wwp-option"><label for="wwp-option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label><select id="wwp-option-{{ section.id }}-{{ forloop.index0 }}" data-ww-option>{% for value in option.values %}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>{% endfor %}{% endunless %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-ww-variant-id>
        <div class="wwp-variants">{% for variant in product.variants %}{% assign variant_image = variant.featured_image | default: product.featured_image %}<button class="wwp-variant{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-unavailable{% endunless %}" type="button" data-ww-variant-card="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{% if variant_image != blank %}{{ variant_image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '75, 150' }}{% else %}<span></span>{% endif %}<span><span class="wwp-variant-title">{{ variant.title }}</span>{% unless variant.available %}<span class="wwp-variant-note">{{ section.settings.sold_out_label }}</span>{% endunless %}</span><span class="wwp-variant-price">{{ variant.price | money }}</span></button>{% endfor %}</div>
        <button class="wwp-submit" type="submit" data-ww-submit {% unless current_variant.available %}disabled{% endunless %}><span data-ww-submit-label>{% if current_variant.available %}{{ section.settings.add_to_cart_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span></button>
        <p class="wwp-stock" data-ww-stock>{% if current_variant.available %}{{ section.settings.in_stock_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</p>
      {% endform %}
      <div class="wwp-benefits">{% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="wwp-benefit" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>{% endif %}{% endfor %}</div>
    </div>
  </div>

  {% assign quote_blocks = section.blocks | where: 'type', 'quote' %}
  {% if quote_blocks.size > 0 %}
    <div class="wwp-section wwp-section--soft"><div class="wwp-shell"><div class="wwp-section-head"><h2>{{ section.settings.quotes_heading }}</h2></div><div class="wwp-grid wwp-grid--{{ section.settings.quotes_columns }}">{% for block in quote_blocks %}<article class="wwp-quote" {{ block.shopify_attributes }}><div class="wwp-quote-stars">★★★★★</div><p class="wwp-quote-text">{{ block.settings.text }}</p><span class="wwp-quote-name">{{ block.settings.name }}</span></article>{% endfor %}</div></div></div>
  {% endif %}

  {% if product.images.size > 1 %}
    <div class="wwp-section"><div class="wwp-shell"><div class="wwp-section-head"><h2>{{ section.settings.media_heading }}</h2></div><div class="wwp-grid wwp-grid--{{ section.settings.media_columns }}">{% for image in product.images limit: section.settings.media_limit %}<div class="wwp-media">{{ image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700' }}</div>{% endfor %}</div></div></div>
  {% endif %}

  {% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
  {% if stat_blocks.size > 0 %}
    <div class="wwp-section wwp-section--soft"><div class="wwp-shell"><div class="wwp-grid wwp-grid--4">{% for block in stat_blocks %}<div class="wwp-stat" {{ block.shopify_attributes }}><span class="wwp-stat-value">{{ block.settings.value }}</span><span class="wwp-stat-label">{{ block.settings.label }}</span></div>{% endfor %}</div></div></div>
  {% endif %}

  {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
  {% if feature_blocks.size > 0 or section.settings.feature_image != blank %}
    <div class="wwp-section"><div class="wwp-shell wwp-feature-grid"><div class="wwp-feature-image">{% if section.settings.feature_image != blank %}{{ section.settings.feature_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100' }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900' }}{% endif %}</div><div><div class="wwp-section-head" style="margin:0 0 22px;text-align:left"><h2>{{ section.settings.features_heading }}</h2><p>{{ section.settings.features_text }}</p></div><div class="wwp-feature-list">{% for block in feature_blocks %}<div class="wwp-feature-item" {{ block.shopify_attributes }}><span class="wwp-feature-icon">✓</span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></div>{% endfor %}</div></div></div></div>
  {% endif %}

  {% assign timeline_blocks = section.blocks | where: 'type', 'timeline' %}
  {% if timeline_blocks.size > 0 %}
    <div class="wwp-section wwp-section--soft"><div class="wwp-shell"><div class="wwp-section-head"><h2>{{ section.settings.timeline_heading }}</h2><p>{{ section.settings.timeline_text }}</p></div><div class="wwp-timeline">{% for block in timeline_blocks %}<article class="wwp-timeline-card" {{ block.shopify_attributes }}><span class="wwp-timeline-step">{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></div>
  {% endif %}

  {% if section.settings.claim_text != blank %}
    <div class="wwp-section wwp-section--dark"><div class="wwp-shell wwp-claim"><small>{{ section.settings.claim_eyebrow }}</small><h2>{{ section.settings.claim_text }}</h2></div></div>
  {% endif %}

  {% assign video_blocks = section.blocks | where: 'type', 'video' %}
  {% if video_blocks.size > 0 %}
    <div class="wwp-section"><div class="wwp-shell"><div class="wwp-section-head"><h2>{{ section.settings.video_heading }}</h2><p>{{ section.settings.video_text }}</p></div><div class="wwp-grid wwp-grid--{{ section.settings.video_columns }} wwp-video-grid">{% for block in video_blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.video != blank %}<div class="wwp-video">{{ block.settings.video | video_tag: controls: true, preload: 'metadata' }}</div>{% endif %}{% if block.settings.title != blank %}<p class="wwp-quote-name" style="margin:10px 0 0">{{ block.settings.title }}</p>{% endif %}</div>{% endfor %}</div></div></div>
  {% endif %}

  {% if section.settings.comparison_image != blank %}
    <div class="wwp-section wwp-section--soft"><div class="wwp-shell"><div class="wwp-section-head"><h2>{{ section.settings.comparison_heading }}</h2></div><div class="wwp-comparison">{{ section.settings.comparison_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400' }}</div></div></div>
  {% endif %}

  <div class="wwp-details">
    <div class="wwp-shell wwp-details-grid">
      <div>
        <h2>{{ section.settings.details_heading }}</h2>
        <div class="wwp-rte">{{ product.description }}</div>
      </div>
      <div>
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="wwp-answer">{{ block.settings.answer }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% if section.settings.guarantee_heading != blank %}
    <div class="wwp-section wwp-section--dark"><div class="wwp-shell"><div class="wwp-guarantee"><div class="wwp-guarantee-badge">{{ section.settings.guarantee_badge }}</div><div><h3>{{ section.settings.guarantee_heading }}</h3><p>{{ section.settings.guarantee_text }}</p></div></div></div></div>
  {% endif %}

  {% if product.available %}
    <div class="wwp-section"><div class="wwp-shell"><div class="wwp-repeat"><h2>{{ section.settings.repeat_heading }}</h2><p>{{ section.settings.repeat_text }}</p><a class="wwp-button wwp-button--primary" href="#ww-product-{{ section.id }}">{{ section.settings.repeat_label }}</a></div></div></div>
  {% endif %}

  <script type="application/json" data-ww-variants>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.getElementById('ww-product-{{ section.id }}');
      if (!root || root.dataset.initialized) return;
      root.dataset.initialized = 'true';
      const variants = JSON.parse(root.querySelector('[data-ww-variants]').textContent);
      const selectors = [...root.querySelectorAll('[data-ww-option]')];
      const idInput = root.querySelector('[data-ww-variant-id]');
      const price = root.querySelector('[data-ww-price]');
      const compare = root.querySelector('[data-ww-compare]');
      const save = root.querySelector('[data-ww-save]');
      const submit = root.querySelector('[data-ww-submit]');
      const label = root.querySelector('[data-ww-submit-label]');
      const stock = root.querySelector('[data-ww-stock]');
      const cards = [...root.querySelectorAll('[data-ww-variant-card]')];
      const galleryImage = root.querySelector('.wwp-main-image');
      const currency = {{ shop.currency | json }};
      const money = cents => new Intl.NumberFormat(undefined, {style: 'currency', currency}).format(cents / 100);
      const applyVariant = variant => {
        if (!variant) return;
        idInput.value = variant.id;
        price.textContent = money(variant.price);
        const onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
        compare.hidden = !onSale;
        save.hidden = !onSale;
        if (onSale) {
          compare.textContent = money(variant.compare_at_price);
          save.textContent = 'Save ' + Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price) + '%';
        }
        submit.disabled = !variant.available;
        label.textContent = variant.available ? {{ section.settings.add_to_cart_label | json }} : {{ section.settings.sold_out_label | json }};
        stock.textContent = variant.available ? {{ section.settings.in_stock_label | json }} : {{ section.settings.sold_out_label | json }};
        cards.forEach(card => card.classList.toggle('is-selected', Number(card.dataset.wwVariantCard) === variant.id));
        if (variant.featured_image && galleryImage) galleryImage.src = variant.featured_image.src;
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url);
      };
      selectors.forEach(select => select.addEventListener('change', () => {
        const values = selectors.map(item => item.value);
        applyVariant(variants.find(variant => variant.options.every((value, index) => value === values[index])));
      }));
      cards.forEach(card => card.addEventListener('click', () => {
        const variant = variants.find(item => item.id === Number(card.dataset.wwVariantCard));
        if (!variant || !variant.available) return;
        selectors.forEach((select, index) => { select.value = variant.options[index]; });
        applyVariant(variant);
      }));
      const thumbs = [...root.querySelectorAll('[data-ww-thumb]')];
      let index = Math.max(0, thumbs.findIndex(thumb => thumb.getAttribute('aria-current') === 'true'));
      const showImage = next => {
        if (!galleryImage || !thumbs.length) return;
        index = (next + thumbs.length) % thumbs.length;
        const thumb = thumbs[index];
        galleryImage.src = thumb.dataset.src;
        galleryImage.alt = thumb.dataset.alt;
        thumbs.forEach((item, i) => item.setAttribute('aria-current', String(i === index)));
      };
      root.querySelector('[data-ww-prev]')?.addEventListener('click', () => showImage(index - 1));
      root.querySelector('[data-ww-next]')?.addEventListener('click', () => showImage(index + 1));
      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => showImage(i)));
    })();
  </script>
</section>

{% schema %}
{
  "name": "WeeWonders product page",
  "settings": [
    {"type":"text","id":"details_heading","label":"Details heading","default":"Product details"},
    {"type":"text","id":"quotes_heading","label":"Reviews heading","default":"Loved by families"},
    {"type":"select","id":"quotes_columns","label":"Review columns","default":"3","options":[{"value":"3","label":"3 columns"},{"value":"4","label":"4 columns"}]},
    {"type":"text","id":"media_heading","label":"Product media heading","default":"See it in detail"},
    {"type":"select","id":"media_columns","label":"Product media columns","default":"4","options":[{"value":"3","label":"3 columns"},{"value":"4","label":"4 columns"}]},
    {"type":"range","id":"media_limit","label":"Product media limit","min":2,"max":8,"step":1,"default":4},
    {"type":"text","id":"features_heading","label":"Features heading","default":"Designed for everyday use"},
    {"type":"textarea","id":"features_text","label":"Features intro","default":"Add product-specific benefits from the Theme Editor."},
    {"type":"image_picker","id":"feature_image","label":"Features image"},
    {"type":"text","id":"timeline_heading","label":"Timeline heading","default":"What to expect"},
    {"type":"textarea","id":"timeline_text","label":"Timeline intro","default":"Add your product journey or usage steps."},
    {"type":"text","id":"claim_eyebrow","label":"Dark statement eyebrow","default":"The simple rule"},
    {"type":"inline_richtext","id":"claim_text","label":"Dark statement","default":"Make the benefit <mark>stand out</mark>"},
    {"type":"text","id":"video_heading","label":"Video section heading","default":"See it in action"},
    {"type":"textarea","id":"video_text","label":"Video section intro","default":"Add real product or customer videos from the Theme Editor."},
    {"type":"select","id":"video_columns","label":"Video columns","default":"3","options":[{"value":"3","label":"3 columns"},{"value":"4","label":"4 columns"}]},
    {"type":"text","id":"comparison_heading","label":"Comparison heading","default":"The WeeWonders difference"},
    {"type":"image_picker","id":"comparison_image","label":"Comparison image"},
    {"type":"text","id":"guarantee_badge","label":"Guarantee badge","default":"30"},
    {"type":"text","id":"guarantee_heading","label":"Guarantee heading","default":"Shop with confidence"},
    {"type":"textarea","id":"guarantee_text","label":"Guarantee text","default":"Add your delivery, warranty, or returns promise here."},
    {"type":"text","id":"repeat_heading","label":"Final call to action heading","default":"Ready when you are"},
    {"type":"textarea","id":"repeat_text","label":"Final call to action text","default":"Choose your options above and add this product to cart."},
    {"type":"text","id":"repeat_label","label":"Final call to action label","default":"Choose options"},
    {"type":"text","id":"add_to_cart_label","label":"Add to cart label","default":"Add to cart"},
    {"type":"text","id":"in_stock_label","label":"In stock label","default":"In stock"},
    {"type":"text","id":"sold_out_label","label":"Sold out label","default":"Sold out"},
    {"type":"select","id":"image_fit","label":"Image fit","default":"contain","options":[{"value":"contain","label":"Contain"},{"value":"cover","label":"Cover"}]},
    {"type":"color","id":"color_navy","label":"Dark color","default":"#1a2b3c"},
    {"type":"color","id":"color_accent","label":"Accent color","default":"#3fa9de"},
    {"type":"color","id":"color_surface","label":"Surface color","default":"#f4f9fb"}
  ],
  "blocks": [
    {"type":"benefit","name":"Purchase benefit","limit":3,"settings":[{"type":"text","id":"title","label":"Title","default":"Fast delivery"},{"type":"text","id":"text","label":"Text","default":"Reliable shipping"}]},
    {"type":"quote","name":"Customer review","settings":[{"type":"text","id":"name","label":"Customer name","default":"Customer"},{"type":"textarea","id":"text","label":"Review","default":"Add a real customer review here."}]},
    {"type":"stat","name":"Statistic","limit":4,"settings":[{"type":"text","id":"value","label":"Value","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Editable statistic"}]},
    {"type":"feature","name":"Product feature","limit":6,"settings":[{"type":"text","id":"title","label":"Title","default":"Product benefit"},{"type":"textarea","id":"text","label":"Text","default":"Add a product-specific benefit here."}]},
    {"type":"timeline","name":"Timeline step","limit":5,"settings":[{"type":"text","id":"title","label":"Title","default":"Step title"},{"type":"textarea","id":"text","label":"Text","default":"Add a step or milestone."}]},
    {"type":"video","name":"Product or customer video","limit":6,"settings":[{"type":"video","id":"video","label":"Video"},{"type":"text","id":"title","label":"Caption","default":"Video caption"}]},
    {"type":"faq","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question","default":"Have a question?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add the answer here.</p>"}]}
  ],
  "presets":[{"name":"WeeWonders product page","blocks":[{"type":"benefit"},{"type":"benefit","settings":{"title":"Quality assured","text":"Made to last"}},{"type":"benefit","settings":{"title":"Support available","text":"We are here to help"}},{"type":"feature"},{"type":"timeline"}]}]
}
{% endschema %}
