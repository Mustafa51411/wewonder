  #WeeWondersPdp-{{ section.id }} .pdp .wrap{display:grid;grid-template-columns:1.15fr 1fr;gap:44px;align-items:start}
  #WeeWondersPdp-{{ section.id }} .gallery{position:sticky;top:76px}
  #WeeWondersPdp-{{ section.id }} .g-main{border-radius:22px;overflow:visible;background:#f2f7f9;border:1px solid var(--line);position:relative;aspect-ratio:1/1}
  #WeeWondersPdp-{{ section.id }} .g-main img{width:100%;height:100%;object-fit:cover;border-radius:22px}
  #WeeWondersPdp-{{ section.id }} .g-main::before{content:"";position:absolute;top:-8%;left:-8%;right:-8%;bottom:-8%;z-index:-1;
    background:radial-gradient(circle, rgba(143,217,245,.5) 0%, rgba(143,217,245,.14) 45%, rgba(143,217,245,0) 70%);border-radius:50%}
  #WeeWondersPdp-{{ section.id }} .g-nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.9);border:1px solid var(--line);display:grid;place-items:center;cursor:pointer;font-size:1.1rem;color:var(--navy)}
  #WeeWondersPdp-{{ section.id }} .g-prev{left:12px}#WeeWondersPdp-{{ section.id }} .g-next{right:12px}
  #WeeWondersPdp-{{ section.id }} /* signature branding element: the scallop badge — reused across the page */
  .scallop{position:relative;width:112px;height:112px;display:grid;place-items:center;filter:drop-shadow(0 10px 20px rgba(26,43,60,.35))}
  #WeeWondersPdp-{{ section.id }} .scallop svg{position:absolute;inset:0;width:100%;height:100%}
  #WeeWondersPdp-{{ section.id }} .scallop .txt{position:relative;z-index:2;text-align:center;font-family:var(--fd);color:#fff;font-weight:700;line-height:1.15;padding:0 14px}
  #WeeWondersPdp-{{ section.id }} .scallop .txt b{display:block;font-size:1.5rem;color:var(--sky);line-height:1}
  #WeeWondersPdp-{{ section.id }} .scallop .txt small{display:block;font-size:.56rem;letter-spacing:.03em;text-transform:uppercase;margin-top:2px}
  #WeeWondersPdp-{{ section.id }} .stamp{position:absolute;z-index:2;transform:rotate(-8deg)}
  #WeeWondersPdp-{{ section.id }} .stamp.s1{left:-20px;bottom:6%}
  #WeeWondersPdp-{{ section.id }} .g-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-top:11px}
  #WeeWondersPdp-{{ section.id }} .g-thumbs button{padding:0;border:2px solid var(--line);border-radius:11px;overflow:hidden;background:#f2f5f7;cursor:pointer;aspect-ratio:1/1}
  #WeeWondersPdp-{{ section.id }} .g-thumbs button.active{border-color:var(--navy)}#WeeWondersPdp-{{ section.id }} .g-thumbs img{width:100%;height:100%;object-fit:cover}
  #WeeWondersPdp-{{ section.id }} .buy .rate{display:flex;align-items:center;gap:9px;font-weight:700;color:var(--navy);font-size:.94rem;flex-wrap:wrap}
  #WeeWondersPdp-{{ section.id }} .buy .rate .en{color:var(--muted);font-weight:600;font-size:.85rem;border-left:1px solid var(--line);padding-left:9px}
  #WeeWondersPdp-{{ section.id }} .buy .plabel{font-weight:800;color:var(--muted);font-size:.85rem;margin:12px 0 2px}
  #WeeWondersPdp-{{ section.id }} .buy h1{font-size:clamp(1.65rem,3vw,2.25rem);font-weight:800}
  #WeeWondersPdp-{{ section.id }} .h1-light{font-weight:500;letter-spacing:0}
  #WeeWondersPdp-{{ section.id }} .buy .promise{font-size:1.06rem;color:var(--muted);margin-top:8px;max-width:44ch}
  #WeeWondersPdp-{{ section.id }} .ksp{list-style:none;margin:18px 0 20px;display:flex;flex-direction:column;gap:12px}
  #WeeWondersPdp-{{ section.id }} .ksp li{display:flex;gap:11px;align-items:center;font-weight:700;color:var(--navy);font-size:1rem}
  #WeeWondersPdp-{{ section.id }} .ksp li .ic{flex:0 0 30px;width:30px;height:30px;display:grid;place-items:center;color:var(--blue)}
  #WeeWondersPdp-{{ section.id }} .specrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:15px 0;margin-bottom:20px}
  #WeeWondersPdp-{{ section.id }} .specrow b{font-family:var(--fd);color:var(--navy);display:block;font-size:1.04rem;line-height:1.1}#WeeWondersPdp-{{ section.id }} .specrow small{color:var(--muted);font-size:.79rem}

  #WeeWondersPdp-{{ section.id }} .variants{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:14px}
  #WeeWondersPdp-{{ section.id }} .variant{border:2px solid var(--line);border-radius:18px;padding:15px 17px;cursor:pointer;position:relative;transition:border-color .15s,background .15s,box-shadow .15s,transform .15s;
    background:linear-gradient(160deg,#fff 0%,var(--mist) 120%);display:flex;gap:14px;align-items:center;box-shadow:0 10px 24px -20px rgba(26,43,60,.35)}
  #WeeWondersPdp-{{ section.id }} .variant:hover{border-color:var(--navy);transform:translateY(-1px)}
  #WeeWondersPdp-{{ section.id }} .variant.sel{border-color:var(--navy);background:#fff;position:relative;
    box-shadow:7px 7px 0 0 var(--sky),14px 14px 0 0 var(--navy),0 20px 34px -10px rgba(26,43,60,.4)}
  #WeeWondersPdp-{{ section.id }} .variant .vimg{width:74px;height:74px;object-fit:contain;flex:0 0 74px}
  #WeeWondersPdp-{{ section.id }} .variant .vbody{flex:1;min-width:0}
  #WeeWondersPdp-{{ section.id }} .variant .vprice{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right;flex:0 0 auto}
  #WeeWondersPdp-{{ section.id }} .variant .vprice .vline{display:flex;align-items:baseline;gap:7px}
  #WeeWondersPdp-{{ section.id }} .variant .vprice .vnow{font-size:1.22rem}
  #WeeWondersPdp-{{ section.id }} .variant .vt{font-family:var(--fd);font-weight:700;color:var(--navy);font-size:1.06rem}
  #WeeWondersPdp-{{ section.id }} .variant .vnow{font-weight:800;color:var(--ink);background:linear-gradient(180deg,rgba(143,217,245,0) 55%, rgba(143,217,245,.55) 55%);padding:0 .06em}
  #WeeWondersPdp-{{ section.id }} .variant .vwas{color:var(--bad);font-weight:700;text-decoration:line-through;font-size:.92rem}
  #WeeWondersPdp-{{ section.id }} .variant .voff{color:var(--good);font-weight:800;font-size:.78rem}
  #WeeWondersPdp-{{ section.id }} .variant .perks{display:flex;flex-direction:column;gap:4px;align-items:flex-end}
  #WeeWondersPdp-{{ section.id }} .variant .pk{font-size:.82rem;font-weight:700;display:flex;gap:6px;align-items:center;color:var(--good)}
  #WeeWondersPdp-{{ section.id }} .variant .pk::before{content:"✓";font-weight:800}
  #WeeWondersPdp-{{ section.id }} .variant .flag{position:absolute;top:-22px;right:-20px;width:52px;height:52px;display:grid;place-items:center;z-index:3;filter:drop-shadow(0 6px 12px rgba(26,43,60,.35))}
  #WeeWondersPdp-{{ section.id }} .variant .flag svg{position:absolute;inset:0;width:100%;height:100%}
  #WeeWondersPdp-{{ section.id }} .variant .flag span{position:relative;color:#fff;font-family:var(--fd);font-weight:700;font-size:.52rem;line-height:1.05;text-align:center;text-transform:uppercase}
  #WeeWondersPdp-{{ section.id }} .gift-note{background:#fff;border:1.4px dashed var(--navy);border-radius:12px;padding:10px 13px;font-size:.85rem;color:var(--navy);font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}

  #WeeWondersPdp-{{ section.id }} .guarbox{margin-top:14px;border:1.6px solid var(--navy);border-radius:16px;padding:14px 16px;display:flex;gap:13px;align-items:center;background:#fff}
  #WeeWondersPdp-{{ section.id }} .guarbox .gi{flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center}
  #WeeWondersPdp-{{ section.id }} .guarbox b{font-family:var(--fd);color:var(--navy);display:block;font-size:.98rem}
  #WeeWondersPdp-{{ section.id }} .guarbox small{color:var(--muted);font-size:.82rem}

  #WeeWondersPdp-{{ section.id }} .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
  #WeeWondersPdp-{{ section.id }} .trust .t{text-align:center;font-size:.75rem;color:var(--muted);font-weight:700}
  #WeeWondersPdp-{{ section.id }} .trust .t .i{width:32px;height:32px;margin:0 auto 5px;border-radius:9px;background:var(--mist);display:grid;place-items:center;color:var(--navy)}

  #WeeWondersPdp-{{ section.id }} /* wave divider */
  .wave{display:block;width:100%;height:64px;margin-bottom:-2px}

  #WeeWondersPdp-{{ section.id }} /* testimonials */
  .wall{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:30px}
  #WeeWondersPdp-{{ section.id }} .wa{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 12px 30px -24px rgba(26,43,60,.4)}
  #WeeWondersPdp-{{ section.id }} .wa .top{display:flex;gap:10px;align-items:center;margin-bottom:10px}
  #WeeWondersPdp-{{ section.id }} .wa .top b{color:var(--navy);font-size:.9rem}#WeeWondersPdp-{{ section.id }} .wa .top .stars{font-size:.78rem;display:block}
  #WeeWondersPdp-{{ section.id }} .wa .tag{font-size:.72rem;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.04em;margin-bottom:7px}
  #WeeWondersPdp-{{ section.id }} .wa p{font-size:.95rem;color:var(--ink)}
  #WeeWondersPdp-{{ section.id }} .shots{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}
  #WeeWondersPdp-{{ section.id }} .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px;border-top:1px solid var(--line);padding-top:28px}
  #WeeWondersPdp-{{ section.id }} .stat{text-align:center}
  #WeeWondersPdp-{{ section.id }} .stat b{font-family:var(--fd);font-size:2.1rem;color:var(--navy);display:block}
  #WeeWondersPdp-{{ section.id }} .stat span{font-weight:800;color:var(--blue);display:inline-block;margin-top:6px;font-size:.86rem;text-transform:uppercase;letter-spacing:.04em;border-bottom:3px solid var(--sky);padding-bottom:2px}
  #WeeWondersPdp-{{ section.id }} .stat small{display:block;color:var(--muted);font-size:.74rem;margin-top:6px}

  #WeeWondersPdp-{{ section.id }} /* PATTERN-INTERRUPT: big claim section */
  .claim{background:var(--navy);color:#fff;padding:88px 0 0;text-align:center;overflow:visible;position:relative;border-top:0}
  #WeeWondersPdp-{{ section.id }} .claim .wrap{padding-bottom:44px}
  #WeeWondersPdp-{{ section.id }} .claim .eyebrow{color:var(--sky)}
  #WeeWondersPdp-{{ section.id }} .claim .lede{font-family:var(--fb);font-weight:700;font-size:1.15rem;color:#cfe6f2;max-width:36ch;margin:0 auto 6px}
  #WeeWondersPdp-{{ section.id }} .claim .big{font-family:var(--fd);font-weight:700;text-transform:capitalize;font-size:clamp(2.6rem,9vw,6rem);line-height:.95;letter-spacing:-.01em;
    color:var(--sky);display:block;margin:8px 0;white-space:nowrap}
  #WeeWondersPdp-{{ section.id }} .claim .conclusion{font-family:var(--fd);font-weight:700;font-size:clamp(1.6rem,3.4vw,2.3rem);margin:40px 0 44px;color:#fff;line-height:1.25}
  #WeeWondersPdp-{{ section.id }} .fm-headline{font-family:var(--fd);font-weight:800;font-size:clamp(1.9rem,4.4vw,3.1rem);text-align:center;margin-top:10px;color:#fff;line-height:1.2}
  #WeeWondersPdp-{{ section.id }} .fm-headline .eq{color:rgba(255,255,255,.45);margin:0 .12em;font-weight:600}
  #WeeWondersPdp-{{ section.id }} .hl-solid{color:var(--navy);background:var(--sky);border-radius:.15em;padding:.02em .12em}
  #WeeWondersPdp-{{ section.id }} .scenario-split{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:52px;max-width:900px;margin-inline:auto}
  #WeeWondersPdp-{{ section.id }} .scenario{position:relative;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:18px;padding:20px;text-align:center}
  #WeeWondersPdp-{{ section.id }} .sc-img{width:100%;height:84px;border-radius:14px;background:rgba(255,255,255,.07);border:1.5px dashed rgba(255,255,255,.32);display:grid;place-items:center;color:rgba(255,255,255,.5);font-family:var(--fb);font-size:.72rem;line-height:1.2;margin-bottom:16px;text-align:center;padding:4px}
  #WeeWondersPdp-{{ section.id }} .sc-badge{position:absolute;top:-16px;font-size:30px;filter:drop-shadow(0 5px 10px rgba(0,0,0,.4));z-index:2}
  #WeeWondersPdp-{{ section.id }} .scenario.neg .sc-badge{left:-10px;transform:rotate(-16deg)}
  #WeeWondersPdp-{{ section.id }} .scenario.pos .sc-badge{right:-10px;transform:rotate(16deg)}
  #WeeWondersPdp-{{ section.id }} .sc-chain{display:flex;flex-direction:column;align-items:center;gap:6px}
  #WeeWondersPdp-{{ section.id }} .sc-step{font-family:var(--fb);font-weight:700;color:#fff;font-size:.96rem}
  #WeeWondersPdp-{{ section.id }} .sc-arrow{color:rgba(255,255,255,.4);font-size:1.1rem;line-height:1}
  #WeeWondersPdp-{{ section.id }} .sc-result{font-family:var(--fd);font-weight:800;font-size:1.32rem;margin-top:4px}
  #WeeWondersPdp-{{ section.id }} .sc-result.bad{color:#a9c1d3}
  #WeeWondersPdp-{{ section.id }} .sc-result.good{color:var(--sky)}
  #WeeWondersPdp-{{ section.id }} .refill{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:52px;max-width:720px;margin-inline:auto}
  #WeeWondersPdp-{{ section.id }} .rc{text-align:left}
  #WeeWondersPdp-{{ section.id }} .rc .lbl{font-family:var(--fd);font-weight:700;font-size:1.05rem;color:#fff}
  #WeeWondersPdp-{{ section.id }} .rc-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  #WeeWondersPdp-{{ section.id }} .drop-ico{display:inline-block;font-size:20px;transform-origin:center;transition:transform .05s linear;filter:drop-shadow(0 4px 8px rgba(0,0,0,.3))}
  #WeeWondersPdp-{{ section.id }} .arrow-tag{font-family:var(--fb);font-weight:700;font-size:.78rem;display:block;margin-top:2px}
  #WeeWondersPdp-{{ section.id }} .arrow-tag.low{color:#a9c1d3}
  #WeeWondersPdp-{{ section.id }} .arrow-tag.high{color:var(--sky)}
  #WeeWondersPdp-{{ section.id }} .rc .bar{height:22px;border-radius:999px;background:rgba(255,255,255,.14);overflow:hidden;position:relative;border:1px solid rgba(255,255,255,.25)}
