<link rel="stylesheet" href="{{ 'ww-pdp.css' | asset_url }}">
<style>@font-face{font-family:Gordita;src:url({{ 'Gordita-Regular.woff2' | asset_url }}) format("woff2");font-weight:400;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Medium.woff2' | asset_url }}) format("woff2");font-weight:500;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Bold.woff2' | asset_url }}) format("woff2");font-weight:700;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Black.woff2' | asset_url }}) format("woff2");font-weight:800 900;font-display:swap}</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<div class="ww-pdp">
<section class="section"><div class="wrap adv">
<div class="float-stage" aria-hidden="true"><svg class="fstar s1" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="3" stroke-linejoin="round"/></svg><svg class="fstar s2" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="3.6" stroke-linejoin="round"/></svg><svg class="fstar s3" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="4" stroke-linejoin="round"/></svg><img class="fpump" src="{%- if section.settings.pump != blank -%}{{ section.settings.pump | image_url: width: 900 }}{%- else -%}{{ 'ww-pump.png' | asset_url }}{%- endif -%}" alt=""><div class="fshadow"></div></div>
<div><h2>{{ section.settings.h_a }} <span class="hl">{{ section.settings.h_b }}</span></h2><div class="adv-list" style="margin-top:22px"><div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M6 15h30v14H6z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="32" height="15" rx="3"/><path d="M9 11v6M15 11v9M21 11v6M27 11v9"/><path d="M8 33h22M8 33l3-2.4M8 33l3 2.4M30 33l-3-2.4M30 33l-3 2.4" stroke-width="1.7"/></g></svg></div><div><b>{{ section.settings.t1 }}</b><small>{{ section.settings.d1 }}</small></div></div><div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 17h7l8-7v22l-8-7H5z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14h6l8-7v26l-8-7H7z"/><path d="M26 15a7 7 0 010 10M30 11.5a12 12 0 010 17" /></g></svg></div><div><b>{{ section.settings.t2 }}</b><small>{{ section.settings.d2 }}</small></div></div><div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 7c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z"/><path d="M14.5 23l3.5 3.5 7-7"/></g></svg></div><div><b>{{ section.settings.t3 }}</b><small>{{ section.settings.d3 }}</small></div></div><div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M22 9c7 0 12 6 12 14 0 8-5 14-12 14S10 31 10 23C10 15 15 9 22 9z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c7 0 12 6 12 14 0 8-5 14-12 14S7 26 7 18C7 10 12 4 19 4z"/><rect x="14" y="9" width="10" height="2.6" rx="1.3"/><path d="M8.5 22h21M12 28c4 2.4 10 2.4 14 0" stroke-width="1.8"/></g></svg></div><div><b>{{ section.settings.t4 }}</b><small>{{ section.settings.d4 }}</small></div></div></div></div>
</div></section>
</div>
{% schema %}
{
 "name": "WW Different (floating pump)",
 "settings": [
  {
   "type": "text",
   "id": "h_a",
   "label": "Heading (plain part)",
   "default": "What makes this one"
  },
  {
   "type": "text",
   "id": "h_b",
   "label": "Heading (highlighted)",
   "default": "different?"
  },
  {
   "type": "image_picker",
   "id": "pump",
   "label": "Floating pump image",
   "info": "Transparent PNG. Empty keeps the current one."
  },
  {
   "type": "text",
   "id": "t1",
   "label": "Point 1 title",
   "default": "Sized to you"
  },
  {
   "type": "textarea",
   "id": "d1",
   "label": "Point 1 text",
   "default": "Comes with 4 flange sizes + a tool, so you never guess your size."
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Point 2 title",
   "default": "Whisper quiet"
  },
  {
   "type": "textarea",
   "id": "d2",
   "label": "Point 2 text",
   "default": "Under 50dB, no one hears it."
  },
  {
   "type": "text",
   "id": "t3",
   "label": "Point 3 title",
   "default": "Leak-proof"
  },
  {
   "type": "textarea",
   "id": "d3",
   "label": "Point 3 text",
   "default": "Seals even upside down."
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Point 4 title",
   "default": "Truly hands-free"
  },
  {
   "type": "textarea",
   "id": "d4",
   "label": "Point 4 text",
   "default": "Wear it while you do anything else."
  }
 ],
 "presets": [
  {
   "name": "WW Different (floating pump)"
  }
 ]
}
{% endschema %}
