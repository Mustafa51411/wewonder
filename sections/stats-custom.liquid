{% comment %}
  Section: DS-01 Animated Stats (mobile-first)
  - 2x2 stat cards with circular progress ring + % number
  - On scroll into viewport: counts up AND ring fills to target percent
  File: sections/ds01-animated-stats.liquid
{% endcomment %}

{%- assign is_arabic = false -%}
{%- if request.locale.iso_code contains 'ar' -%}
  {%- assign is_arabic = true -%}
{%- endif -%}
<section
  id="ds01-stats-{{ section.id }}"
  class="ds01-stats"
  style="
    --ds-bg: {{ section.settings.bg_color }};
    --ds-text: {{ section.settings.text_color }};
    --ds-muted: {{ section.settings.muted_text_color }};
    --ds-card-bg: {{ section.settings.card_bg }};
    --ds-card-border: {{ section.settings.card_border }};
    --ds-ring-track: {{ section.settings.ring_track }};
    --ds-ring-fill: {{ section.settings.ring_fill }};
    --ds-title-size: {{ section.settings.title_size }}px;
    --ds-pad-x: {{ section.settings.mobile_side_padding }}px;
    --ds-gap: {{ section.settings.grid_gap }}px;
    --ds-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="ds01-stats__wrap page-width">

    {% if section.settings.heading != blank %}
  <h2 class="ds01-stats__title">
    {% if is_arabic %}
      أمهات حقيقية، أرقام حقيقية.
    {% else %}
      {{ section.settings.heading }}
    {% endif %}
  </h2>
{% endif %}

    <div class="ds01-stats__grid" role="list">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'stat' %}
            <article
              class="ds01-stats__card"
              role="listitem"
              {{ block.shopify_attributes }}
              data-percent="{{ block.settings.percent | default: 0 }}"
              data-duration="{{ section.settings.anim_duration_ms }}"
            >
              <div class="ds01-stats__ring" aria-hidden="true">
                <!-- SVG ring. Stroke set via CSS vars; fill computed by JS (dashoffset) -->
                <svg class="ds01-stats__svg" viewBox="0 0 120 120" focusable="false">
                  <circle class="ds01-stats__track" cx="60" cy="60" r="44"></circle>
                  <circle class="ds01-stats__progress" cx="60" cy="60" r="44"></circle>
                </svg>

                <div class="ds01-stats__value" aria-label="{{ block.settings.percent }} percent">
                  <span class="ds01-stats__num">0</span><span class="ds01-stats__pct">%</span>
                </div>
              </div>

              {% if block.settings.label != blank %}
  <div class="ds01-stats__label">
    {% if is_arabic %}
      {% case forloop.index %}
        {% when 1 %}
          راحة أكبر طول اليوم
        {% when 2 %}
          تدفّق حليب أسلس
        {% when 3 %}
          ثقة أكتر خلال الشفط
        {% when 4 %}
          فضّلوها على المضخات التقليدية
        {% else %}
          {{ block.settings.label }}
      {% endcase %}
    {% else %}
      {{ block.settings.label }}
    {% endif %}
  </div>
{% endif %}

              {% if block.settings.subtext != blank %}
  <div class="ds01-stats__sub">
    {% if is_arabic %}
      {% case forloop.index %}
        {% when 1 %}
          بناءً على آراء ٤٠٠٠ أم
        {% when 2 %}
          بناءً على آراء ٣٥٠٠ أم
        {% when 3 %}
          بناءً على آراء ٣٢٠٠ أم
        {% when 4 %}
          بناءً على آراء ٢٩٠٠ أم
        {% else %}
          {{ block.settings.subtext }}
      {% endcase %}
    {% else %}
      {{ block.settings.subtext }}
    {% endif %}
  </div>
{% endif %}
            </article>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
<style>
  /* =========================
     DS-01 Animated Stats
     Light Premium Blue Gradient Background
     Forced override
     ========================= */

  #ds01-stats-{{ section.id }}{
    /* FORCE background */
    background: linear-gradient(
      180deg,
      rgba(122, 200, 240, 0.14) 0%,
      rgba(122, 200, 240, 0.08) 40%,
      rgba(122, 200, 240, 0.04) 100%
    ) !important;

    color: var(--ds-text);
    padding: 30px 0 40px;
  }

  /* Remove theme background overrides */
  #ds01-stats-{{ section.id }}::before,
  #ds01-stats-{{ section.id }}::after{
    display: none !important;
    background: none !important;
  }

  #ds01-stats-{{ section.id }} .page-width{
    padding-left: var(--ds-pad-x) !important;
    padding-right: var(--ds-pad-x) !important;
    background: transparent !important;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__wrap{
    max-width: 1200px;
    margin: 0 auto;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__title{
    margin: 0 0 18px 0;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(34px, 7.0vw, var(--ds-title-size));
    color: var(--ds-text);
  }

  /* Grid */
  #ds01-stats-{{ section.id }} .ds01-stats__grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ds-gap);
  }

  #ds01-stats-{{ section.id }} .ds01-stats__card{
    background: #ffffff;
    border: 1px solid var(--ds-card-border);
    border-radius: var(--ds-radius);
    padding: 18px 16px 16px;
    min-width: 0;
  }

  /* Ring sizing */
  #ds01-stats-{{ section.id }} .ds01-stats__ring{
    position: relative;
    width: 120px;
    height: 120px;
    margin: 4px 0 12px;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__svg{
    width: 120px;
    height: 120px;
    display: block;
    transform: rotate(-90deg);
  }

  /* Thinner strokes */
  #ds01-stats-{{ section.id }} .ds01-stats__track{
    fill: none;
    stroke: var(--ds-ring-track);
    stroke-width: 6;
    opacity: 0.85;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__progress{
    fill: none;
    stroke: var(--ds-ring-fill);
    stroke-width: 6;
    stroke-linecap: round;
  }

  /* % value */
  #ds01-stats-{{ section.id }} .ds01-stats__value{
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: -0.02em;
    color: var(--ds-text);
    font-weight: 500;
    font-size: 34px;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__pct{
    font-size: 20px;
    margin-left: 2px;
    opacity: 0.95;
  }

  #ds01-stats-{{ section.id }} .ds01-stats__label{
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 0 0 6px 0;
    color: var(--ds-muted);
  }

  #ds01-stats-{{ section.id }} .ds01-stats__sub{
    font-size: 14px;
    line-height: 1.3;
    color: var(--ds-muted);
    opacity: 0.9;
  }

  /* Small phones */
  @media (max-width: 420px){
    #ds01-stats-{{ section.id }}{
      padding: 28px 0 38px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__card{
      padding: 16px 14px 14px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__ring{
      width: 112px;
      height: 112px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__svg{
      width: 112px;
      height: 112px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__value{
      font-size: 32px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__label{
      font-size: 18px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__sub{
      font-size: 13px;
    }
  }

  /* Desktop refinement */
  @media (min-width: 861px){
    #ds01-stats-{{ section.id }}{
      padding: 54px 0 62px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__grid{
      gap: calc(var(--ds-gap) + 6px);
    }

    #ds01-stats-{{ section.id }} .ds01-stats__card{
      padding: 22px 18px 18px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__ring{
      width: 128px;
      height: 128px;
    }

    #ds01-stats-{{ section.id }} .ds01-stats__svg{
      width: 128px;
      height: 128px;
    }
  }

  @media (prefers-reduced-motion: reduce){
    #ds01-stats-{{ section.id }} .ds01-stats__progress{
      transition: none !important;
    }
  }
  #ds01-stats-{{ section.id }}[dir="rtl"],
html[lang="ar"] #ds01-stats-{{ section.id }},
html[dir="rtl"] #ds01-stats-{{ section.id }} {
  direction: rtl;
}

html[lang="ar"] #ds01-stats-{{ section.id }} .ds01-stats__title,
html[dir="rtl"] #ds01-stats-{{ section.id }} .ds01-stats__title,
html[lang="ar"] #ds01-stats-{{ section.id }} .ds01-stats__label,
html[dir="rtl"] #ds01-stats-{{ section.id }} .ds01-stats__label,
html[lang="ar"] #ds01-stats-{{ section.id }} .ds01-stats__sub,
html[dir="rtl"] #ds01-stats-{{ section.id }} .ds01-stats__sub {
  text-align: right;
}
</style>


  <script>
    (function () {
      var section = document.getElementById('ds01-stats-{{ section.id }}');
      if (!section) return;

      var cards = Array.prototype.slice.call(section.querySelectorAll('.ds01-stats__card'));
      if (!cards.length) return;

      function clamp(n, min, max){ return Math.max(min, Math.min(max, n)); }

      function animateCard(card) {
        if (card.__dsAnimated) return;
        card.__dsAnimated = true;

        var percent = parseInt(card.getAttribute('data-percent') || '0', 10);
        percent = clamp(isNaN(percent) ? 0 : percent, 0, 100);

        var duration = parseInt(card.getAttribute('data-duration') || '900', 10);
        duration = clamp(isNaN(duration) ? 900 : duration, 250, 3000);

        var numEl = card.querySelector('.ds01-stats__num');
        var prog = card.querySelector('.ds01-stats__progress');
        if (!numEl || !prog) return;

        // Compute circumference from r=44 (SVG)
        var r = 44;
        var circumference = 2 * Math.PI * r;

        prog.style.strokeDasharray = String(circumference);
        // start empty
        prog.style.strokeDashoffset = String(circumference);

        // Animate number + ring together
        var start = null;

        // We animate dashoffset by setting it each frame (most robust).
        // If reduced motion, snap instantly.
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) {
          numEl.textContent = String(percent);
          var offsetNow = circumference * (1 - (percent / 100));
          prog.style.strokeDashoffset = String(offsetNow);
          return;
        }

        function step(ts) {
          if (!start) start = ts;
          var t = (ts - start) / duration;
          if (t > 1) t = 1;

          // easeOutCubic
          var eased = 1 - Math.pow(1 - t, 3);

          var current = Math.round(percent * eased);
          numEl.textContent = String(current);

          var offset = circumference * (1 - ((percent * eased) / 100));
          prog.style.strokeDashoffset = String(offset);

          if (t < 1) {
            window.requestAnimationFrame(step);
          } else {
            // ensure exact final
            numEl.textContent = String(percent);
            prog.style.strokeDashoffset = String(circumference * (1 - (percent / 100)));
          }
        }

        window.requestAnimationFrame(step);
      }

      // Observe section entering viewport; animate all cards once.
      var ran = false;
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting && !ran) {
            ran = true;
            cards.forEach(animateCard);
            io.disconnect();
          }
        });
      }, { threshold: 0.35 });

      io.observe(section);
    })();
  </script>
</section>

{% schema %}
{
  "name": "DS-01 Animated Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Customers Reported..."
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "anim_duration_ms",
      "label": "Animation duration (ms)",
      "min": 300,
      "max": 2000,
      "step": 50,
      "default": 900
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#173B2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#F4F3EA"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "rgba(244,243,234,0.78)"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "rgba(255,255,255,0.02)"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "rgba(244,243,234,0.12)"
    },
    {
      "type": "color",
      "id": "ring_track",
      "label": "Ring track color",
      "default": "rgba(244,243,234,0.16)"
    },
    {
      "type": "color",
      "id": "ring_fill",
      "label": "Ring fill color",
      "default": "rgba(244,243,234,0.95)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Mobile side padding",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Max title size (px)",
      "min": 44,
      "max": 88,
      "step": 1,
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "range",
          "id": "percent",
          "label": "Percent",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 89
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Better Gut Health"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Based on 4500 Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS-01 Animated Stats",
      "blocks": [
        { "type": "stat", "settings": { "percent": 89, "label": "Better Gut Health", "subtext": "Based on 4500 Customers" } },
        { "type": "stat", "settings": { "percent": 97, "label": "Better Skin Health", "subtext": "Based on 8500 Customers" } },
        { "type": "stat", "settings": { "percent": 87, "label": "Weight loss", "subtext": "Based on 3500 Customers" } },
        { "type": "stat", "settings": { "percent": 94, "label": "Higher Productivity", "subtext": "Based on 2500 Customers" } }
      ]
    }
  ]
}
{% endschema %}
