<link rel="stylesheet" href="{{ 'ww-pdp.css' | asset_url }}">
<style>@font-face{font-family:Gordita;src:url({{ 'Gordita-Regular.woff2' | asset_url }}) format("woff2");font-weight:400;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Medium.woff2' | asset_url }}) format("woff2");font-weight:500;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Bold.woff2' | asset_url }}) format("woff2");font-weight:700;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Black.woff2' | asset_url }}) format("woff2");font-weight:800 900;font-display:swap}</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<div class="ww-pdp">
<section class="section" style="background:var(--sky-soft)" id="faq"><div class="wrap">
<div class="center"><h2><span class="hl">{{ section.settings.h_a }}</span> {{ section.settings.h_b }}</h2></div>
<div class="faq">
{%- for b in section.blocks -%}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}<span class="pm">+</span></summary>{{ b.settings.a }}</details>{%- endfor -%}
</div></div></section>
</div>
{% schema %}
{
 "name": "WW FAQ",
 "settings": [
  {
   "type": "text",
   "id": "h_a",
   "label": "Heading (marker)",
   "default": "Questions"
  },
  {
   "type": "text",
   "id": "h_b",
   "label": "Heading (rest)",
   "default": "mothers ask"
  }
 ],
 "blocks": [
  {
   "type": "faq",
   "name": "Question",
   "settings": [
    {
     "type": "text",
     "id": "q",
     "label": "Question",
     "default": "Question?"
    },
    {
     "type": "richtext",
     "id": "a",
     "label": "Answer",
     "default": "<p>Answer</p>"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "WW FAQ"
  }
 ]
}
{% endschema %}
