<link rel="stylesheet" href="{{ 'ww-pdp.css' | asset_url }}">
<style>@font-face{font-family:Gordita;src:url({{ 'Gordita-Regular.woff2' | asset_url }}) format("woff2");font-weight:400;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Medium.woff2' | asset_url }}) format("woff2");font-weight:500;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Bold.woff2' | asset_url }}) format("woff2");font-weight:700;font-display:swap}@font-face{font-family:Gordita;src:url({{ 'Gordita-Black.woff2' | asset_url }}) format("woff2");font-weight:800 900;font-display:swap}</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<div class="ww-pdp">
<section class="section"><div class="wrap">
<div class="center"><h2>{{ section.settings.h_a }} <span class="hl-solid dfx">{{ section.settings.h_b }}</span></h2></div>
<div class="steps">
{%- for b in section.blocks -%}<div class="step" {{ b.shopify_attributes }}><div class="ph sq"><img src="{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 600 }}{%- else -%}{{ 'ww-step-' | append: forloop.index | append: '.jpg' | asset_url }}{%- endif -%}" alt="{{ b.settings.title | escape }}" loading="lazy"></div><div class="num">{{ forloop.index }}</div><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>{%- endfor -%}
</div></div></section>
</div>
{% schema %}
{
 "name": "WW How it works (steps)",
 "settings": [
  {
   "type": "text",
   "id": "h_a",
   "label": "Heading (plain part)",
   "default": "Five steps, then"
  },
  {
   "type": "text",
   "id": "h_b",
   "label": "Heading (marker)",
   "default": "hands-free"
  }
 ],
 "blocks": [
  {
   "type": "step",
   "name": "Step",
   "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "Step photo"
    },
    {
     "type": "text",
     "id": "title",
     "label": "Title",
     "default": "Step"
    },
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "Short description"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "WW How it works (steps)"
  }
 ]
}
{% endschema %}
