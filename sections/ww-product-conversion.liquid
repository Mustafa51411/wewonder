{% assign notes = section.blocks | where: 'type', 'note' %}
{% assign faq_items = section.blocks | where: 'type', 'faq' %}
{% assign source_collection = section.settings.collection %}
<section class="ww-conversion" id="ww-conversion-{{ section.id }}">
  <style>
    #ww-conversion-{{ section.id }}{--ww-navy:{{ section.settings.navy }};--ww-blue:{{ section.settings.accent }};--ww-pale:{{ section.settings.surface }};font-family:var(--font-body-family,inherit);color:#1f3040}#ww-conversion-{{ section.id }} *{box-sizing:border-box}#ww-conversion-{{ section.id }} .wwc-wrap{width:min(1120px,calc(100% - 40px));margin:auto}#ww-conversion-{{ section.id }} .wwc-offer,#ww-conversion-{{ section.id }} .wwc-recs{padding:clamp(54px,8vw,96px) 0;text-align:center;background:#fff}#ww-conversion-{{ section.id }} h2{margin:0;color:var(--ww-navy);font-family:var(--font-heading-family,inherit);font-size:clamp(28px,3.5vw,43px);line-height:1.1;letter-spacing:-.035em}#ww-conversion-{{ section.id }} .wwc-copy{max-width:600px;margin:10px auto 22px;color:#647783;line-height:1.55}#ww-conversion-{{ section.id }} .wwc-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:650px;margin:0 auto 18px}#ww-conversion-{{ section.id }} .wwc-option{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:10px;align-items:center;padding:11px;border:1px solid #dbe8ee;border-radius:14px;background:var(--ww-pale);color:inherit;text-align:left;text-decoration:none}#ww-conversion-{{ section.id }} .wwc-option img{width:48px;height:48px;border-radius:9px;object-fit:contain;background:#fff}#ww-conversion-{{ section.id }} .wwc-option strong{color:var(--ww-navy);font-size:14px}#ww-conversion-{{ section.id }} .wwc-option span{color:var(--ww-blue);font-weight:850;white-space:nowrap}#ww-conversion-{{ section.id }} .wwc-button{display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:13px 28px;border-radius:12px;background:var(--ww-navy);color:#fff;font-weight:850;text-decoration:none}#ww-conversion-{{ section.id }} .wwc-notes{display:flex;justify-content:center;flex-wrap:wrap;gap:14px;margin-top:15px;color:#647783;font-size:12px}#ww-conversion-{{ section.id }} .wwc-notes span:before{margin-right:5px;color:#2c9d67;content:'✓'}#ww-conversion-{{ section.id }} .wwc-faq{padding:clamp(54px,8vw,96px) 0;background:var(--ww-pale);text-align:center}#ww-conversion-{{ section.id }} .wwc-faq-inner{max-width:850px;margin:auto}#ww-conversion-{{ section.id }} .wwc-faq h2{margin-bottom:26px}#ww-conversion-{{ section.id }} details{border-bottom:1px solid #dbe8ee;text-align:left}#ww-conversion-{{ section.id }} summary{display:flex;justify-content:space-between;gap:20px;padding:18px 0;color:var(--ww-navy);cursor:pointer;font-weight:800;list-style:none}#ww-conversion-{{ section.id }} summary::-webkit-details-marker{display:none}#ww-conversion-{{ section.id }} summary:after{color:var(--ww-blue);content:'+';font-size:22px;line-height:.8}#ww-conversion-{{ section.id }} details[open] summary:after{content:'−'}#ww-conversion-{{ section.id }} .wwc-answer{padding:0 0 18px;color:#647783;line-height:1.65}#ww-conversion-{{ section.id }} .wwc-recs h2{margin-bottom:28px}#ww-conversion-{{ section.id }} .wwc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;text-align:left}#ww-conversion-{{ section.id }} .wwc-product{color:inherit;text-decoration:none}#ww-conversion-{{ section.id }} .wwc-media{overflow:hidden;aspect-ratio:1;border:1px solid #dbe8ee;border-radius:16px;background:var(--ww-pale)}#ww-conversion-{{ section.id }} .wwc-media img{width:100%;height:100%;object-fit:contain}#ww-conversion-{{ section.id }} h3{margin:12px 0 4px;color:var(--ww-navy);font-size:15px}#ww-conversion-{{ section.id }} .wwc-price{color:#647783;font-size:14px;font-weight:700}@media(max-width:700px){#ww-conversion-{{ section.id }} .wwc-wrap{width:min(100% - 28px,1120px)}#ww-conversion-{{ section.id }} .wwc-options,#ww-conversion-{{ section.id }} .wwc-grid{grid-template-columns:1fr 1fr}}
  </style>
  <div class="wwc-offer"><div class="wwc-wrap"><h2>{{ section.settings.offer_heading }}</h2>{% if section.settings.offer_text != blank %}<p class="wwc-copy">{{ section.settings.offer_text }}</p>{% endif %}<div class="wwc-options">{% for variant in product.variants limit: 2 %}{% assign image = variant.featured_image | default: product.featured_image %}<a class="wwc-option" href="#ww-product-{{ section.id }}">{% if image != blank %}{{ image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120' }}{% endif %}<strong>{{ variant.title }}</strong><span>{{ variant.price | money }}</span></a>{% endfor %}</div><a class="wwc-button" href="#ww-product-{{ section.id }}">{{ section.settings.button_label }}</a>{% if notes.size > 0 %}<div class="wwc-notes">{% for block in notes %}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{% endfor %}</div>{% endif %}</div></div>
  {% if faq_items.size > 0 %}<div class="wwc-faq"><div class="wwc-wrap wwc-faq-inner"><h2>{{ section.settings.faq_heading }}</h2>{% for block in faq_items %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="wwc-answer">{{ block.settings.answer }}</div></details>{% endfor %}</div></div>{% endif %}
  {% if source_collection != blank and source_collection.products_count > 0 %}<div class="wwc-recs"><div class="wwc-wrap"><h2>{{ section.settings.recommendations_heading }}</h2><div class="wwc-grid">{% for item in source_collection.products limit: section.settings.limit %}{% unless item.id == product.id %}<a class="wwc-product" href="{{ item.url }}"><div class="wwc-media">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 400, 600' }}{% endif %}</div><h3>{{ item.title }}</h3><span class="wwc-price">{{ item.price | money }}</span></a>{% endunless %}{% endfor %}</div></div></div>{% endif %}
</section>
{% schema %}
{"name":"Offer, FAQ and related","settings":[{"type":"text","id":"offer_heading","label":"Offer heading","default":"Choose your option"},{"type":"textarea","id":"offer_text","label":"Offer introduction","default":"Prices and options are pulled from this product in Shopify."},{"type":"text","id":"button_label","label":"Button label","default":"Choose options"},{"type":"text","id":"faq_heading","label":"FAQ heading","default":"Questions customers ask"},{"type":"collection","id":"collection","label":"You may also like collection"},{"type":"text","id":"recommendations_heading","label":"Recommendations heading","default":"You may also like"},{"type":"range","id":"limit","label":"Maximum recommendations","min":2,"max":8,"step":1,"default":4},{"type":"color","id":"navy","label":"Dark color","default":"#1a2b3c"},{"type":"color","id":"accent","label":"Accent color","default":"#7ac8f0"},{"type":"color","id":"surface","label":"Soft background","default":"#eff9fd"}],"blocks":[{"type":"note","name":"Service note","limit":4,"settings":[{"type":"text","id":"text","label":"Text","default":"Add a real service promise"}]},{"type":"faq","name":"FAQ","limit":8,"settings":[{"type":"text","id":"question","label":"Question","default":"Add a customer question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add the answer in the Theme Editor.</p>"}]}],"presets":[{"name":"Offer, FAQ and related","blocks":[{"type":"note"},{"type":"note"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}
{% endschema %}
